#!/bin/sh
# DHCP values stay only in this ephemeral guest; no addresses are logged.
case "$1" in
    bound|renew)
        ip addr flush dev "$interface"
        ip addr add "$ip/${mask:-24}" dev "$interface"
        ip link set "$interface" up
        for gateway in $router; do ip route replace default via "$gateway"; break; done
        : > /etc/resolv.conf
        for server in $dns; do echo "nameserver $server" >> /etc/resolv.conf; done
        ;;
esac
