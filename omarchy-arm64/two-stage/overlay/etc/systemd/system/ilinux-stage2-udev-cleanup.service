# Two-stage boot, stage one (VM job 049): clear stage one's udev database during the soft-reboot into
# stage two, after udevd has stopped, as initrd-udevadm-cleanup-db.service does before an initrd's
# switch-root. systemd carries device units across the soft-reboot; without this, the controller's
# device stays "plugged" with the SYSTEMD_WANTS it had in stage one, and since the Omarchy root's udev
# rule names the same ilinux-usb-gadget@<udc>.service, systemd sees nothing new and never starts it
# (VM job 049: stage two came up without its link). With the database empty, stage two's udev
# coldplug finds every device anew, as at a fresh boot, and the gadget starts.
[Unit]
Description=Two-stage boot: clear stage one's udev database before the soft-reboot
DefaultDependencies=no
Conflicts=systemd-udevd.service systemd-udevd-control.socket systemd-udevd-kernel.socket systemd-udev-trigger.service systemd-udev-settle.service
After=systemd-udevd.service systemd-udevd-control.socket systemd-udevd-kernel.socket systemd-udev-trigger.service systemd-udev-settle.service
Before=systemd-soft-reboot.service

[Service]
Type=oneshot
ExecStart=-/usr/bin/udevadm info --cleanup-db

[Install]
WantedBy=soft-reboot.target
