# Two-stage boot, stage one (VM job 049): the SSH host key of this boot. The image holds no private key,
# so stage one makes its own at every boot, before sshd starts on the USB byte pipe (the drop-in
# ilinux-sshd-tty@.service.d/10-ilinux-hostkey.conf orders it), as the Omarchy root does (job 045,
# LINK=1). The fingerprint goes to the journal (tagged ilinux-ssh-hostkey), which interface 0 carries to
# the M1, and to the panel, so the key ssh records on first use (build/control/known_hosts-stage1) can be
# checked against it.
[Unit]
Description=SSH host key for this boot (two-stage boot, stage one)

[Service]
Type=oneshot
RemainAfterExit=yes
SyslogIdentifier=ilinux-ssh-hostkey
ExecStart=/bin/sh -c 'test -s /etc/ssh/ssh_host_ed25519_key || /usr/bin/ssh-keygen -q -t ed25519 -N "" -C ilinux-m5-stage1 -f /etc/ssh/ssh_host_ed25519_key; /usr/bin/ssh-keygen -l -f /etc/ssh/ssh_host_ed25519_key.pub'

[Install]
WantedBy=multi-user.target
