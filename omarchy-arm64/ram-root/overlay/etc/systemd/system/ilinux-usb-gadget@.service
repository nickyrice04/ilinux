# One per device-mode USB controller (UDC), started by 90-ilinux-usb.rules when it appears:
# the gadget (CDC-ACM journal port + CDC-ECM network, see usb-gadget.sh), then the journal on
# its serial port as the main process. Binding is not exercised in the VM (no UDC there); on
# the M5 it needs the Type-C PHY in device mode.
[Unit]
Description=USB control channel on %i: journal serial port and network (RAM root)
Wants=sys-kernel-config.mount
After=sys-kernel-config.mount systemd-journald.service

[Service]
Type=simple
ExecStartPre=/usr/local/lib/ilinux/usb-gadget.sh start %i
ExecStart=/usr/local/lib/ilinux/usb-gadget.sh log %i
# journalctl blocks SIGTERM while it follows, and a write to a port no host reads blocks it,
# so SIGTERM would only end it at the stop timeout. Nothing in the stream needs a clean exit.
KillSignal=SIGKILL
# After the log process has ended: removing the ACM function waits for its port to close.
ExecStopPost=-/usr/local/lib/ilinux/usb-gadget.sh stop %i
