#!/bin/bash
# ilinux-host-bridge: apply Mac host state inside this VM.
# Reads key=value lines from the virtio-serial port org.ilinux.host (written by
# tools/bin/ilinux-host-agent on the host).  Every value is whitelisted:
#   capacity= status= ac=   -> kernel test_power battery (UPower, Omarchy bar)
#   time=<epoch.ms>         -> step the clock when it is > 2 s off (the guest
#                              counter stands still while the Mac sleeps)
#   tz=<Area/City>          -> follow the Mac's time zone
set -u
PORT=/dev/virtio-ports/org.ilinux.host
P=/sys/module/test_power/parameters
modprobe test_power || { echo "test_power module missing (CONFIG_TEST_POWER)" >&2; exit 1; }
echo off  > "$P/usb_online"
echo true > "$P/battery_present"
echo LION > "$P/battery_technology"
echo good > "$P/battery_health"

step_clock() {  # host epoch seconds (with fraction)
  local off
  off=$(awk -v h="$1" -v g="$(date +%s.%N)" 'BEGIN { d = h - g; printf "%.0f", d < 0 ? -d : d }')
  if (( off > 2 )); then
    date -s "@$1" > /dev/null &&
      echo "clock stepped ${off}s to host time" &&
      systemctl --no-block try-restart systemd-timesyncd.service
  fi
}

set_tz() {
  [[ $(readlink /etc/localtime) == */zoneinfo/$1 ]] && return
  timedatectl set-timezone "$1" && echo "time zone set to $1"
}

exec 3<"$PORT"
while read -r line <&3; do
  for kv in $line; do
    k=${kv%%=*}; v=${kv#*=}
    case $k in
      capacity) [[ $v =~ ^[0-9]{1,3}$ ]] && (( v <= 100 )) && echo "$v" > "$P/battery_capacity" ;;
      status) case $v in charging|discharging|not-charging|full) echo "$v" > "$P/battery_status" ;; esac ;;
      ac) case $v in on|off) echo "$v" > "$P/ac_online" ;; esac ;;
      time) [[ $v =~ ^[0-9]{9,11}(\.[0-9]{1,6})?$ ]] && step_clock "$v" ;;
      tz) [[ $v =~ ^[A-Za-z0-9_+/-]+$ && $v != *..* && -f /usr/share/zoneinfo/$v ]] && set_tz "$v" ;;
    esac
  done
done
