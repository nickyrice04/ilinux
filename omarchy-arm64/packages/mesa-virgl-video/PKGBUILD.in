# Isolated VA-API driver for the iLinux VM. Does not replace system Mesa/GL.
pkgname=mesa-virgl-video-ilinux
pkgver=26.2.4
pkgrel=1
pkgdesc='iLinux virgl VA-API: lossless 4:2:0 downloads and optional NV12 decode'
arch=('aarch64')
url='https://mesa3d.org/'
license=('MIT')
depends=('libva' 'libdrm' 'expat' 'zlib' 'zstd' 'libelf' 'libglvnd' 'libx11' 'libxcb' 'libxext' 'libxfixes' 'libxrandr' 'libxshmfence' 'libunwind' 'lm_sensors' 'libdisplay-info')
makedepends=('meson' 'ninja' 'python-mako' 'python-yaml' 'python-ply' 'python-packaging' 'bison' 'flex' 'xorgproto' 'wayland-protocols' 'spirv-tools')
source=("https://archive.mesa3d.org/mesa-$pkgver.tar.xz"
        '0001-virgl-nv12-decode-option.patch'
        '0002-va-lossless-420-download.patch'
        'ilinux-video')
# Local patch checksums are generated by prepare-package.py, never skipped.
sha256sums=('bce5f7fbebb934373b86c999a064d52fb5065878dc57f287f95346648ec832e9'
            '@NV12_SHA256@' '@DOWNLOAD_SHA256@' '@WRAPPER_SHA256@')

prepare() {
  cd "mesa-$pkgver"
  patch -p1 < ../0001-virgl-nv12-decode-option.patch
  patch -p1 < ../0002-va-lossless-420-download.patch
}

build() {
  meson setup build "mesa-$pkgver" --prefix=/usr --buildtype=release \
    -Dgallium-drivers=virgl -Dvulkan-drivers= -Dgallium-va=enabled \
    -Dglx=disabled -Degl=disabled -Dopengl=false -Dgbm=disabled \
    -Dllvm=disabled -Dplatforms= -Dvideo-codecs=h264dec
  ninja -C build -j8 src/gallium/targets/va/libgallium_drv_video.so
}

package() {
  install -Dm755 build/src/gallium/targets/va/libgallium_drv_video.so \
    "$pkgdir/usr/lib/ilinux-va/virtio_gpu_drv_video.so"
  install -Dm755 ilinux-video "$pkgdir/usr/bin/ilinux-video"
  install -Dm644 "mesa-$pkgver/docs/license.rst" \
    "$pkgdir/usr/share/licenses/$pkgname/license.rst"
}
