#!/bin/sh
# ssh-browser URL (job 045 LINK=1, attempt 26): $BROWSER in SSH login shells (/etc/profile.d/ilinux-ssh-browser.sh).
# Attempt 25: Claude Code, started over SSH, opened its sign-in page through Omarchy's browser launcher in
# Chromium on the M5's own screen, where nobody could use it. From an SSH session a page is opened on the
