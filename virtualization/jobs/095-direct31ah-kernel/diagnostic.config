# Original iLinux RAM diagnostic profile over pinned defconfig + asahi.config.
# This reconstructs a conservative profile; the reporter's .config is unknown.
CONFIG_LOCALVERSION="-ilinux31ah-offline"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_ARCH_APPLE=y
# CONFIG_ARM64_4K_PAGES is not set
CONFIG_ARM64_16K_PAGES=y
# CONFIG_ARM64_64K_PAGES is not set
CONFIG_ARM64_CTXR_EXECMEM=y
CONFIG_ARM64_ACTLR_STATE=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_MODULES=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_PRINTK_TIME=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_PCI=y
CONFIG_PCIE_APPLE=y
CONFIG_APPLE_DART=y
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_RTKIT_HELPER=y
CONFIG_APPLE_DOCKCHANNEL=y
CONFIG_APPLE_PMGR_PWRSTATE=y
CONFIG_APPLE_PMGR_MISC=y
CONFIG_APPLE_WATCHDOG=y
CONFIG_APPLE_AIC=y
CONFIG_PINCTRL_APPLE_GPIO=y
CONFIG_MFD_MACSMC=y
CONFIG_GPIO_MACSMC=y
CONFIG_POWER_RESET_MACSMC=y
CONFIG_SERIAL_APPLE_DOCKCHANNEL=y
CONFIG_SERIAL_APPLE_DOCKCHANNEL_EARLYCON=y
CONFIG_CPU_FREQ=y
CONFIG_ARM_APPLE_SOC_CPUFREQ=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_APPLE_CPUIDLE=y
CONFIG_PM=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_HID=y
CONFIG_HIDRAW=y
CONFIG_HID_APPLE=y
CONFIG_HID_DOCKCHANNEL=y
CONFIG_HID_MAGICMOUSE=y
# CONFIG_HID_APPLE_MTP_HAPTIC is not set
CONFIG_INPUT_EVDEV=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_APPLE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
# CONFIG_USB_CONFIGFS_MASS_STORAGE is not set
# Public source has no T6050 gadget PHY path; keep host PHY outside this RAM root.
CONFIG_PHY_APPLE_T6040_USB2=m
CONFIG_CFG80211=y
CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_APPLE=y
CONFIG_APPLE_CENTAURI_T6050=y
CONFIG_APPLE_CENTAURI_T6050_WIFI=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# Storage is compiled for later review, never put in this diagnostic initramfs.
CONFIG_NVME_APPLE=m
CONFIG_APPLE_SART=m
CONFIG_BLK_DEV_NVME=m
# Disable devices outside the initial CPU/control scope, especially SEP writes.
# CONFIG_RUST is not set
# CONFIG_APPLE_SEP is not set
# CONFIG_APPLE_SEP_KUNIT_TEST is not set
# CONFIG_DRM_ASAHI is not set
# CONFIG_DRM_APPLE is not set
# CONFIG_DRM_ACCEL_ANE is not set
# CONFIG_APPLE_AOP is not set
# CONFIG_APPLE_PMP is not set
# CONFIG_APPLE_DBGVIEW is not set
# CONFIG_APPLE_REGVIEW is not set
# CONFIG_MTD is not set
# CONFIG_SND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_BT is not set
# CONFIG_USB4 is not set
# CONFIG_KVM is not set
# CONFIG_HIBERNATION is not set
# CONFIG_APFS_FS is not set
# CONFIG_HFS_FS is not set
# CONFIG_HFSPLUS_FS is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
