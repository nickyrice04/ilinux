+/* IOSurface presenter: everything below runs on the QEMU thread with the
+ * BQL held, in gl_view_ctx (where the blit shader state was created). */
+static void cocoa_present_free_ring(void)
+{
+    for (int i = 0; i < COCOA_PRESENT_SURFACES; i++) {
+        if (cocoa_present_ring[i].fbo) {
+            glDeleteFramebuffers(1, &cocoa_present_ring[i].fbo);
+        }
+        if (cocoa_present_ring[i].tex) {
+            glDeleteTextures(1, &cocoa_present_ring[i].tex);
+        }
+        if (cocoa_present_ring[i].surf) {
+            CFRelease(cocoa_present_ring[i].surf);
+        }
+        cocoa_present_ring[i].surf = NULL;
+        cocoa_present_ring[i].tex = 0;
+        cocoa_present_ring[i].fbo = 0;
+        qatomic_set(&cocoa_present_ring[i].pending, 0);
+    }
+    qatomic_set(&cocoa_present_current, -1);
+    cocoa_present_w = cocoa_present_h = 0;
+}
+
+static bool cocoa_present_alloc_ring(int w, int h)
+{
+    bool ok = true;
+
+    cocoa_present_free_ring();
+    qatomic_inc(&cocoa_present_gen);
+    @autoreleasepool {
+        NSDictionary *props = @{
+            (id)kIOSurfaceWidth: @(w),
+            (id)kIOSurfaceHeight: @(h),
+            (id)kIOSurfaceBytesPerElement: @4,
+            (id)kIOSurfacePixelFormat: @((uint32_t)'BGRA'),
+        };
+        for (int i = 0; i < COCOA_PRESENT_SURFACES && ok; i++) {
+            cocoa_present_ring[i].surf = IOSurfaceCreate((CFDictionaryRef)props);
+            if (!cocoa_present_ring[i].surf) {
+                ok = false;
+                break;
+            }
+            glGenTextures(1, &cocoa_present_ring[i].tex);
+            glBindTexture(GL_TEXTURE_RECTANGLE, cocoa_present_ring[i].tex);
+            /* Apple's GL binds IOSurfaces as rectangle textures only */
+            ok = CGLTexImageIOSurface2D(CGLGetCurrentContext(), GL_TEXTURE_RECTANGLE,
+                                        GL_RGBA8, w, h, GL_BGRA,
+                                        GL_UNSIGNED_INT_8_8_8_8_REV,
+                                        cocoa_present_ring[i].surf, 0) == kCGLNoError;
+            glGenFramebuffers(1, &cocoa_present_ring[i].fbo);
+            glBindFramebuffer(GL_FRAMEBUFFER, cocoa_present_ring[i].fbo);
+            glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                                   GL_TEXTURE_RECTANGLE, cocoa_present_ring[i].tex, 0);
+            ok = ok && glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+        }
+    }
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glBindTexture(GL_TEXTURE_RECTANGLE, 0);
+    if (!ok) {
+        cocoa_present_free_ring();
+        return false;
+    }
+    cocoa_present_w = w;
+    cocoa_present_h = h;
+    return true;
+}
+
+/* COCOA_GL_PRESENT_DUMP=<file.ppm>: write the 600th presented frame,
+ * quarter size, to check orientation and content against the guest. */
+static void cocoa_present_dump(IOSurfaceRef s, int w, int h)
+{
+    static int left = -1;
+    const char *path = getenv("COCOA_GL_PRESENT_DUMP");
+
+    if (left < 0) {
+        left = path ? 600 : 0;
+    }
+    if (left == 0 || --left > 0) {
+        return;
+    }
+    glFinish();
+    FILE *f = fopen(path, "wb");
+    if (!f || IOSurfaceLock(s, kIOSurfaceLockReadOnly, NULL) != kIOReturnSuccess) {
+        if (f) {
+            fclose(f);
+        }
+        return;
+    }
+    const uint8_t *base = IOSurfaceGetBaseAddress(s);
+    const size_t stride = IOSurfaceGetBytesPerRow(s);
+    fprintf(f, "P6\n%d %d\n255\n", w / 4, h / 4);
+    for (int y = 0; y < h / 4; y++) {
+        for (int x = 0; x < w / 4; x++) {
+            const uint8_t *p = base + (size_t)(y * 4) * stride + (size_t)(x * 4) * 4;
+            const uint8_t rgb[3] = { p[2], p[1], p[0] };
+            fwrite(rgb, 1, 3, f);
+        }
+    }
+    IOSurfaceUnlock(s, kIOSurfaceLockReadOnly, NULL);
+    fclose(f);
+}
+
+/*
+ * Copy the current guest frame into a free IOSurface and hand it to the
+ * layer.  Returns false when the frame has to wait: window hidden, no free
+ * surface, or (for a present straight from a guest flush) less than a
+ * display refresh since the last one; the refresh tick then catches up.
+ */
+static bool cocoa_present_frame(bool from_flush)
+{
+    const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    GLuint tex = 0;
+    int w = 0, h = 0, slot = -1;
+    bool flip;
+
+    if (!qatomic_read(&cocoa_window_visible)) {
+        return false;
+    }
+    if (from_flush && now - cocoa_present_last_ns < cocoa_present_period_ns * 3 / 4) {
+        return false;
+    }
+
+    CGLContextObj prev = CGLGetCurrentContext();
+    CGLSetCurrentContext((CGLContextObj)gl_view_ctx);
+    if (gl_scanout_borrow) {
+        DisplayGLTexture t = gl_scanout_borrow(gl_scanout_id);
+        tex = t.id;
+        w = t.width;
+        h = t.height;
+        /* Core Animation shows an IOSurface's first row at the top: the
+         * opposite of the layer path's GL drawable, hence the inversion */
+        flip = !t.y_0_top;
+    } else {
+        tex = surface ? surface->texture : 0;
+        w = surface ? surface_width(surface) : 0;
+        h = surface ? surface_height(surface) : 0;
+        flip = true;
+    }
+    if (!tex || w <= 0 || h <= 0 ||
+        ((w != cocoa_present_w || h != cocoa_present_h) && !cocoa_present_alloc_ring(w, h))) {
+        CGLSetCurrentContext(prev);
+        gl_dirty = false;
+        return true;
+    }
+
+    const int cur = qatomic_read(&cocoa_present_current);
+    for (int k = 0; k < COCOA_PRESENT_SURFACES; k++) {
+        int i = (cocoa_present_next + k) % COCOA_PRESENT_SURFACES;
+        if (i != cur && !qatomic_read(&cocoa_present_ring[i].pending) &&
+            !IOSurfaceIsInUse(cocoa_present_ring[i].surf)) {
+            slot = i;
+            break;
+        }
+    }
+    if (slot < 0) {
+        CGLSetCurrentContext(prev);
+        return false;
+    }
+
+    glBindFramebuffer(GL_FRAMEBUFFER, cocoa_present_ring[slot].fbo);
+    glViewport(0, 0, w, h);
+    glBindTexture(GL_TEXTURE_2D, tex);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    qemu_gl_run_texture_blit(dgc.gls, flip);
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    cocoa_present_dump(cocoa_present_ring[slot].surf, w, h);
+    if (cocoa_gl_check_on()) {
+        IOSurfaceRef cs = cocoa_present_ring[slot].surf;
+        glFinish();
+        if (IOSurfaceLock(cs, kIOSurfaceLockReadOnly, NULL) == kIOReturnSuccess) {
+            const uint8_t *base = IOSurfaceGetBaseAddress(cs);
+            const size_t stride = IOSurfaceGetBytesPerRow(cs);
+            cocoa_gl_check_frame(w, h, ^uint32_t(int x, int y) {
+                const uint8_t *p = base + (size_t)y * stride + (size_t)x * 4;
+                return (uint32_t)p[2] | (uint32_t)p[1] << 8 | (uint32_t)p[0] << 16;
+            }, "iosurface");
+            IOSurfaceUnlock(cs, kIOSurfaceLockReadOnly, NULL);
+        }
+    }
+    glFlush();
+    CGLSetCurrentContext(prev);
+
+    IOSurfaceRef s = cocoa_present_ring[slot].surf;
+    const unsigned gen = qatomic_read(&cocoa_present_gen);
+    CFRetain(s);
+    qatomic_set(&cocoa_present_ring[slot].pending, 1);
+    cocoa_present_next = (slot + 1) % COCOA_PRESENT_SURFACES;
+    cocoa_present_last_ns = now;
+    gl_dirty = false;
     cocoa_gl_lat_draw();
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        [[cocoaView layer] setContents:(id)s];
+        [CATransaction commit];
+        if (qatomic_read(&cocoa_present_gen) == gen) {
+            qatomic_set(&cocoa_present_current, slot);
+            qatomic_set(&cocoa_present_ring[slot].pending, 0);
+        }
+        CFRelease(s);
+    });
+    return true;
 }
 
