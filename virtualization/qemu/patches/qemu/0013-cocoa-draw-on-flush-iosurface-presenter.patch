+/*
+ * COCOA_GL_PRESENT_CHECK=1 (measurement aid for the IOSurface presenter, with
+ * a fullscreen client that fills each frame with one colour, e.g. vfill -a):
+ * after each present, wait for the GPU and sample a 5x5 grid in the lower-left
+ * 60% of the surface (clear of the notification area); count frames that are
+ * not one colour, i.e. torn.
+ */
+static int cocoa_gl_check_enabled = -1;
+static unsigned cocoa_gl_check_frames, cocoa_gl_check_torn;
+
+static bool cocoa_gl_check_on(void)
+{
+    if (cocoa_gl_check_enabled < 0) {
+        cocoa_gl_check_enabled = getenv("COCOA_GL_PRESENT_CHECK") != NULL;
+    }
+    return cocoa_gl_check_enabled;
 }
 
+/* px(x, y) returns a BGRA or RGBA pixel as 0xAABBGGRR-ish; only equality matters */
+static void cocoa_gl_check_frame(int w, int h, uint32_t (^px)(int x, int y), const char *path)
+{
+    uint32_t first = 0;
+    bool torn = false;
+
+    for (int j = 0; j < 5; j++) {
+        for (int i = 0; i < 5; i++) {
+            const int x = w / 10 + i * (w / 2) / 4;
+            const int y = h * 4 / 10 + j * (h / 2) / 4;
+            const uint32_t v = px(x, y) & 0x00f0f0f0;  /* ignore dither noise */
+            if (i == 0 && j == 0) {
+                first = v;
+            } else if (v != first) {
+                torn = true;
+            }
+        }
+    }
+    cocoa_gl_check_frames++;
+    cocoa_gl_check_torn += torn;
+    if (cocoa_gl_check_frames == 240) {
+        fprintf(stderr, "cocoa-gl present check (%s): %u of 240 frames not uniform\n",
+                path, cocoa_gl_check_torn);
+        cocoa_gl_check_frames = cocoa_gl_check_torn = 0;
+    }
+}
