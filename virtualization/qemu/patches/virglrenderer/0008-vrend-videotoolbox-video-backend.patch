+/* ------------------------------------------------------------------ */
+/* VideoToolbox session                                                 */
+
+static void vt_output(void *refcon, void *frame_refcon, OSStatus status,
+                      VTDecodeInfoFlags flags, CVImageBufferRef image,
+                      CMTime pts, CMTime duration)
+{
+   struct virgl_video_codec *c = refcon;
+   (void)frame_refcon;
+   (void)flags;
+   (void)pts;
+   (void)duration;
+   c->out_status = status;
+   if (status == noErr && image) {
+      if (c->out)
+         CVBufferRelease(c->out);
+      c->out = CVBufferRetain(image);
+   }
+}
+
+static void destroy_transfer(struct virgl_video_codec *c)
+{
+   if (c->transfer) {
+      VTPixelTransferSessionInvalidate(c->transfer);
+      CFRelease(c->transfer);
+      c->transfer = NULL;
+   }
+   if (c->planar_pool) {
+      CVPixelBufferPoolRelease(c->planar_pool);
+      c->planar_pool = NULL;
+   }
+}
+
+/* Guest buffers arrive as NV12 (2 planes) or as 3-plane IYUV/YV12 (what
+ * Mesa 26 guests allocate as decode targets).  VideoToolbox decodes to NV12;
+ * planar targets go through a VTPixelTransferSession. */
+static CVPixelBufferRef to_planar(struct virgl_video_codec *c, CVPixelBufferRef src)
+{
+   const uint32_t w = (uint32_t)CVPixelBufferGetWidth(src);
+   const uint32_t h = (uint32_t)CVPixelBufferGetHeight(src);
+   if (!c->transfer && VTPixelTransferSessionCreate(kCFAllocatorDefault, &c->transfer) != noErr)
+      return NULL;
+   if (!c->planar_pool || c->planar_w != w || c->planar_h != h) {
+      if (c->planar_pool)
+         CVPixelBufferPoolRelease(c->planar_pool);
+      c->planar_pool = NULL;
+      NSDictionary *attrs = @{
+         (id)kCVPixelBufferPixelFormatTypeKey: @(kCVPixelFormatType_420YpCbCr8Planar),
+         (id)kCVPixelBufferWidthKey: @(w),
+         (id)kCVPixelBufferHeightKey: @(h),
+         (id)kCVPixelBufferIOSurfacePropertiesKey: @{},
+      };
+      if (CVPixelBufferPoolCreate(kCFAllocatorDefault, NULL, (CFDictionaryRef)attrs,
+                                  &c->planar_pool) != kCVReturnSuccess)
+         return NULL;
+      c->planar_w = w;
+      c->planar_h = h;
+   }
+   CVPixelBufferRef dst = NULL;
+   if (CVPixelBufferPoolCreatePixelBuffer(kCFAllocatorDefault, c->planar_pool, &dst) != kCVReturnSuccess)
+      return NULL;
+   if (VTPixelTransferSessionTransferImage(c->transfer, src, dst) != noErr) {
+      CVPixelBufferRelease(dst);
+      return NULL;
+   }
+   return dst;
+}
+
+static void destroy_session(struct virgl_video_codec *c)
+{
+   if (c->session) {
+      VTDecompressionSessionWaitForAsynchronousFrames(c->session);
+      VTDecompressionSessionInvalidate(c->session);
+      CFRelease(c->session);
+      c->session = NULL;
+   }
+   if (c->format) {
+      CFRelease(c->format);
+      c->format = NULL;
+   }
+}
+
+/* Release pictures whose copies have run.  Fences of one context signal in
+ * order, so this stops at the first pending one; with `wait` set, it blocks
+ * (bounded) on the oldest picture too.  Without a current GL context the
+ * fences cannot be queried and everything is released. */
+static void inflight_reap(struct virgl_video_codec *c, bool wait)
+{
+   const bool have_ctx = CGLGetCurrentContext() != NULL;
+   unsigned done = 0;
+   while (done < c->n_inflight) {
+      GLsync fence = c->inflight[done].fence;
+      if (have_ctx && fence) {
+         GLenum r = glClientWaitSync(fence, wait ? GL_SYNC_FLUSH_COMMANDS_BIT : 0,
+                                     wait ? 100000000ull : 0);
+         if (r == GL_TIMEOUT_EXPIRED)
+            break;
+         glDeleteSync(fence);
+      }
+      CVPixelBufferRelease(c->inflight[done].pb);
+      done++;
+      wait = false;
+   }
+   memmove(c->inflight, c->inflight + done, (c->n_inflight - done) * sizeof(c->inflight[0]));
+   c->n_inflight -= done;
+}
+
+/* Called right after the copies of `pb` were queued in the current context. */
+static void inflight_push(struct virgl_video_codec *c, CVPixelBufferRef pb)
+{
+   if (video_sync_finish || !CGLGetCurrentContext()) {
+      if (CGLGetCurrentContext())
+         glFinish();
+      return;
+   }
+   inflight_reap(c, c->n_inflight == VT_MAX_INFLIGHT);
+   if (c->n_inflight == VT_MAX_INFLIGHT) {
+      glFinish(); /* the oldest fence timed out: give up on overlapping */
+      inflight_reap(c, false);
+      return;
+   }
+   c->inflight[c->n_inflight].pb = CVPixelBufferRetain(pb);
+   c->inflight[c->n_inflight].fence = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+   c->n_inflight++;
+   glFlush(); /* other contexts see the copies once they are flushed */
+}
+
+static bool create_session(struct virgl_video_codec *c)
+{
+   @autoreleasepool {
+      const uint8_t *sets[2] = { c->sps, c->pps };
+      const size_t sizes[2] = { c->sps_len, c->pps_len };
+      CMVideoFormatDescriptionRef fmt = NULL;
+      OSStatus st = CMVideoFormatDescriptionCreateFromH264ParameterSets(
+            kCFAllocatorDefault, 2, sets, sizes, 4, &fmt);
+      if (st != noErr) {
+         virgl_error("vt: rebuilt H.264 parameter sets rejected (%d)\n", (int)st);
+         return false;
+      }
+      if (c->session && VTDecompressionSessionCanAcceptFormatDescription(c->session, fmt)) {
+         CFRelease(c->format);
+         c->format = fmt;
+         return true;
+      }
+      destroy_session(c);
+      c->format = fmt;
+
+      const bool ten_bit = c->h264.pps.sps.bit_depth_luma_minus8 > 0;
+      NSDictionary *attrs = @{
+         (id)kCVPixelBufferPixelFormatTypeKey:
+            @(ten_bit ? kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange
+                      : kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange),
+         /* IOSurface-backed only: the GL path binds the IOSurface itself.
+          * kCVPixelBufferOpenGLCompatibilityKey made VideoToolbox deliver
+          * different (non bit-exact) samples, measured against FFmpeg. */
+         (id)kCVPixelBufferIOSurfacePropertiesKey: @{},
+      };
+      VTDecompressionOutputCallbackRecord cb = { vt_output, c };
+      NSDictionary *hw = @{
+         (id)kVTVideoDecoderSpecification_RequireHardwareAcceleratedVideoDecoder: @YES,
+      };
+      st = VTDecompressionSessionCreate(kCFAllocatorDefault, fmt, (CFDictionaryRef)hw,
+                                        (CFDictionaryRef)attrs, &cb, &c->session);
+      c->session_hw = st == noErr;
+      if (st != noErr) {
+         /* e.g. a profile the media engine lacks: let VideoToolbox pick */
+         st = VTDecompressionSessionCreate(kCFAllocatorDefault, fmt, NULL,
+                                           (CFDictionaryRef)attrs, &cb, &c->session);
+      }
+      if (st != noErr) {
+         virgl_error("vt: VTDecompressionSessionCreate failed (%d)\n", (int)st);
+         c->session = NULL;
+         return false;
+      }
+      virgl_info("vt: H.264 %ux%u session (%s)\n", c->width, c->height,
+                 c->session_hw ? "hardware" : "VideoToolbox-selected decoder");
+      return true;
+   }
+}
+
+static int h264_decode_frame(struct virgl_video_codec *c, struct virgl_video_buffer *target)
+{
+   struct nal nals[256];
+   const unsigned count = split_annexb(c->bs, c->bs_len, nals, 256);
+   uint32_t pps_id = UINT32_MAX;
+   size_t avcc_len = 0;
+
+   for (unsigned i = 0; i < count; i++) {
+      const uint8_t type = nals[i].n ? nals[i].p[0] & 0x1f : 0;
+      vt_debug(c, "vt: frame %llu nal %u type %u size %zu\n",
+               (unsigned long long)c->frames, i, type, nals[i].n);
+      if (type == 1 || type == 5) {
+         if (pps_id == UINT32_MAX && !slice_pps_id(&nals[i], &pps_id)) {
+            vt_debug(c, "vt: slice header parse failed\n");
+            return -1;
+         }
+         avcc_len += 4 + nals[i].n;
+      }
+   }
+   vt_debug(c, "vt: %zu bitstream bytes, %u NALs, pps_id %u, desc %d\n",
+            c->bs_len, count, pps_id, c->have_desc);
+   if (getenv("VIRGL_VIDEO_DUMP") && c->frames == 0) {
+      FILE *df = fopen(getenv("VIRGL_VIDEO_DUMP"), "wb");
+      if (df) {
+         fwrite(c->bs, 1, c->bs_len, df);
+         fclose(df);
+      }
+   }
+   vt_debug(c, "vt: desc refs sps %u pic %u, ref_idx defaults %u/%u active %u/%u, "
+            "level %u, chroma %u, depth %u, t8x8 %u, wp %u/%u\n",
+            c->h264.pps.sps.max_num_ref_frames, c->h264.num_ref_frames,
+            c->h264.pps.num_ref_idx_l0_default_active_minus1,
+            c->h264.pps.num_ref_idx_l1_default_active_minus1,
+            c->h264.num_ref_idx_l0_active_minus1, c->h264.num_ref_idx_l1_active_minus1,
+            c->h264.pps.sps.level_idc, c->h264.pps.sps.chroma_format_idc,
+            c->h264.pps.sps.bit_depth_luma_minus8, c->h264.pps.transform_8x8_mode_flag,
+            c->h264.pps.weighted_pred_flag, c->h264.pps.weighted_bipred_idc);
+   if (!avcc_len || !c->have_desc)
+      return -1;
+   if (c->h264.pps.num_slice_groups_minus1) {
+      if (!c->errors++)
+         virgl_warn("vt: H.264 slice groups (FMO) are not supported\n");
+      return -1;
+   }
+
+   /* The descriptor carries the last slice's active counts; when that slice
+    * does not override them they are the PPS defaults. */
+   for (int i = (int)count - 1; i >= 0; i--) {
+      const uint8_t type = nals[i].n ? nals[i].p[0] & 0x1f : 0;
+      if (type != 1 && type != 5)
+         continue;
+      bool is_b = false;
+      if (slice_uses_default_refs(c, &nals[i], &is_b)) {
+         if (!c->l0_learned) {
+            c->l0_default = c->h264.num_ref_idx_l0_active_minus1;
+            c->l0_learned = true;
+         }
+         if (is_b && !c->l1_learned) {
+            c->l1_default = c->h264.num_ref_idx_l1_active_minus1;
+            c->l1_learned = true;
+         }
+      }
+      break;
+   }
+
+   uint8_t sps[sizeof(c->sps)], pps[sizeof(c->pps)];
+   const size_t sps_len = h264_build_sps(c, sps, sizeof(sps));
+   const size_t pps_len = h264_build_pps(c, pps_id, pps, sizeof(pps));
+   if (!sps_len || !pps_len)
+      return -1;
+   const bool sps_changed = !c->session || sps_len != c->sps_len || memcmp(sps, c->sps, sps_len);
+   const bool pps_changed = pps_len != c->pps_len || memcmp(pps, c->pps, pps_len);
+   if (!sps_changed && pps_changed && c->session) {
+      /* PPS-only change (learned defaults): swap the format description if
+       * the session takes it, else carry the PPS in-band; never drop the
+       * session's reference frames for it */
+      memcpy(c->pps, pps, pps_len);
+      c->pps_len = pps_len;
+      const uint8_t *sets[2] = { c->sps, c->pps };
+      const size_t sizes[2] = { c->sps_len, c->pps_len };
+      CMVideoFormatDescriptionRef fmt = NULL;
+      if (CMVideoFormatDescriptionCreateFromH264ParameterSets(kCFAllocatorDefault, 2, sets, sizes,
+                                                              4, &fmt) == noErr &&
+          VTDecompressionSessionCanAcceptFormatDescription(c->session, fmt)) {
+         CFRelease(c->format);
+         c->format = fmt;
+         c->inband_pps = false;
+      } else {
+         if (fmt)
+            CFRelease(fmt);
+         c->inband_pps = true;
+      }
+      vt_debug(c, "vt: PPS defaults now %u/%u (%s)\n", c->l0_default, c->l1_default,
+               c->inband_pps ? "in-band" : "format swap");
+   } else if (sps_changed) {
+      if (c->session) {
+         /* a new stream: its PPS defaults are unknown again */
+         c->l0_learned = c->l1_learned = false;
+         c->l0_default = c->l1_default = 0;
+      }
+      c->inband_pps = false;
+      memcpy(c->sps, sps, sps_len);
+      memcpy(c->pps, pps, pps_len);
+      c->sps_len = sps_len;
+      c->pps_len = pps_len;
+      if (video_debug) {
+         char hex[2 * sizeof(c->sps) + 1];
+         for (size_t i = 0; i < sps_len; i++)
+            snprintf(hex + 2 * i, 3, "%02x", sps[i]);
+         virgl_info("vt: SPS %s\n", hex);
+         for (size_t i = 0; i < pps_len; i++)
+            snprintf(hex + 2 * i, 3, "%02x", pps[i]);
+         virgl_info("vt: PPS %s\n", hex);
+      }
+      if (!create_session(c))
+         return -1;
+   }
+
+   if (c->inband_pps)
+      avcc_len += 4 + c->pps_len;
+   uint8_t *avcc = malloc(avcc_len);
+   if (!avcc)
+      return -1;
+   size_t off = 0;
+   if (c->inband_pps) {
+      const uint32_t n = (uint32_t)c->pps_len;
+      avcc[off++] = (uint8_t)(n >> 24);
+      avcc[off++] = (uint8_t)(n >> 16);
+      avcc[off++] = (uint8_t)(n >> 8);
+      avcc[off++] = (uint8_t)n;
+      memcpy(avcc + off, c->pps, n);
+      off += n;
+   }
+   for (unsigned i = 0; i < count; i++) {
+      const uint8_t type = nals[i].n ? nals[i].p[0] & 0x1f : 0;
+      if (type != 1 && type != 5)
+         continue;
+      const uint32_t n = (uint32_t)nals[i].n;
+      avcc[off++] = (uint8_t)(n >> 24);
+      avcc[off++] = (uint8_t)(n >> 16);
+      avcc[off++] = (uint8_t)(n >> 8);
+      avcc[off++] = (uint8_t)n;
+      memcpy(avcc + off, nals[i].p, n);
+      off += n;
+   }
+
+   CMBlockBufferRef block = NULL;
+   CMSampleBufferRef sample = NULL;
+   OSStatus st = CMBlockBufferCreateWithMemoryBlock(kCFAllocatorDefault, avcc, avcc_len,
+                                                    kCFAllocatorMalloc, NULL, 0, avcc_len,
+                                                    0, &block);
+   if (st != noErr) {
+      free(avcc);
+      return -1;
+   }
+   const size_t sample_size = avcc_len;
+   st = CMSampleBufferCreateReady(kCFAllocatorDefault, block, c->format, 1, 0, NULL,
+                                  1, &sample_size, &sample);
+   CFRelease(block);
+   if (st != noErr)
+      return -1;
+
+   if (c->out) {
+      CVBufferRelease(c->out);
+      c->out = NULL;
+   }
+   c->out_status = noErr;
+   VTDecodeInfoFlags info = 0;
+   const uint64_t t0 = vt_now_ns();
+   st = VTDecompressionSessionDecodeFrame(c->session, sample, 0, NULL, &info);
+   VTDecompressionSessionWaitForAsynchronousFrames(c->session);
+   const uint64_t t1 = vt_now_ns();
+   c->t_decode += t1 - t0;
+   CFRelease(sample);
+   if (st != noErr || c->out_status != noErr || !c->out) {
+      if (c->errors++ < 8)
+         virgl_warn("vt: decode failed (%d/%d)\n", (int)st, (int)c->out_status);
+      return -1;
+   }
+
+   CVPixelBufferRef pb = (CVPixelBufferRef)c->out;
+   CVPixelBufferRef planar = NULL;
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations" /* MD5 to match FFmpeg's framemd5 */
+   if (video_md5) {
+      /* verification aid: MD5 of the decoded NV12 picture, cropped the way
+       * a 1088-line coded 1080p stream is (16-line coding, 8 lines cropped) */
+      const size_t w = CVPixelBufferGetWidth(pb), h = CVPixelBufferGetHeight(pb);
+      const size_t vis_h = (h % 16 == 0 && h % 9 != 0 && (h - 8) % 9 == 0) ? h - 8 : h;
+      CVPixelBufferLockBaseAddress(pb, kCVPixelBufferLock_ReadOnly);
+      CC_MD5_CTX md;
+      CC_MD5_Init(&md);
+      const uint8_t *y = CVPixelBufferGetBaseAddressOfPlane(pb, 0);
+      const uint8_t *uv = CVPixelBufferGetBaseAddressOfPlane(pb, 1);
+      const size_t ys = CVPixelBufferGetBytesPerRowOfPlane(pb, 0);
+      const size_t uvs = CVPixelBufferGetBytesPerRowOfPlane(pb, 1);
+      for (size_t r = 0; r < vis_h; r++)
+         CC_MD5_Update(&md, y + r * ys, (CC_LONG)w);
+      for (size_t r = 0; r < vis_h / 2; r++)
+         CC_MD5_Update(&md, uv + r * uvs, (CC_LONG)w);
+      unsigned char d[16];
+      CC_MD5_Final(d, &md);
+      if (c->frames == 0)
+         virgl_info("vt: sample %zux%zu ys %zu uvs %zu vis_h %zu y0 %02x%02x%02x%02x%02x%02x%02x%02x "
+                    "y540 %02x%02x%02x%02x uv0 %02x%02x%02x%02x\n", w, h, ys, uvs, vis_h,
+                    y[0], y[1], y[2], y[3], y[4], y[5], y[6], y[7], y[540 * ys], y[540 * ys + 1],
+                    y[540 * ys + 2], y[540 * ys + 3], uv[0], uv[1], uv[2], uv[3]);
+      CVPixelBufferUnlockBaseAddress(pb, kCVPixelBufferLock_ReadOnly);
+      fprintf(video_md5, "%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x\n",
+              d[0], d[1], d[2], d[3], d[4], d[5], d[6], d[7], d[8], d[9], d[10], d[11], d[12],
+              d[13], d[14], d[15]);
+      fflush(video_md5);
+   }
+#pragma clang diagnostic pop
+   const bool target_planar = target->format == PIPE_FORMAT_IYUV ||
+                              target->format == PIPE_FORMAT_YV12;
+   const uint64_t t2 = vt_now_ns();
+   if (target_planar) {
+      planar = to_planar(c, pb);
+      if (!planar) {
+         if (c->errors++ < 8)
+            virgl_warn("vt: NV12 to planar conversion failed\n");
+         return -1;
+      }
+      pb = planar;
+   }
+   struct virgl_video_dma_buf frame = {
+      .buf = target,
+      .width = (uint32_t)CVPixelBufferGetWidth(pb),
+      .height = (uint32_t)CVPixelBufferGetHeight(pb),
+      .flags = VIRGL_VIDEO_DMABUF_READ_ONLY,
+      .num_planes = (uint32_t)CVPixelBufferGetPlaneCount(pb),
+      .iosurface = CVPixelBufferGetIOSurface(pb),
+      /* 'y420' planes are Y, Cb, Cr; YV12 wants Y, Cr, Cb */
+      .iosurface_plane = { 0, target->format == PIPE_FORMAT_YV12 ? 2 : 1,
+                           target->format == PIPE_FORMAT_YV12 ? 1 : 2, 3 },
+   };
+   if (!frame.iosurface) {
+      if (c->errors++ < 8)
+         virgl_warn("vt: decoded frame is not IOSurface-backed\n");
+      if (planar)
+         CVPixelBufferRelease(planar);
+      return -1;
+   }
+   vt_debug(c, "vt: decoded %ux%u planes %u iosurface %p fmt %08x cb %p\n", frame.width,
+            frame.height, frame.num_planes, frame.iosurface,
+            (unsigned)CVPixelBufferGetPixelFormatType(pb),
+            (void *)(video_cbs ? video_cbs->decode_completed : NULL));
+   const uint64_t t3 = vt_now_ns();
+   c->t_convert += t3 - t2;
+   c->frames++;
+   if (video_cbs && video_cbs->decode_completed)
+      video_cbs->decode_completed(c, &frame);
+   inflight_push(c, pb);
+   c->t_copy += vt_now_ns() - t3;
+   if (planar)
+      CVPixelBufferRelease(planar);
+   if (video_debug && c->frames % 120 == 0)
+      virgl_info("vt: %llu frames, per frame: decode %.2f ms, convert %.2f ms, copy %.2f ms\n",
+                 (unsigned long long)c->frames, c->t_decode / 1e6 / c->frames,
+                 c->t_convert / 1e6 / c->frames, c->t_copy / 1e6 / c->frames);
+   return 0;
+}
