--- /dev/null
+++ b/src/vrend/virgl_video_vt.m
@@ -0,0 +1,1128 @@
+/*
+ * VideoToolbox implementation of the virgl video interface (virgl_video.h)
+ * for macOS hosts.
+ *
+ * The guest's Mesa VA-API driver for virgl sends stateless decode requests:
+ * parsed parameter sets in a virgl picture descriptor plus the slice NAL
+ * units.  VideoToolbox is a stateful decoder that wants the parameter sets
+ * themselves, so for H.264 the SPS and PPS are rebuilt from the descriptor,
+ * the slices are repacked as length-prefixed (AVCC) samples, and each frame
+ * is decoded synchronously.  The decoded CVPixelBuffer is IOSurface-backed;
+ * vrend copies its planes into the guest's video-buffer textures on the GPU
+ * (see vrend_video.c), so no decoded pixel crosses the CPU.  Those copies are
+ * only queued: the picture is kept alive behind a GL fence and handed back to
+ * VideoToolbox's pool once the GPU has read it.
+ *
+ * SPDX-License-Identifier: MIT
+ */
