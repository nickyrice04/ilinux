+void virgl_video_destroy(void)
+{
+   video_cbs = NULL;
+}
+
+int virgl_video_fill_caps(union virgl_caps *caps)
+{
+   static const uint32_t profiles[] = {
+      MESA26_PROFILE_AVC_CONSTRAINED_BASELINE,
+      MESA26_PROFILE_AVC_MAIN,
+      MESA26_PROFILE_AVC_HIGH,
+   };
+   if (!caps)
+      return -1;
+   caps->v2.num_video_caps = 0;
+   if (getenv("VIRGL_VIDEO_PROBE_PROFILES")) {
+      /* diagnostic: advertise raw profile values 1..31 to map the guest enum */
+      for (unsigned p = 1; p < 32; p++) {
+         struct virgl_video_caps *v = &caps->v2.video_caps[caps->v2.num_video_caps++];
+         memset(v, 0, sizeof(*v));
+         v->profile = p;
+         v->entrypoint = PIPE_VIDEO_ENTRYPOINT_BITSTREAM;
+         v->max_width = 4096;
+         v->max_height = 4096;
+         v->prefered_format = PIPE_FORMAT_NV12;
+         v->max_macroblocks = 65535;
+         v->npot_texture = 1;
+         v->supports_progressive = 1;
+      }
+      return 0;
+   }
+   for (unsigned i = 0; i < sizeof(profiles) / sizeof(profiles[0]); i++) {
+      struct virgl_video_caps *v = &caps->v2.video_caps[caps->v2.num_video_caps++];
+      memset(v, 0, sizeof(*v));
+      v->profile = profiles[i];
+      v->entrypoint = PIPE_VIDEO_ENTRYPOINT_BITSTREAM;
+      v->max_level = 52;
+      v->max_width = 4096;
+      v->max_height = 4096;
+      v->prefered_format = MESA26_FORMAT_NV12;
+      v->max_macroblocks = 65535;
+      v->npot_texture = 1;
+      v->supports_progressive = 1;
+   }
+   return 0;
+}
+
+struct virgl_video_codec *virgl_video_create_codec(const struct virgl_video_create_codec_args *args)
+{
+   if (video_debug && args)
+      virgl_info("vt: create codec request: profile %d entrypoint %d chroma %d %ux%u\n",
+                 args->profile, args->entrypoint, args->chroma_format, args->width,
+                 args->height);
+   if (!args || args->entrypoint != PIPE_VIDEO_ENTRYPOINT_BITSTREAM ||
+       !guest_profile_is_h264(args->profile))
+      return NULL;
+   struct virgl_video_codec *c = calloc(1, sizeof(*c));
+   if (!c)
+      return NULL;
+   /* keep the host enum value for virgl_video_codec_profile() */
+   c->profile = PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH;
+   c->entrypoint = args->entrypoint;
+   c->width = args->width;
+   c->height = args->height;
+   c->level = args->level;
+   c->opaque = args->opaque;
+   if (video_debug)
+      virgl_info("vt: codec profile %d %ux%u level %u\n", args->profile, args->width,
+                 args->height, args->level);
+   return c;
+}
+
+void virgl_video_destroy_codec(struct virgl_video_codec *c)
+{
+   if (!c)
+      return;
+   if (c->n_inflight && CGLGetCurrentContext())
+      glFinish();
+   inflight_reap(c, false);
+   destroy_session(c);
+   destroy_transfer(c);
+   if (c->out)
+      CVBufferRelease(c->out);
+   if (c->frames || c->errors)
+      virgl_info("vt: codec closed after %llu frames, %u errors\n",
+                 (unsigned long long)c->frames, c->errors);
+   free(c->bs);
+   free(c);
+}
