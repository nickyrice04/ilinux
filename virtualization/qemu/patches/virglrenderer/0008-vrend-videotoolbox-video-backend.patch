+/* ------------------------------------------------------------------ */
+/* H.264 bitstream writer (RBSP) and NAL packing                        */
+
+struct bitw {
+   uint8_t buf[1024];
+   size_t len;
+   uint32_t acc;
+   int nbits;
+   bool overflow;
+};
+
+static void bw_bits(struct bitw *w, uint32_t v, int n)
+{
+   for (int i = n - 1; i >= 0; i--) {
+      w->acc = (w->acc << 1) | ((v >> i) & 1);
+      if (++w->nbits == 8) {
+         if (w->len < sizeof(w->buf))
+            w->buf[w->len++] = (uint8_t)w->acc;
+         else
+            w->overflow = true;
+         w->acc = 0;
+         w->nbits = 0;
+      }
+   }
+}
+
+static void bw_ue(struct bitw *w, uint32_t v)
+{
+   uint64_t x = (uint64_t)v + 1;
+   int len = 0;
+   while ((x >> (len + 1)) != 0)
+      len++;
+   bw_bits(w, 0, len);
+   bw_bits(w, (uint32_t)x, len + 1);
+}
+
+static void bw_se(struct bitw *w, int32_t v)
+{
+   bw_ue(w, v > 0 ? (uint32_t)(2 * v - 1) : (uint32_t)(-2 * (int64_t)v));
+}
+
+static void bw_trailing(struct bitw *w)
+{
+   bw_bits(w, 1, 1);
+   while (w->nbits)
+      bw_bits(w, 0, 1);
+}
+
+/* NAL header + RBSP with emulation-prevention bytes */
+static size_t pack_nal(uint8_t nal_ref_idc, uint8_t type, const struct bitw *w,
+                       uint8_t *out, size_t cap)
+{
+   size_t n = 0, zeros = 0;
+   if (cap < 1)
+      return 0;
+   out[n++] = (uint8_t)((nal_ref_idc << 5) | type);
+   for (size_t i = 0; i < w->len; i++) {
+      if (zeros >= 2 && w->buf[i] <= 3) {
+         if (n >= cap)
+            return 0;
+         out[n++] = 3;
+         zeros = 0;
+      }
+      if (n >= cap)
+         return 0;
+      out[n++] = w->buf[i];
+      zeros = w->buf[i] ? 0 : zeros + 1;
+   }
+   return n;
+}
+
+static bool list_is_flat(const uint8_t *l, unsigned n)
+{
+   for (unsigned i = 0; i < n; i++)
+      if (l[i] != 16)
+         return false;
+   return true;
+}
+
+/* Lists arrive in coding (zig-zag) order, as VA-API and the bitstream use. */
+static void bw_scaling_list(struct bitw *w, const uint8_t *list, unsigned n)
+{
+   int last = 8;
+   for (unsigned j = 0; j < n; j++) {
+      int delta = ((int)list[j] - last + 384) % 256 - 128;
+      bw_se(w, delta);
+      last = list[j];
+   }
+}
+
+/*
+ * The guest's Mesa sends enum pipe_video_profile values raw, and Mesa 26 no
+ * longer matches this tree's copy of the enum (MPEG-4 Part 2 entries removed,
+ * HEVC entries added before VP9).  Values measured from Mesa 26.2 guests:
+ */
+enum {
+   MESA26_PROFILE_AVC_CONSTRAINED_BASELINE = 8,
+   MESA26_PROFILE_AVC_MAIN = 9,
+   MESA26_PROFILE_AVC_HIGH = 11,
+   MESA26_PROFILE_AVC_HIGH10 = 12,
+   MESA26_PROFILE_HEVC_MAIN = 15,
+   MESA26_PROFILE_VP9_PROFILE0 = 24,
+   MESA26_PROFILE_VP9_PROFILE2 = 25,
+};
+
+/* The caps' preferred format is read the same raw way.  Video buffers then
+ * arrive translated to virgl format numbers (NV12 = 166), but Mesa 26 calls
+ * 166 IYUV (measured: advertising 166 produced 3-plane IYUV buffers). */
+#define MESA26_FORMAT_NV12 167
+
+static bool guest_profile_is_h264(uint32_t p)
+{
+   return p == MESA26_PROFILE_AVC_CONSTRAINED_BASELINE || p == MESA26_PROFILE_AVC_MAIN ||
+          p == MESA26_PROFILE_AVC_HIGH;
+}
+
+/* profile_idc from the stream's own properties: High (a superset of
+ * Baseline/Main for decoding) unless the chroma format or depth needs more */
+static int h264_stream_profile_idc(const struct virgl_h264_sps *sps)
+{
+   if (sps->chroma_format_idc == 3)
+      return 244;
+   if (sps->chroma_format_idc == 2)
+      return 122;
+   if (sps->bit_depth_luma_minus8 || sps->bit_depth_chroma_minus8)
+      return 110;
+   return 100;
+}
+
+static bool h264_is_high(int profile_idc)
+{
+   return profile_idc == 100 || profile_idc == 110 || profile_idc == 122 ||
+          profile_idc == 244 || profile_idc == 44;
+}
+
+static size_t h264_build_sps(const struct virgl_video_codec *c, uint8_t *out, size_t cap)
+{
+   const struct virgl_h264_sps *sps = &c->h264.pps.sps;
+   const int profile_idc = h264_stream_profile_idc(sps);
+   struct bitw w = { 0 };
+
+   bw_bits(&w, profile_idc, 8);
+   bw_bits(&w, 0, 8); /* constraint_set0..5 flags + reserved_zero_2bits */
+   /* VA-API carries no level: claim 5.2, which only sizes the reference
+    * buffer (frames come out in decode order, so no extra output delay) */
+   bw_bits(&w, 52, 8);
+   bw_ue(&w, 0); /* seq_parameter_set_id */
+   if (h264_is_high(profile_idc)) {
+      bw_ue(&w, sps->chroma_format_idc);
+      if (sps->chroma_format_idc == 3)
+         bw_bits(&w, sps->separate_colour_plane_flag, 1);
+      bw_ue(&w, sps->bit_depth_luma_minus8);
+      bw_ue(&w, sps->bit_depth_chroma_minus8);
+      bw_bits(&w, 0, 1); /* qpprime_y_zero_transform_bypass_flag */
+      /* effective lists travel in the PPS (see h264_build_pps) */
+      bw_bits(&w, 0, 1); /* seq_scaling_matrix_present_flag */
+   }
+   bw_ue(&w, sps->log2_max_frame_num_minus4);
+   bw_ue(&w, sps->pic_order_cnt_type);
+   if (sps->pic_order_cnt_type == 0) {
+      bw_ue(&w, sps->log2_max_pic_order_cnt_lsb_minus4);
+   } else if (sps->pic_order_cnt_type == 1) {
+      bw_bits(&w, sps->delta_pic_order_always_zero_flag, 1);
+      bw_se(&w, sps->offset_for_non_ref_pic);
+      bw_se(&w, sps->offset_for_top_to_bottom_field);
+      bw_ue(&w, sps->num_ref_frames_in_pic_order_cnt_cycle);
+      for (unsigned i = 0; i < sps->num_ref_frames_in_pic_order_cnt_cycle && i < 256; i++)
+         bw_se(&w, sps->offset_for_ref_frame[i]);
+   }
+   /* VA-API passes the SPS reference count at picture level */
+   uint32_t max_refs = sps->max_num_ref_frames;
+   if (c->h264.num_ref_frames > max_refs)
+      max_refs = c->h264.num_ref_frames;
+   bw_ue(&w, max_refs ? max_refs : 1);
+   bw_bits(&w, 0, 1); /* gaps_in_frame_num_value_allowed_flag */
+   const uint32_t mbs_w = (c->width + 15) / 16;
+   const uint32_t mbs_h = (c->height + 15) / 16;
+   const uint32_t map_units_h = sps->frame_mbs_only_flag ? mbs_h : (mbs_h + 1) / 2;
+   bw_ue(&w, mbs_w - 1);
+   bw_ue(&w, map_units_h - 1);
+   bw_bits(&w, sps->frame_mbs_only_flag, 1);
+   if (!sps->frame_mbs_only_flag)
+      bw_bits(&w, sps->mb_adaptive_frame_field_flag, 1);
+   bw_bits(&w, sps->direct_8x8_inference_flag, 1);
+   bw_bits(&w, 0, 1); /* frame_cropping_flag: the guest crops */
+   bw_bits(&w, 0, 1); /* vui_parameters_present_flag */
+   bw_trailing(&w);
+   return w.overflow ? 0 : pack_nal(3, 7, &w, out, cap);
+}
+
+static size_t h264_build_pps(const struct virgl_video_codec *c, uint32_t pps_id,
+                             uint8_t *out, size_t cap)
+{
+   const struct virgl_h264_pps *pps = &c->h264.pps;
+   const struct virgl_h264_sps *sps = &pps->sps;
+   const int profile_idc = h264_stream_profile_idc(sps);
+   struct bitw w = { 0 };
+
+   bw_ue(&w, pps_id);
+   bw_ue(&w, 0); /* seq_parameter_set_id */
+   bw_bits(&w, pps->entropy_coding_mode_flag, 1);
+   bw_bits(&w, pps->bottom_field_pic_order_in_frame_present_flag, 1);
+   bw_ue(&w, 0); /* num_slice_groups_minus1 (FMO is rejected earlier) */
+   bw_ue(&w, c->l0_default);
+   bw_ue(&w, c->l1_default);
+   bw_bits(&w, pps->weighted_pred_flag, 1);
+   bw_bits(&w, pps->weighted_bipred_idc, 2);
+   bw_se(&w, pps->pic_init_qp_minus26);
+   bw_se(&w, pps->pic_init_qs_minus26);
+   bw_se(&w, pps->chroma_qp_index_offset);
+   bw_bits(&w, pps->deblocking_filter_control_present_flag, 1);
+   bw_bits(&w, pps->constrained_intra_pred_flag, 1);
+   bw_bits(&w, pps->redundant_pic_cnt_present_flag, 1);
+
+   if (h264_is_high(profile_idc)) {
+      const unsigned n8x8 = pps->transform_8x8_mode_flag ?
+                            (sps->chroma_format_idc == 3 ? 6 : 2) : 0;
+      bool flat = list_is_flat(&pps->ScalingList4x4[0][0], 6 * 16);
+      for (unsigned i = 0; i < n8x8; i++)
+         flat = flat && list_is_flat(pps->ScalingList8x8[i], 64);
+      const bool ext = pps->transform_8x8_mode_flag || !flat ||
+                       pps->second_chroma_qp_index_offset != pps->chroma_qp_index_offset;
+      if (ext) {
+         bw_bits(&w, pps->transform_8x8_mode_flag, 1);
+         bw_bits(&w, flat ? 0 : 1, 1); /* pic_scaling_matrix_present_flag */
+         if (!flat) {
+            for (unsigned i = 0; i < 6; i++) {
+               bw_bits(&w, 1, 1);
+               bw_scaling_list(&w, pps->ScalingList4x4[i], 16);
+            }
+            for (unsigned i = 0; i < n8x8; i++) {
+               bw_bits(&w, 1, 1);
+               bw_scaling_list(&w, pps->ScalingList8x8[i], 64);
+            }
+         }
+         bw_se(&w, pps->second_chroma_qp_index_offset);
+      }
+   }
+   bw_trailing(&w);
+   return w.overflow ? 0 : pack_nal(3, 8, &w, out, cap);
+}
+
+/* ------------------------------------------------------------------ */
+/* Annex B parsing                                                      */
+
+struct nal { const uint8_t *p; size_t n; };
+
+static unsigned split_annexb(const uint8_t *b, size_t len, struct nal *nals, unsigned max)
+{
+   unsigned count = 0;
+   size_t i = 0, start = SIZE_MAX;
+   while (i + 3 <= len) {
+      if (b[i] == 0 && b[i + 1] == 0 && b[i + 2] == 1) {
+         if (start != SIZE_MAX && count < max) {
+            size_t end = i;
+            while (end > start && b[end - 1] == 0)
+               end--;
+            nals[count++] = (struct nal){ b + start, end - start };
+         }
+         i += 3;
+         start = i;
+      } else {
+         i++;
+      }
+   }
+   if (start != SIZE_MAX && start < len && count < max)
+      nals[count++] = (struct nal){ b + start, len - start };
+   return count;
+}
+
+/* Exp-Golomb reader over a NAL payload that skips emulation-prevention bytes */
+struct bitr { const uint8_t *p; size_t n, pos; int bit; unsigned zeros; bool eof; };
+
+static int br_bit(struct bitr *r)
+{
+   if (r->pos >= r->n) {
+      r->eof = true;
+      return 0;
+   }
+   if (r->bit == 0) {
+      if (r->zeros >= 2 && r->p[r->pos] == 3) {
+         r->zeros = 0;
+         if (++r->pos >= r->n) {
+            r->eof = true;
+            return 0;
+         }
+      }
+      r->zeros = r->p[r->pos] ? 0 : r->zeros + 1;
+   }
+   int v = (r->p[r->pos] >> (7 - r->bit)) & 1;
+   if (++r->bit == 8) {
+      r->bit = 0;
+      r->pos++;
+   }
+   return v;
+}
+
+static uint32_t br_ue(struct bitr *r)
+{
+   int zeros = 0;
+   while (!br_bit(r) && !r->eof && zeros < 31)
+      zeros++;
+   uint32_t v = 0;
+   for (int i = 0; i < zeros; i++)
+      v = (v << 1) | (uint32_t)br_bit(r);
+   return (1u << zeros) - 1 + v;
+}
+
+/* Returns true when this P/SP/B slice uses the PPS num_ref_idx defaults
+ * (num_ref_idx_active_override_flag == 0); *is_b tells whether L1 applies. */
+static bool slice_uses_default_refs(const struct virgl_video_codec *c, const struct nal *n,
+                                    bool *is_b)
+{
+   const struct virgl_h264_pps *pps = &c->h264.pps;
+   const struct virgl_h264_sps *sps = &pps->sps;
+   struct bitr r = { .p = n->p + 1, .n = n->n - 1 };
+   const uint8_t nal_type = n->p[0] & 0x1f;
+
+   (void)br_ue(&r);                            /* first_mb_in_slice */
+   const uint32_t slice_type = br_ue(&r) % 5;
+   (void)br_ue(&r);                            /* pic_parameter_set_id */
+   for (unsigned i = 0; i < sps->log2_max_frame_num_minus4 + 4u; i++)
+      (void)br_bit(&r);                        /* frame_num */
+   bool field_pic = false;
+   if (!sps->frame_mbs_only_flag) {
+      field_pic = br_bit(&r);
+      if (field_pic)
+         (void)br_bit(&r);                     /* bottom_field_flag */
+   }
+   if (nal_type == 5)
+      (void)br_ue(&r);                         /* idr_pic_id */
+   if (sps->pic_order_cnt_type == 0) {
+      for (unsigned i = 0; i < sps->log2_max_pic_order_cnt_lsb_minus4 + 4u; i++)
+         (void)br_bit(&r);                     /* pic_order_cnt_lsb */
+      if (pps->bottom_field_pic_order_in_frame_present_flag && !field_pic)
+         (void)br_ue(&r);                      /* delta_pic_order_cnt_bottom (se) */
+   } else if (sps->pic_order_cnt_type == 1 && !sps->delta_pic_order_always_zero_flag) {
+      (void)br_ue(&r);                         /* delta_pic_order_cnt[0] (se) */
+      if (pps->bottom_field_pic_order_in_frame_present_flag && !field_pic)
+         (void)br_ue(&r);                      /* delta_pic_order_cnt[1] (se) */
+   }
+   if (pps->redundant_pic_cnt_present_flag)
+      (void)br_ue(&r);                         /* redundant_pic_cnt */
+   *is_b = slice_type == 1;
+   if (*is_b)
+      (void)br_bit(&r);                        /* direct_spatial_mv_pred_flag */
+   if (slice_type != 0 && slice_type != 1 && slice_type != 3)
+      return false;                            /* I/SI: no reference lists */
+   const bool override = br_bit(&r);
+   return !r.eof && !override;
+}
+
+/* pic_parameter_set_id from the first slice header */
+static bool slice_pps_id(const struct nal *n, uint32_t *pps_id)
+{
+   struct bitr r = { .p = n->p + 1, .n = n->n - 1 };
+   (void)br_ue(&r); /* first_mb_in_slice */
+   (void)br_ue(&r); /* slice_type */
+   *pps_id = br_ue(&r);
+   return !r.eof && *pps_id < 256;
+}
