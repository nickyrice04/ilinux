 void virgl_metal_iosurface_mirror_destroy(struct virgl_metal_iosurface_mirror *mirror);
 
+/* Binds plane `plane` of an IOSurface to the texture bound to `target`
+ * (GL_TEXTURE_RECTANGLE) in the current CGL context; returns its size. */
+bool virgl_metal_bind_iosurface_plane(uint32_t target, uint32_t internal, uint32_t format,
+                                      uint32_t type, void *iosurface, uint32_t plane,
+                                      uint32_t *width, uint32_t *height);
+
+/* CPU view of one IOSurface plane (read-only lock); unlock when done */
+const void *virgl_metal_lock_iosurface_plane(void *iosurface, uint32_t plane,
+                                             uint32_t *bytes_per_row, uint32_t *height);
+void virgl_metal_unlock_iosurface(void *iosurface);
+
 #endif
--- a/src/vrend/vrend_metal.m
+++ b/src/vrend/vrend_metal.m
@@ -492,3 +492,48 @@
       CFRelease(m->surface);
    free(m);
 }
+
+bool virgl_metal_bind_iosurface_plane(uint32_t target, uint32_t internal, uint32_t format,
+                                      uint32_t type, void *iosurface, uint32_t plane,
+                                      uint32_t *width, uint32_t *height)
+{
+   IOSurfaceRef surface = (IOSurfaceRef)iosurface;
+   CGLContextObj ctx = CGLGetCurrentContext();
+   const size_t planes = surface ? IOSurfaceGetPlaneCount(surface) : 0;
+   if (!ctx || !surface || plane >= (planes ? planes : 1))
+      return false;
+
+   const size_t w = IOSurfaceGetPlaneCount(surface) ? IOSurfaceGetWidthOfPlane(surface, plane)
+                                                    : IOSurfaceGetWidth(surface);
+   const size_t h = IOSurfaceGetPlaneCount(surface) ? IOSurfaceGetHeightOfPlane(surface, plane)
+                                                    : IOSurfaceGetHeight(surface);
+   CGLError err = CGLTexImageIOSurface2D(ctx, target, internal, (GLsizei)w, (GLsizei)h,
+                                         format, type, surface, plane);
+   if (err != kCGLNoError) {
+      virgl_error("%s: plane %u: %s\n", __func__, plane, CGLErrorString(err));
+      return false;
+   }
+   *width = (uint32_t)w;
+   *height = (uint32_t)h;
+   return true;
+}
+
+const void *virgl_metal_lock_iosurface_plane(void *iosurface, uint32_t plane,
+                                             uint32_t *bytes_per_row, uint32_t *height)
+{
+   IOSurfaceRef surface = (IOSurfaceRef)iosurface;
+   if (!surface || IOSurfaceLock(surface, kIOSurfaceLockReadOnly, NULL) != kIOReturnSuccess)
+      return NULL;
+   const bool planar = IOSurfaceGetPlaneCount(surface) > 0;
+   *bytes_per_row = (uint32_t)(planar ? IOSurfaceGetBytesPerRowOfPlane(surface, plane)
+                                      : IOSurfaceGetBytesPerRow(surface));
+   *height = (uint32_t)(planar ? IOSurfaceGetHeightOfPlane(surface, plane)
+                               : IOSurfaceGetHeight(surface));
+   return planar ? IOSurfaceGetBaseAddressOfPlane(surface, plane)
+                 : IOSurfaceGetBaseAddress(surface);
+}
+
+void virgl_metal_unlock_iosurface(void *iosurface)
+{
+   IOSurfaceUnlock((IOSurfaceRef)iosurface, kIOSurfaceLockReadOnly, NULL);
+}
