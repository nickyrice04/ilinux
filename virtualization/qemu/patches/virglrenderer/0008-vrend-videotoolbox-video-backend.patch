+int virgl_video_init(int drm_fd, struct virgl_video_callbacks *cbs, unsigned int flags)
+{
+   (void)drm_fd;
+   (void)flags;
+   video_cbs = cbs;
+   video_debug = getenv("VIRGL_VIDEO_DEBUG") != NULL;
+   video_sync_finish = getenv("VIRGL_VIDEO_SYNC") && !strcmp(getenv("VIRGL_VIDEO_SYNC"), "finish");
+   if (getenv("VIRGL_VIDEO_MD5") && !video_md5)
+      video_md5 = fopen(getenv("VIRGL_VIDEO_MD5"), "w");
+   virgl_info("vt: VideoToolbox video backend ready (callbacks %s)\n", cbs ? "set" : "missing");
+   if (!VTIsHardwareDecodeSupported(kCMVideoCodecType_H264))
+      virgl_warn("vt: no hardware H.264 decoder reported\n");
+   return 0;
+}
