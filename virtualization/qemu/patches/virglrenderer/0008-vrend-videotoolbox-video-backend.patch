+
+int virgl_video_decode_bitstream(struct virgl_video_codec *c, struct virgl_video_buffer *target,
+                                 const union virgl_picture_desc *desc, unsigned num_buffers,
+                                 const void * const *buffers, const unsigned *sizes)
+{
+   (void)target;
+   if (!c || !desc)
+      return -1;
+   c->h264 = desc->h264;
+   c->have_desc = true;
+   for (unsigned i = 0; i < num_buffers; i++) {
+      const uint8_t *p = buffers[i];
+      const size_t n = sizes[i];
+      const bool has_sc = n >= 3 && p[0] == 0 && p[1] == 0 &&
+                          (p[2] == 1 || (n >= 4 && p[2] == 0 && p[3] == 1));
+      const size_t need = c->bs_len + n + (has_sc ? 0 : 3);
+      if (need > c->bs_cap) {
+         size_t cap = c->bs_cap ? c->bs_cap : 1 << 16;
+         while (cap < need)
+            cap *= 2;
+         uint8_t *nb = realloc(c->bs, cap);
+         if (!nb)
+            return -1;
+         c->bs = nb;
+         c->bs_cap = cap;
+      }
+      if (!has_sc) {
+         memcpy(c->bs + c->bs_len, "\0\0\1", 3);
+         c->bs_len += 3;
+      }
+      memcpy(c->bs + c->bs_len, p, n);
+      c->bs_len += n;
+   }
+   return 0;
+}
+
+int virgl_video_encode_bitstream(struct virgl_video_codec *c, struct virgl_video_buffer *source,
+                                 const union virgl_picture_desc *desc)
+{
+   (void)c;
+   (void)source;
+   (void)desc;
+   return -1; /* encode is not offered in the caps yet */
+}
+
+int virgl_video_end_frame(struct virgl_video_codec *c, struct virgl_video_buffer *target)
+{
+   if (!c || !target)
+      return -1;
+   @autoreleasepool {
+      return h264_decode_frame(c, target);
+   }
+}
