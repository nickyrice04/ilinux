+
+/* VideoToolbox decode: copy one plane of the decoded IOSurface into a guest
+ * video-buffer plane resource (R8/RG8 for NV12, R16/RG16 for P010). */
+int vrend_renderer_copy_iosurface_plane(struct vrend_context *ctx,
+                                        struct vrend_resource *res,
+                                        void *iosurface, unsigned plane,
+                                        GLuint *rect_tex)
+{
+   GLenum internal, format, type;
+   uint32_t w, h;
+
+   switch (res->base.format) {
+   case VIRGL_FORMAT_R8_UNORM:   internal = GL_R8;   format = GL_RED; type = GL_UNSIGNED_BYTE;  break;
+   case VIRGL_FORMAT_R8G8_UNORM: internal = GL_RG8;  format = GL_RG;  type = GL_UNSIGNED_BYTE;  break;
+   case VIRGL_FORMAT_R16_UNORM:  internal = GL_R16;  format = GL_RED; type = GL_UNSIGNED_SHORT; break;
+   case VIRGL_FORMAT_R16G16_UNORM: internal = GL_RG16; format = GL_RG; type = GL_UNSIGNED_SHORT; break;
+   default:
+      virgl_warn("%s: unexpected plane format %d\n", __func__, res->base.format);
+      return -1;
+   }
+
+   if (!*rect_tex)
+      glGenTextures(1, rect_tex);
+   glBindTexture(GL_TEXTURE_RECTANGLE, *rect_tex);
+   const bool bound = virgl_metal_bind_iosurface_plane(GL_TEXTURE_RECTANGLE, internal, format,
+                                                       type, iosurface, plane, &w, &h);
+   glBindTexture(GL_TEXTURE_RECTANGLE, 0);
+   if (!bound)
+      return -1;
+
+   vrend_blit_rect_texture_to_res(ctx->sub, *rect_tex, res,
+                                  MIN2(w, res->base.width0), MIN2(h, res->base.height0));
+
+   if (vrend_video_debug()) {
+      /* debug: read back the destination and the source at the centre */
+      uint8_t dst_px[8] = { 0 }, src_px[8] = { 0 };
+      glBindFramebuffer(GL_READ_FRAMEBUFFER, ctx->sub->blit_fb_ids[0]);
+      glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, res->target, res->gl_id, 0);
+      glReadBuffer(GL_COLOR_ATTACHMENT0);
+      const GLenum st = glCheckFramebufferStatus(GL_READ_FRAMEBUFFER);
+      glReadPixels(res->base.width0 / 2, res->base.height0 / 2, 4, 1, format, GL_UNSIGNED_BYTE, dst_px);
+      glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_RECTANGLE, *rect_tex, 0);
+      glReadPixels(w / 2, h / 2, 4, 1, format, GL_UNSIGNED_BYTE, src_px);
+      glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_RECTANGLE, 0, 0);
+      glBindFramebuffer(GL_FRAMEBUFFER, ctx->sub->fb_id);
+      virgl_info("vrend_video: plane %u gl_id %u fbo 0x%x dst %02x %02x %02x %02x src %02x %02x %02x %02x glerr 0x%x\n",
+                 plane, res->gl_id, st, dst_px[0], dst_px[1], dst_px[2], dst_px[3],
+                 src_px[0], src_px[1], src_px[2], src_px[3], glGetError());
+   }
+
+   /* The guest driver cannot know the host wrote this plane, so a guest map
+    * (vaDeriveImage, hwdownload) of a resource whose guest backing holds the
+    * whole plane reads that backing without a readback: refresh it too
+    * (tightly packed rows, as Mesa lays out non-winsys textures).  Mesa's
+    * staging-backed plane resources only have a token backing; skipping them
+    * avoids a CPU lock of the IOSurface on every frame. */
+   if (res->iov && res->num_iovs) {
+      const uint32_t bpp = (internal == GL_R8) ? 1 : (internal == GL_RG16) ? 4 : 2;
+      const uint32_t row = res->base.width0 * bpp;
+      size_t backing = 0;
+      for (uint32_t i = 0; i < res->num_iovs; i++)
+         backing += res->iov[i].iov_len;
+      if (vrend_video_debug())
+         virgl_info("vrend_video: plane %u backing %zu bytes in %u iovs, layout %ux%u x%u = %zu\n",
+                    plane, backing, res->num_iovs, res->base.width0, res->base.height0, bpp,
+                    (size_t)row * res->base.height0);
+      if (backing < (size_t)row * res->base.height0)
+         return 0;
+      uint32_t src_bpr, src_h;
+      const uint8_t *src = virgl_metal_lock_iosurface_plane(iosurface, plane, &src_bpr, &src_h);
+      if (src) {
+         const uint32_t rows = MIN2(src_h, res->base.height0);
+         const uint32_t n = MIN2(row, src_bpr);
+         /* never write past the guest backing (vrend_write_to_iovec asserts) */
+         for (uint32_t y = 0; y < rows && (size_t)y * row + n <= backing; y++)
+            vrend_write_to_iovec(res->iov, res->num_iovs, (size_t)y * row,
+                                 (const char *)src + (size_t)y * src_bpr, n);
+         virgl_metal_unlock_iosurface(iosurface);
+      }
+   }
+   return 0;
+}
 #endif
+
+/* Copy the latest Venus image (via its IOSurface mirror) into res->gl_id.
+ * Runs at most once per command batch per resource; restores the
+ * framebuffer, scissor and sRGB state it touches. */
+static void vrend_metal_mirror_refresh(UNUSED struct vrend_sub_context *sub_ctx,
+                                       UNUSED struct vrend_resource *res)
+{
+#ifdef ENABLE_METAL
+   if (!res->metal_mirror || res->metal_mirror_batch == vrend_state.cmd_batch)
+      return;
+   res->metal_mirror_batch = vrend_state.cmd_batch;
+
+   /* the previous GL copy must be done reading before Metal rewrites */
+   if (res->metal_mirror_sync) {
+      glClientWaitSync(res->metal_mirror_sync, GL_SYNC_FLUSH_COMMANDS_BIT, 1000000000ull);
+      glDeleteSync(res->metal_mirror_sync);
+      res->metal_mirror_sync = NULL;
+   }
+   if (!virgl_metal_iosurface_mirror_update(res->metal_mirror))
+      return;
+
+   vrend_blit_rect_texture_to_res(sub_ctx, res->metal_mirror_tex, res,
+                                  res->base.width0, res->base.height0);
+   res->metal_mirror_sync = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+#endif
 }
 
