+/* Copy the latest Venus image (via its IOSurface mirror) into res->gl_id.
+ * Runs at most once per command batch per resource; restores the
+ * framebuffer, scissor and sRGB state it touches. */
+static void vrend_metal_mirror_refresh(UNUSED struct vrend_sub_context *sub_ctx,
+                                       UNUSED struct vrend_resource *res)
+{
+#ifdef ENABLE_METAL
+   if (!res->metal_mirror || res->metal_mirror_batch == vrend_state.cmd_batch)
+      return;
+   res->metal_mirror_batch = vrend_state.cmd_batch;
+
+   /* the previous GL copy must be done reading before Metal rewrites */
+   if (res->metal_mirror_sync) {
+      glClientWaitSync(res->metal_mirror_sync, GL_SYNC_FLUSH_COMMANDS_BIT, 1000000000ull);
+      glDeleteSync(res->metal_mirror_sync);
+      res->metal_mirror_sync = NULL;
+   }
+   if (!virgl_metal_iosurface_mirror_update(res->metal_mirror))
+      return;
+
+   const GLboolean scissor = glIsEnabled(GL_SCISSOR_TEST);
+   const GLboolean srgb = has_feature(feat_srgb_write_control) &&
+                          glIsEnabled(GL_FRAMEBUFFER_SRGB_EXT);
+   const GLint w = res->base.width0, h = res->base.height0;
+
+   if (scissor)
+      glDisable(GL_SCISSOR_TEST);
+   if (srgb)
+      glDisable(GL_FRAMEBUFFER_SRGB_EXT);
+
+   glBindFramebuffer(GL_READ_FRAMEBUFFER, sub_ctx->blit_fb_ids[0]);
+   glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                          GL_TEXTURE_RECTANGLE, res->metal_mirror_tex, 0);
+   glReadBuffer(GL_COLOR_ATTACHMENT0);
+   glBindFramebuffer(GL_DRAW_FRAMEBUFFER, sub_ctx->blit_fb_ids[1]);
+   glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                          res->target, res->gl_id, 0);
+   glDrawBuffer(GL_COLOR_ATTACHMENT0);
+
+   glBlitFramebuffer(0, 0, w, h, 0, 0, w, h, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+
+   glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, res->target, 0, 0);
+   glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_RECTANGLE, 0, 0);
+   res->metal_mirror_sync = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+
+   glBindFramebuffer(GL_FRAMEBUFFER, sub_ctx->fb_id);
+   if (scissor)
+      glEnable(GL_SCISSOR_TEST);
+   if (srgb)
+      glEnable(GL_FRAMEBUFFER_SRGB_EXT);
+#endif
+}
+
+static void vrend_metal_mirror_refresh_views(UNUSED struct vrend_sub_context *sub_ctx)
+{
+#ifdef ENABLE_METAL
+   if (!vrend_state.metal_mirror_count)
+      return;
+
+   for (int type = 0; type < PIPE_SHADER_TYPES; type++) {
+      const struct vrend_shader_view *sv = &sub_ctx->views[type];
+      for (int i = 0; i < sv->max_num_views; i++) {
+         struct vrend_sampler_view *view = sv->views[i];
+         if (view && view->texture && view->texture->metal_mirror)
+            vrend_metal_mirror_refresh(sub_ctx, view->texture);
+      }
    }
+#endif
 }
 
