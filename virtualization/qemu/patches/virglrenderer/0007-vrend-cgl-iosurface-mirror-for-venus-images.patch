+
+struct virgl_metal_iosurface_mirror *
+virgl_metal_iosurface_mirror_create(MTLHeap_id heap,
+                                    const struct vrend_metal_texture_description *desc);
+
+/* Attaches the mirror's IOSurface to the texture bound to `target`
+ * (GL_TEXTURE_RECTANGLE) in the current CGL context. */
+bool virgl_metal_iosurface_mirror_bind_gl(struct virgl_metal_iosurface_mirror *mirror,
+                                          uint32_t target);
+
+/* Copies the heap contents into the IOSurface; returns once the GPU is done. */
+bool virgl_metal_iosurface_mirror_update(struct virgl_metal_iosurface_mirror *mirror);
+
+void virgl_metal_iosurface_mirror_destroy(struct virgl_metal_iosurface_mirror *mirror);
