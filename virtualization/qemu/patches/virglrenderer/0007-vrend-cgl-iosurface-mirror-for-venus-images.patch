+
+/* ---- IOSurface mirror of a Venus METAL_HEAP image (native CGL hosts) ---- */
+
+#define MIRROR_FOURCC(a, b, c, d) \
+   (((uint32_t)(a) << 24) | ((uint32_t)(b) << 16) | ((uint32_t)(c) << 8) | (uint32_t)(d))
+
+struct mirror_format {
+   uint32_t virgl_format;
+   MTLPixelFormat src;      /* layout of the linear image in the heap */
+   MTLPixelFormat dst;      /* IOSurface-backed texture */
+   uint32_t fourcc;         /* IOSurface pixel format CGL accepts */
+   uint32_t bpe;
+   GLenum gl_internal, gl_format, gl_type;
+};
+
+#define MIRROR_BGRA8(f, src) \
+   { f, src, MTLPixelFormatBGRA8Unorm, MIRROR_FOURCC('B', 'G', 'R', 'A'), 4, \
+     GL_RGBA8, GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV }
+#define MIRROR_BGR10A2(f, src) \
+   { f, src, MTLPixelFormatBGR10A2Unorm, MIRROR_FOURCC('l', '1', '0', 'r'), 4, \
+     GL_RGB10_A2, GL_BGRA, GL_UNSIGNED_INT_2_10_10_10_REV }
+
+/* CGL rejects RGBA-ordered IOSurfaces, so RGBA images are swizzled into
+ * BGRA surfaces by a compute pass (src != dst); sRGB images are copied raw
+ * and the GL blit runs with GL_FRAMEBUFFER_SRGB off. */
+static const struct mirror_format mirror_formats[] = {
+   MIRROR_BGRA8(VIRGL_FORMAT_B8G8R8A8_UNORM, MTLPixelFormatBGRA8Unorm),
+   MIRROR_BGRA8(VIRGL_FORMAT_B8G8R8X8_UNORM, MTLPixelFormatBGRA8Unorm),
+   MIRROR_BGRA8(VIRGL_FORMAT_B8G8R8A8_SRGB, MTLPixelFormatBGRA8Unorm),
+   MIRROR_BGRA8(VIRGL_FORMAT_B8G8R8X8_SRGB, MTLPixelFormatBGRA8Unorm),
+   MIRROR_BGRA8(VIRGL_FORMAT_R8G8B8A8_UNORM, MTLPixelFormatRGBA8Unorm),
+   MIRROR_BGRA8(VIRGL_FORMAT_R8G8B8X8_UNORM, MTLPixelFormatRGBA8Unorm),
+   MIRROR_BGRA8(VIRGL_FORMAT_R8G8B8A8_SRGB, MTLPixelFormatRGBA8Unorm),
+   MIRROR_BGRA8(VIRGL_FORMAT_R8G8B8X8_SRGB, MTLPixelFormatRGBA8Unorm),
+   MIRROR_BGR10A2(VIRGL_FORMAT_B10G10R10A2_UNORM, MTLPixelFormatBGR10A2Unorm),
+   MIRROR_BGR10A2(VIRGL_FORMAT_B10G10R10X2_UNORM, MTLPixelFormatBGR10A2Unorm),
+   MIRROR_BGR10A2(VIRGL_FORMAT_R10G10B10A2_UNORM, MTLPixelFormatRGB10A2Unorm),
+   MIRROR_BGR10A2(VIRGL_FORMAT_R10G10B10X2_UNORM, MTLPixelFormatRGB10A2Unorm),
+   { VIRGL_FORMAT_R16G16B16A16_FLOAT, MTLPixelFormatRGBA16Float, MTLPixelFormatRGBA16Float,
+     MIRROR_FOURCC('R', 'G', 'h', 'A'), 8, GL_RGBA16F, GL_RGBA, GL_HALF_FLOAT },
+   { VIRGL_FORMAT_R16G16B16X16_FLOAT, MTLPixelFormatRGBA16Float, MTLPixelFormatRGBA16Float,
+     MIRROR_FOURCC('R', 'G', 'h', 'A'), 8, GL_RGBA16F, GL_RGBA, GL_HALF_FLOAT },
+   { VIRGL_FORMAT_R8_UNORM, MTLPixelFormatR8Unorm, MTLPixelFormatR8Unorm,
+     MIRROR_FOURCC('L', '0', '0', '8'), 1, GL_R8, GL_RED, GL_UNSIGNED_BYTE },
+   { VIRGL_FORMAT_R8G8_UNORM, MTLPixelFormatRG8Unorm, MTLPixelFormatRG8Unorm,
+     MIRROR_FOURCC('2', 'C', '0', '8'), 2, GL_RG8, GL_RG, GL_UNSIGNED_BYTE },
+};
+
+struct virgl_metal_iosurface_mirror {
+   const struct mirror_format *fmt;
+   id<MTLBuffer> src_buf;     /* aliases the Venus heap from offset 0 */
+   id<MTLTexture> src_tex;    /* linear view of src_buf, swizzle path only */
+   id<MTLTexture> dst_tex;    /* backed by surface */
+   IOSurfaceRef surface;
+   NSUInteger offset, stride, width, height;
+};
+
+static id<MTLDevice> mirror_device;
+static id<MTLCommandQueue> mirror_queue;
+static id<MTLComputePipelineState> mirror_swizzle;
+
+static struct {
+   bool enabled;
+   uint64_t count, ns;
+} mirror_stats;
+
+static bool mirror_init(id<MTLDevice> device, bool need_swizzle)
+{
+   if (mirror_device && mirror_device != device)
+      return false;
+
+   if (!mirror_queue) {
+      mirror_queue = [device newCommandQueue];
+      if (!mirror_queue)
+         return false;
+      mirror_device = [device retain];
+      mirror_stats.enabled = !!getenv("VIRGL_IOSURFACE_MIRROR_STATS");
+   }
+
+   if (need_swizzle && !mirror_swizzle) {
+      static NSString *const source =
+         @"#include <metal_stdlib>\n"
+          "using namespace metal;\n"
+          "kernel void mirror_copy(texture2d<float, access::read> src [[texture(0)]],\n"
+          "                        texture2d<float, access::write> dst [[texture(1)]],\n"
+          "                        uint2 gid [[thread_position_in_grid]])\n"
+          "{\n"
+          "   if (gid.x < dst.get_width() && gid.y < dst.get_height())\n"
+          "      dst.write(src.read(gid), gid);\n"
+          "}\n";
+      NSError *error = nil;
+      id<MTLLibrary> library = [device newLibraryWithSource:source options:nil error:&error];
+      id<MTLFunction> function = [library newFunctionWithName:@"mirror_copy"];
+      if (function)
+         mirror_swizzle = [device newComputePipelineStateWithFunction:function error:&error];
+      [function release];
+      [library release];
+      if (!mirror_swizzle) {
+         virgl_error("%s: swizzle pipeline: %s\n", __func__,
+                     error ? error.localizedDescription.UTF8String : "unknown error");
+         return false;
+      }
+   }
+
+   return true;
+}
+
+struct virgl_metal_iosurface_mirror *
+virgl_metal_iosurface_mirror_create(MTLHeap_id heap,
+                                    const struct vrend_metal_texture_description *desc)
+{
+   @autoreleasepool {
+      id<MTLHeap> mtl_heap = (id<MTLHeap>)heap;
+      const struct mirror_format *fmt = NULL;
+
+      for (uint32_t i = 0; i < ARRAY_SIZE(mirror_formats); i++) {
+         if (mirror_formats[i].virgl_format == desc->format)
+            fmt = &mirror_formats[i];
+      }
+      if (!fmt) {
+         virgl_error("%s: unsupported format %u\n", __func__, desc->format);
+         return NULL;
+      }
+
+      const NSUInteger len = (NSUInteger)desc->offset + (NSUInteger)desc->stride * desc->height;
+      if (!mtl_heap || mtl_heap.type != MTLHeapTypePlacement || !desc->width || !desc->height ||
+          desc->stride < desc->width * fmt->bpe || desc->offset % fmt->bpe ||
+          desc->stride % fmt->bpe || len > mtl_heap.size) {
+         virgl_error("%s: unusable heap/layout (%ux%u stride %u offset %u)\n", __func__,
+                     desc->width, desc->height, desc->stride, desc->offset);
+         return NULL;
+      }
+
+      id<MTLDevice> device = mtl_heap.device;
+      const bool swizzle = fmt->src != fmt->dst;
+      if (!mirror_init(device, swizzle))
+         return NULL;
+
+      struct virgl_metal_iosurface_mirror *m = calloc(1, sizeof(*m));
+      if (!m)
+         return NULL;
+      m->fmt = fmt;
+      m->offset = desc->offset;
+      m->stride = desc->stride;
+      m->width = desc->width;
+      m->height = desc->height;
+
+      m->src_buf = [mtl_heap newBufferWithLength:len options:mtl_heap.resourceOptions offset:0];
+      if (!m->src_buf)
+         goto fail;
+
+      NSDictionary *props = @{
+         (id)kIOSurfaceWidth: @(desc->width),
+         (id)kIOSurfaceHeight: @(desc->height),
+         (id)kIOSurfaceBytesPerElement: @(fmt->bpe),
+         (id)kIOSurfacePixelFormat: @(fmt->fourcc),
+      };
+      m->surface = IOSurfaceCreate((CFDictionaryRef)props);
+      if (!m->surface)
+         goto fail;
+
+      MTLTextureDescriptor *dst_desc =
+         [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:fmt->dst
+                                                            width:desc->width
+                                                           height:desc->height
+                                                        mipmapped:NO];
+      dst_desc.usage = MTLTextureUsageShaderRead | (swizzle ? MTLTextureUsageShaderWrite : 0);
+      dst_desc.storageMode = MTLStorageModeShared;
+      m->dst_tex = [device newTextureWithDescriptor:dst_desc iosurface:m->surface plane:0];
+      if (!m->dst_tex)
+         goto fail;
+
+      if (swizzle) {
+         const NSUInteger align = [device minimumLinearTextureAlignmentForPixelFormat:fmt->src];
+         if (desc->stride % align || desc->offset % align) {
+            virgl_error("%s: stride %u / offset %u not %lu-aligned for a linear view\n",
+                        __func__, desc->stride, desc->offset, (unsigned long)align);
+            goto fail;
+         }
+         MTLTextureDescriptor *src_desc =
+            [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:fmt->src
+                                                               width:desc->width
+                                                              height:desc->height
+                                                           mipmapped:NO];
+         src_desc.usage = MTLTextureUsageShaderRead;
+         src_desc.resourceOptions = mtl_heap.resourceOptions;
+         m->src_tex = [m->src_buf newTextureWithDescriptor:src_desc
+                                                    offset:desc->offset
+                                               bytesPerRow:desc->stride];
+         if (!m->src_tex)
+            goto fail;
+      }
+
+      return m;
+
+   fail:
+      virgl_error("%s: failed to set up the IOSurface mirror\n", __func__);
+      virgl_metal_iosurface_mirror_destroy(m);
+      return NULL;
+   }
 }
+
+bool virgl_metal_iosurface_mirror_bind_gl(struct virgl_metal_iosurface_mirror *m,
+                                          uint32_t target)
+{
+   CGLContextObj ctx = CGLGetCurrentContext();
+   if (!ctx)
+      return false;
+
+   CGLError err = CGLTexImageIOSurface2D(ctx, target, m->fmt->gl_internal,
+                                         (GLsizei)m->width, (GLsizei)m->height,
+                                         m->fmt->gl_format, m->fmt->gl_type, m->surface, 0);
+   if (err != kCGLNoError) {
+      virgl_error("%s: CGLTexImageIOSurface2D: %s\n", __func__, CGLErrorString(err));
+      return false;
+   }
+   return true;
+}
+
+bool virgl_metal_iosurface_mirror_update(struct virgl_metal_iosurface_mirror *m)
+{
+   @autoreleasepool {
+      struct timespec t0, t1;
+      if (mirror_stats.enabled)
+         clock_gettime(CLOCK_MONOTONIC, &t0);
+
+      id<MTLCommandBuffer> cmd = [mirror_queue commandBuffer];
+      if (m->src_tex) {
+         id<MTLComputeCommandEncoder> enc = [cmd computeCommandEncoder];
+         const NSUInteger w = mirror_swizzle.threadExecutionWidth;
+         const NSUInteger t = mirror_swizzle.maxTotalThreadsPerThreadgroup / w;
+         const NSUInteger h = t ? t : 1;
+         [enc setComputePipelineState:mirror_swizzle];
+         [enc setTexture:m->src_tex atIndex:0];
+         [enc setTexture:m->dst_tex atIndex:1];
+         [enc dispatchThreads:MTLSizeMake(m->width, m->height, 1)
+            threadsPerThreadgroup:MTLSizeMake(w, h, 1)];
+         [enc endEncoding];
+      } else {
+         id<MTLBlitCommandEncoder> blit = [cmd blitCommandEncoder];
+         [blit copyFromBuffer:m->src_buf
+                 sourceOffset:m->offset
+            sourceBytesPerRow:m->stride
+          sourceBytesPerImage:m->stride * m->height
+                   sourceSize:MTLSizeMake(m->width, m->height, 1)
+                    toTexture:m->dst_tex
+             destinationSlice:0
+             destinationLevel:0
+            destinationOrigin:MTLOriginMake(0, 0, 0)];
+         [blit endEncoding];
+      }
+      [cmd commit];
+      /* GL reads the IOSurface next.  There is no Metal/GL fence on macOS,
+       * but the driver orders IOSurface access by submission: once this
+       * command buffer is scheduled, GL work submitted afterwards observes
+       * its writes (0 stale reads in 300 frames with 0.5-60 ms Metal passes;
+       * with commit alone, GL could overtake it).  Waiting for scheduling
+       * costs ~0.2 ms instead of ~0.9 ms for completion. */
+      [cmd waitUntilScheduled];
+
+      if (mirror_stats.enabled) {
+         clock_gettime(CLOCK_MONOTONIC, &t1);
+         mirror_stats.ns += (uint64_t)(t1.tv_sec - t0.tv_sec) * 1000000000ull +
+                            (uint64_t)t1.tv_nsec - (uint64_t)t0.tv_nsec;
+         if (++mirror_stats.count % 600 == 0)
+            virgl_info("iosurface mirror: %llu updates, %.1f us average (%lux%lu)\n",
+                       (unsigned long long)mirror_stats.count,
+                       mirror_stats.ns / 1000.0 / mirror_stats.count,
+                       (unsigned long)m->width, (unsigned long)m->height);
+      }
+      return cmd.status != MTLCommandBufferStatusError;
+   }
+}
+
+void virgl_metal_iosurface_mirror_destroy(struct virgl_metal_iosurface_mirror *m)
+{
+   if (!m)
+      return;
+   [m->src_tex release];
+   [m->dst_tex release];
+   [m->src_buf release];
+   if (m->surface)
+      CFRelease(m->surface);
+   free(m);
+}
