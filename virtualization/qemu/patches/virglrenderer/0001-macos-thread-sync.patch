From: iLinux workspace
Subject: [PATCH] macOS: FIFO-backed eventfd; keep fences retiring if the sync thread fails

macOS has no eventfd, so THREAD_SYNC was silently dropped and fences were
only retired by QEMU's 1 ms poll timer.  Emulate eventfd with an anonymous
FIFO opened O_RDWR: one descriptor for both ends, which also survives being
passed over a socket (Venus sends its fence eventfd to the render server).
If the sync thread cannot start, fall back to main-thread fence retirement
instead of leaving use_async_fence_cb set with nobody retiring fences.

diff -ru a/src/virgl_util.c b/src/virgl_util.c
--- a/src/virgl_util.c	2026-10-12 01:35:15
+++ b/src/virgl_util.c	2026-10-12 12:01:30
@@ -86,9 +86,25 @@
    return key1 == key2;
 }
 
+#if !defined(HAVE_EVENTFD_H) && defined(__APPLE__)
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/stat.h>
+/*
+ * macOS has no eventfd: emulate one with an anonymous FIFO opened O_RDWR.
+ * The single descriptor is both readable and writable, polls readable while
+ * signalled, and keeps working when it is dup()ed or passed over a socket
+ * (Venus hands its fence eventfd to the render server that way; a pipe
+ * pair looked up by descriptor number lost those signals).  A full FIFO
+ * already means "signalled", so a write that would block counts as success.
+ */
+#define EVENTFD_EMULATED 1
+#endif
+
 bool has_eventfd(void)
 {
-#ifdef HAVE_EVENTFD_H
+#if defined(HAVE_EVENTFD_H) || defined(EVENTFD_EMULATED)
    return true;
 #else
    return false;
@@ -99,6 +115,24 @@
 {
 #ifdef HAVE_EVENTFD_H
    return eventfd(initval, EFD_CLOEXEC | EFD_NONBLOCK);
+#elif defined(EVENTFD_EMULATED)
+   const char *dir = getenv("TMPDIR");
+   char path[1024];
+   int fd = -1;
+
+   for (int attempt = 0; attempt < 16 && fd < 0; attempt++) {
+      snprintf(path, sizeof(path), "%s/virgl-eventfd-%d-%08x",
+               dir && *dir ? dir : "/tmp", (int)getpid(), arc4random());
+      if (mkfifo(path, 0600) == 0) {
+         fd = open(path, O_RDWR | O_NONBLOCK | O_CLOEXEC);
+         unlink(path);
+      } else if (errno != EEXIST) {
+         return -1;
+      }
+   }
+   if (fd >= 0 && initval)
+      write_eventfd(fd, initval);
+   return fd;
 #else
    (void)initval;
    return -1;
@@ -111,11 +145,16 @@
    size_t count = sizeof(val);
    ssize_t ret = 0;
 
+
    while (count) {
       ret = write(fd, buf, count);
       if (ret < 0) {
          if (errno == EINTR)
             continue;
+#ifdef EVENTFD_EMULATED
+         if (errno == EAGAIN)    /* FIFO full: already signalled */
+            return 0;
+#endif
          break;
       }
       count -= ret;
diff -ru a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
--- a/src/vrend/vrend_renderer.c	2026-10-12 01:35:15
+++ b/src/vrend/vrend_renderer.c	2026-10-12 12:01:30
@@ -7520,6 +7520,8 @@
    vrend_state.sync_context = vrend_clicbs->create_gl_context_surfaceless(0, &ctx_params);
    if (vrend_state.sync_context == NULL) {
       virgl_error("Failed to create sync opengl context\n");
+      /* Without the sync thread, fences must retire on the main thread. */
+      vrend_state.use_async_fence_cb = false;
       return;
    }
 
@@ -7528,6 +7530,7 @@
       if (vrend_state.eventfd == -1) {
          virgl_error("Failed to create eventfd\n");
          vrend_clicbs->destroy_gl_context_surfaceless(vrend_state.sync_context);
+         vrend_state.use_async_fence_cb = false;
          return;
       }
    }
@@ -7542,6 +7545,7 @@
 
    vrend_state.sync_thread = u_thread_create(thread_sync, NULL);
    if (!vrend_state.sync_thread) {
+      vrend_state.use_async_fence_cb = false;
       close(vrend_state.eventfd);
       vrend_state.eventfd = -1;
       vrend_clicbs->destroy_gl_context_surfaceless(vrend_state.sync_context);
