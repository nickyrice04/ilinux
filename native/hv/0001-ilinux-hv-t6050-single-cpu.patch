+    hv_ilinux_single_cpu = chip_id == T6050;
+    hv_ilinux_init_failed = false;
+    if (hv_ilinux_single_cpu) {
+        u64 ena = mrs(SYS_IMP_APL_VM_TMR_FIQ_ENA_EL2);
+        printf("HV: iLinux single-CPU mode; VM_TMR_FIQ_ENA=0x%lx\n", ena);
+        if (ena & (VM_TMR_FIQ_ENA_ENA_V | VM_TMR_FIQ_ENA_ENA_P)) {
+            printf("HV: guest timer FIQs already enabled; refusing to start\n");
+            hv_ilinux_init_failed = true;
+        }
+    } else {
+        smp_start_secondaries();
+    }
     smp_set_wfe_mode(true);
     hv_wdt_init();
 
