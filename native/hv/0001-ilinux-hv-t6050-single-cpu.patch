diff --git a/src/hv/hv_exc.c b/src/hv/hv_exc.c
index 3a399eb..87036d2 100644
--- a/src/hv/hv_exc.c
+++ b/src/hv/hv_exc.c
@@ -154,6 +154,13 @@ static void hv_update_fiq(void)
     u64 hcr = mrs(HCR_EL2);
     bool fiq_pending = false;
 
+    if (hv_ilinux_single_cpu) {
+        /* iLinux private: level-evaluate guest timers on every exit/tick. */
+        fiq_pending = mrs(CNTP_CTL_EL02) == (CNTx_CTL_ISTATUS | CNTx_CTL_ENABLE) ||
+                      mrs(CNTV_CTL_EL02) == (CNTx_CTL_ISTATUS | CNTx_CTL_ENABLE);
+        goto ilinux_timers_done;
+    }
+
     if (mrs(CNTP_CTL_EL02) == (CNTx_CTL_ISTATUS | CNTx_CTL_ENABLE)) {
         fiq_pending = true;
         reg_clr(SYS_IMP_APL_VM_TMR_FIQ_ENA_EL2, VM_TMR_FIQ_ENA_ENA_P);
@@ -168,6 +175,7 @@ static void hv_update_fiq(void)
         reg_set(SYS_IMP_APL_VM_TMR_FIQ_ENA_EL2, VM_TMR_FIQ_ENA_ENA_V);
     }
 
+ilinux_timers_done:
     fiq_pending |= PERCPU(ipi_pending) || PERCPU(pmc_pending);
 
     sysop("isb");
diff --git a/src/kboot.c b/src/kboot.c
