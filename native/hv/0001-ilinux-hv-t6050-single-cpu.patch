@@ -2932,6 +2932,16 @@ int kboot_prepare_dt(void *fdt)
     return 0;
 }
 
+/* iLinux private: kboot_boot's hardware steps for an EL1 guest under the HV. */
+int kboot_prepare_hv_guest(void)
+{
+    mcc_enable_cache();
+    tunables_apply_static();
+    clk_init();
+    dapf_init_all();
+    return 0;
+}
+
 int kboot_boot(void *kernel)
 {
     mcc_enable_cache();
