+/*
+ * iLinux private (not for upstream): on t6050 the firmware leaves
+ * VM_TMR_FIQ_ENA_EL2 enabled and writes to it trap at EL2, so a firing guest
+ * timer raises a physical FIQ the HV cannot gate. Mask the timer at its source
+ * (CNTx_CTL_EL02.IMASK) instead, deliver a virtual FIQ, and hide that mask from
+ * the guest through the ECV timer traps (hv_init refuses to start without ECV).
+ */
+#define ILINUX_TMR_V       BIT(0)
+#define ILINUX_TMR_P       BIT(1)
+#define ILINUX_TMR_EXPIRED (CNTx_CTL_ISTATUS | CNTx_CTL_ENABLE)
+
+static u8 hv_ilinux_tmr_masked[MAX_CPUS];
+
+#define ILINUX_TIMER_UPDATE(ctl_reg, bit)                                                          \
+    do {                                                                                           \
+        u64 ctl = _mrs(sr_tkn(ctl_reg));                                                                    \
+        bool expired = (ctl & ILINUX_TMR_EXPIRED) == ILINUX_TMR_EXPIRED;                           \
+        if (expired && !(ctl & CNTx_CTL_IMASK)) {                                                  \
+            _msr(sr_tkn(ctl_reg), ctl | CNTx_CTL_IMASK);                                                    \
+            *masked |= (bit);                                                                      \
+        } else if (!expired && (*masked & (bit))) {                                                \
+            _msr(sr_tkn(ctl_reg), ctl & ~CNTx_CTL_IMASK);                                                   \
+            *masked &= ~(bit);                                                                     \
+        }                                                                                          \
+        if (expired && (*masked & (bit)))                                                          \
+            pending = true;                                                                        \
+    } while (0)
+
+static bool hv_ilinux_update_timers(void)
+{
+    u8 *masked = &hv_ilinux_tmr_masked[smp_id()];
+    bool pending = false;
+
+    ILINUX_TIMER_UPDATE(SYS_CNTV_CTL_EL02, ILINUX_TMR_V);
+    ILINUX_TIMER_UPDATE(SYS_CNTP_CTL_EL02, ILINUX_TMR_P);
+    return pending;
+}
+
+/* Guest CTL reads see the guest's own IMASK; any guest write ends the HV mask. */
+#define ILINUX_TIMER_CTL(el0, el02, bit)                                                           \
+    case SYSREG_ISS(el0):                                                                          \
+        if (is_read) {                                                                             \
+            u64 ctl = _mrs(sr_tkn(el02));                                                                   \
+            *val = (*masked & (bit)) ? (ctl & ~CNTx_CTL_IMASK) : ctl;                              \
+        } else {                                                                                   \
+            *masked &= ~(bit);                                                                     \
+            _msr(sr_tkn(el02), *val);                                                                       \
+        }                                                                                          \
+        return true;
+
+#define ILINUX_TIMER_VAL(el0, el02, ctl02, bit)                                                    \
+    case SYSREG_ISS(el0):                                                                          \
+        if (is_read) {                                                                             \
+            *val = _mrs(sr_tkn(el02));                                                                      \
+        } else {                                                                                   \
+            _msr(sr_tkn(el02), *val);                                                                       \
+            if (*masked & (bit)) {                                                                 \
+                *masked &= ~(bit);                                                                 \
+                _msr(sr_tkn(ctl02), _mrs(sr_tkn(ctl02)) & ~CNTx_CTL_IMASK);                                                    \
+            }                                                                                      \
+        }                                                                                          \
+        return true;
+
+static bool hv_ilinux_timer_access(u64 reg, bool is_read, u64 *val)
+{
+    u8 *masked = &hv_ilinux_tmr_masked[smp_id()];
+
+    switch (reg) {
+        ILINUX_TIMER_CTL(SYS_CNTV_CTL_EL0, SYS_CNTV_CTL_EL02, ILINUX_TMR_V)
+        ILINUX_TIMER_VAL(SYS_CNTV_CVAL_EL0, SYS_CNTV_CVAL_EL02, SYS_CNTV_CTL_EL02, ILINUX_TMR_V)
+        ILINUX_TIMER_VAL(SYS_CNTV_TVAL_EL0, SYS_CNTV_TVAL_EL02, SYS_CNTV_CTL_EL02, ILINUX_TMR_V)
+        ILINUX_TIMER_CTL(SYS_CNTP_CTL_EL0, SYS_CNTP_CTL_EL02, ILINUX_TMR_P)
+        ILINUX_TIMER_VAL(SYS_CNTP_CVAL_EL0, SYS_CNTP_CVAL_EL02, SYS_CNTP_CTL_EL02, ILINUX_TMR_P)
+        ILINUX_TIMER_VAL(SYS_CNTP_TVAL_EL0, SYS_CNTP_TVAL_EL02, SYS_CNTP_CTL_EL02, ILINUX_TMR_P)
+    }
+    return false;
+}
+
+/* The guest timers are left expired at handoff: start the guest with them off. */
+void hv_ilinux_timers_reset(void)
+{
+    msr(SYS_CNTV_CTL_EL02, 0);
+    msr(SYS_CNTP_CTL_EL02, 0);
+    memset(hv_ilinux_tmr_masked, 0, sizeof(hv_ilinux_tmr_masked));
+}
+
 static void hv_update_fiq(void)
 {
