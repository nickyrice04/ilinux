     sysop("isb");
@@ -213,6 +306,9 @@ static bool hv_handle_msr_unlocked(struct exc_info *ctx, u64 iss)
         hv_sprr_traps_tlbi())
         return false;
 
+    if (hv_ilinux_single_cpu && hv_ilinux_timer_access(reg, is_read, &regs[rt]))
+        return true;
+
     switch (reg) {
         SYSREG_PASS(SYS_TPIDR2_EL0)
         SYSREG_PASS(SYS_IMP_APL_CORE_NRG_ACC_DAT);
