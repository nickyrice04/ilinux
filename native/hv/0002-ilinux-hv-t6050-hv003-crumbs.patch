     boot_args_addr = (u64)boot_args;
     memcpy(&cur_boot_args, boot_args, sizeof(cur_boot_args));
@@ -185,6 +322,7 @@ void _start_c(void *boot_args, void *base)
         }
     }
 #endif
+    ilinux_crumb_step(1);
 
     if (in_el2())
         msr(TPIDR_EL2, cpu_id);
