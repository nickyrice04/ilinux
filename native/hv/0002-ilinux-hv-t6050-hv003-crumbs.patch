+/* ILINUX-CRUMB-BEGIN */
+/*
+ * iLinux private (not for upstream): framebuffer breadcrumbs for the hv003
+ * chainload test. Each early-init step stores one white block straight into
+ * the boot framebuffer, so a silent hang names its last completed step on the
+ * screen (the M5 has no reachable UART). Geometry is shared with the host
+ * launcher and the copy stub: slot n is a 24x24 block at x = 8 + 28 * n,
+ * y = 4 in 4-byte pixels. Slots 0..4 belong to the host and the stub; step
+ * cN (N = 0..15) is slot 5 + N. Blocks are never cleared.
+ */
+#define ILINUX_CRUMB_BLOCK      24U
+#define ILINUX_CRUMB_PITCH      28U
+#define ILINUX_CRUMB_ORIGIN_X   8U
+#define ILINUX_CRUMB_ORIGIN_Y   4U
+#define ILINUX_CRUMB_SLOTS      21U
+#define ILINUX_CRUMB_COLOR      0xffffffffU
+#define ILINUX_CRUMB_FIRST_STEP 5U
+#define ILINUX_CRUMB_STEPS      16U
+/* Generous (8K is 30720 x 4320): keeps stride * height and base + size from wrapping. */
+#define ILINUX_CRUMB_MAX_STRIDE ((u64)0x10000)
+#define ILINUX_CRUMB_MAX_HEIGHT ((u64)0x4000)
+
+#define ILINUX_CRUMB_ST_UNSEEN 0x43524d30U
+#define ILINUX_CRUMB_ST_ARMED  0x43524d31U
+#define ILINUX_CRUMB_ST_MAPPED 0x43524d32U
+
+/*
+ * The nonzero initialiser puts this in .data, which is loaded with the image,
+ * not in .bss: at c0 (before _start_c clears .bss) it already holds a defined
+ * value and the clear cannot touch it. It is only ever written by this code.
+ * ARMED means a call saw the MMU off, so m1n1 will build its own page tables
+ * before turning it on; MAPPED means the framebuffer was mapped since.
+ */
+static u32 ilinux_crumb_state = ILINUX_CRUMB_ST_UNSEEN;
+
+static bool ilinux_crumb_geometry_ok(const struct boot_video *video, unsigned int slot)
+{
+    const u64 span = ILINUX_CRUMB_ORIGIN_X + (u64)ILINUX_CRUMB_SLOTS * ILINUX_CRUMB_PITCH;
+    const u64 depth = video->depth & 0xff;
+
+    if (slot >= ILINUX_CRUMB_SLOTS)
+        return false;
+    if (video->base == 0 || (video->base & 3))
+        return false;
+    if (depth != 30 && depth != 32)
+        return false;
+    if (video->width < span)
+        return false;
+    if (video->height < ILINUX_CRUMB_ORIGIN_Y + ILINUX_CRUMB_BLOCK)
+        return false;
+    if (video->stride < span * 4)
+        return false;
+    /* The stores run with the MMU off at c0..c8: every row must stay 4-byte aligned. */
+    if (video->stride & 3)
+        return false;
+    if (video->stride > ILINUX_CRUMB_MAX_STRIDE || video->height > ILINUX_CRUMB_MAX_HEIGHT)
+        return false;
+    if (video->stride * video->height > ~(u64)0 - video->base)
+        return false;
+    return true;
+}
+
+static void ilinux_crumb_fill(u64 fb, u64 stride, unsigned int slot)
+{
+    const u64 x0 = ILINUX_CRUMB_ORIGIN_X + (u64)slot * ILINUX_CRUMB_PITCH;
+
+    for (u64 row = 0; row < ILINUX_CRUMB_BLOCK; row++) {
+        volatile u32 *p = (volatile u32 *)(fb + (ILINUX_CRUMB_ORIGIN_Y + row) * stride + x0 * 4);
+
+        for (u64 col = 0; col < ILINUX_CRUMB_BLOCK; col++)
+            p[col] = ILINUX_CRUMB_COLOR;
+    }
+}
+
+/* Paint one block straight into the framebuffer described by *video. */
+void ilinux_crumb(const struct boot_video *video, unsigned int slot)
+{
+    const bool mmu_on = mmu_active();
+
+    if (!mmu_on)
+        ilinux_crumb_state = ILINUX_CRUMB_ST_ARMED;
+
+    if (!ilinux_crumb_geometry_ok(video, slot))
+        return;
+
+    if (mmu_on) {
+        /* Not ours to map unless this boot saw the MMU off first (see above). */
+        if (ilinux_crumb_state == ILINUX_CRUMB_ST_ARMED) {
+            /* mmu_map() needs 16K alignment; never fault in the painter. */
+            if (video->base & 0x3fff)
+                return;
+            /* Same call as fb_init(): the framebuffer is not part of mmu_init(). */
+            mmu_add_mapping(video->base, video->base,
+                            ALIGN_UP(video->stride * video->height, 0x4000), MAIR_IDX_NORMAL_NC,
+                            PERM_RW);
+            ilinux_crumb_state = ILINUX_CRUMB_ST_MAPPED;
+        }
+        if (ilinux_crumb_state != ILINUX_CRUMB_ST_MAPPED)
+            return;
+    }
+
+    ilinux_crumb_fill(video->base, video->stride, slot);
+    sysop("dsb sy");
+}
+
+/*
+ * Same block in the console's shadow copy of the framebuffer. After fb_init()
+ * every fb_update() overwrites the hardware framebuffer from that copy, so a
+ * block painted only into the hardware buffer (c15) would be erased again by
+ * the first console write.
+ */
+void ilinux_crumb_shadow(const struct boot_video *video, u32 *shadow, unsigned int slot)
+{
+    if (!shadow || !ilinux_crumb_geometry_ok(video, slot))
+        return;
+
+    ilinux_crumb_fill((u64)shadow, video->stride, slot);
+}
+
+/* Step cN of the shared contract, using the copied boot_args. */
+void ilinux_crumb_step(unsigned int step)
+{
+    if (step < ILINUX_CRUMB_STEPS)
+        ilinux_crumb(&cur_boot_args.video, ILINUX_CRUMB_FIRST_STEP + step);
+}
+
+void ilinux_crumb_shadow_step(unsigned int step, u32 *shadow)
+{
+    if (step < ILINUX_CRUMB_STEPS)
+        ilinux_crumb_shadow(&cur_boot_args.video, shadow, ILINUX_CRUMB_FIRST_STEP + step);
+}
+/* ILINUX-CRUMB-END */
