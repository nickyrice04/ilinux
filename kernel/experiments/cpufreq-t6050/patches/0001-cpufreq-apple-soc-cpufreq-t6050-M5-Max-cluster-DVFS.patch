From: iLinux <ilinux@localhost>
Subject: [PATCH] cpufreq: add explicitly enabled t6050 command-only experiment

Original downstream experiment based on published interface findings and the
Asahi driver. Not native-validated. Requires a t6050-only DT compatible so an
older driver cannot silently select the t8112 STATUS register layout.

Default is no writes. Explicit writes require a p-state cap, J716c/t6050 and
one online CPU. Unknown boot states fail policy initialization instead of
inventing a frequency. No STATUS, PLL, voltage, APSC or cluster-init writes.
Command readback is a requested state, never a measured clock rate.

---
--- a/drivers/cpufreq/apple-soc-cpufreq.c
+++ b/drivers/cpufreq/apple-soc-cpufreq.c
@@ -62,6 +62,7 @@
 
 struct apple_soc_cpufreq_info {
 	bool has_ps2;
+	bool ilinux_guarded;
 	u64 max_pstate;
 	u64 cur_pstate_mask;
 	u64 cur_pstate_shift;
@@ -76,6 +77,27 @@
 };
 
 static struct cpufreq_driver apple_soc_cpufreq_driver;
+
+/* Experimental t6050 policy: no writes unless opted in with an explicit cap. */
+static bool ilinux_enable_writes;
+module_param(ilinux_enable_writes, bool, 0444);
+MODULE_PARM_DESC(ilinux_enable_writes, "t6050 experimental DVFS writes (default false, fixed at load)");
+static unsigned int ilinux_max_pstate;
+module_param(ilinux_max_pstate, uint, 0444);
+MODULE_PARM_DESC(ilinux_max_pstate, "t6050 maximum requested p-state; mandatory with writes (fixed at load)");
+
+/* Only the command register has reviewed t6050 evidence. Never read STATUS. */
+#define APPLE_DVFS_CMD_APSC_DIS_T6050 BIT(23)
+#define APPLE_DVFS_CMD_APSC_BUSY_T6050 BIT(7)
+static const struct apple_soc_cpufreq_info soc_t6050_info = {
+	.has_ps2 = false,
+	.ilinux_guarded = true,
+	.max_pstate = 31,
+	.cur_pstate_mask = 0, /* requested p-state, not measured frequency */
+	.ps1_mask = APPLE_DVFS_CMD_PS1,
+	.ps1_shift = APPLE_DVFS_CMD_PS1_SHIFT,
+};
+
 
 static const struct apple_soc_cpufreq_info soc_s5l8960x_info = {
 	.has_ps2 = false,
@@ -113,6 +135,10 @@
 };
 
 static const struct of_device_id apple_soc_cpufreq_of_match[] __maybe_unused = {
+	{
+		.compatible = "apple,t6050-cluster-cpufreq",
+		.data = &soc_t6050_info,
+	},
 	{
 		.compatible = "apple,s5l8960x-cluster-cpufreq",
 		.data = &soc_s5l8960x_info,
@@ -175,6 +201,17 @@
 	unsigned int pstate = policy->freq_table[index].driver_data;
 	u64 reg;
 
+	if (priv->info->ilinux_guarded) {
+		/* A denied transition must not look successful to cpufreq/governors. */
+		if (!ilinux_enable_writes)
+			return -EPERM;
+		if (num_online_cpus() != 1 || policy->cpu != 0)
+			return -EPERM;
+		if (pstate < 2 || pstate > 31 || !ilinux_max_pstate ||
+		    pstate > ilinux_max_pstate)
+			return -EINVAL;
+	}
+
 	/* Fallback for newer SoCs */
 	if (index > priv->info->max_pstate)
 		index = priv->info->max_pstate;
@@ -184,6 +221,10 @@
 				      APPLE_DVFS_TRANSITION_TIMEOUT)) {
 		return -EIO;
 	}
+
+	if (priv->info->ilinux_guarded &&
+	    (reg & (APPLE_DVFS_CMD_APSC_DIS_T6050 | APPLE_DVFS_CMD_APSC_BUSY_T6050)))
+		return -EBUSY;
 
 	reg &= ~priv->info->ps1_mask;
 	reg |= pstate << priv->info->ps1_shift;
@@ -194,6 +235,16 @@
 	reg |= APPLE_DVFS_CMD_SET;
 
 	writeq_relaxed(reg, priv->reg_base + APPLE_DVFS_CMD);
+
+	if (priv->info->ilinux_guarded) {
+		/* Command readback only: not proof of transition completion or frequency. */
+		if (readq_poll_timeout_atomic(priv->reg_base + APPLE_DVFS_CMD, reg,
+					      !(reg & APPLE_DVFS_CMD_BUSY), 2,
+					      APPLE_DVFS_TRANSITION_TIMEOUT))
+			return -ETIMEDOUT;
+		if (FIELD_GET(APPLE_DVFS_CMD_PS1, reg) != pstate)
+			return -EIO;
+	}
 
 	return 0;
 }
@@ -301,6 +352,46 @@
 		dev_pm_opp_put(opp);
 	}
 
+	if (info->ilinux_guarded) {
+		u64 cmd;
+		unsigned int requested_pstate, highest = 0;
+		bool found = false;
+
+		if (!of_machine_is_compatible("apple,j716c") ||
+		    !of_machine_is_compatible("apple,t6050") ||
+		    num_online_cpus() != 1 || policy->cpu != 0) {
+			ret = -ENODEV;
+			goto out_free_cpufreq_table;
+		}
+		for (i = 0; freq_table[i].frequency != CPUFREQ_TABLE_END; i++) {
+			unsigned int level = freq_table[i].driver_data;
+
+			if (level < 2 || level > 31) {
+				ret = -EINVAL;
+				goto out_free_cpufreq_table;
+			}
+			highest = max(highest, level);
+		}
+		if (ilinux_enable_writes && (ilinux_max_pstate < 2 ||
+					    ilinux_max_pstate > highest)) {
+			ret = -EINVAL;
+			goto out_free_cpufreq_table;
+		}
+		cmd = readq_relaxed(reg_base + APPLE_DVFS_CMD);
+		requested_pstate = FIELD_GET(APPLE_DVFS_CMD_PS1, cmd);
+		dev_info(cpu_dev,
+			 "t6050 command 0x%016llx requested p-state %u, writes %d cap %u; actual frequency unmeasured\n",
+			 cmd, requested_pstate, ilinux_enable_writes, ilinux_max_pstate);
+		for (i = 0; freq_table[i].frequency != CPUFREQ_TABLE_END; i++)
+			found |= freq_table[i].driver_data == requested_pstate;
+		/* No fabricated frequency for an unknown firmware boot state. */
+		if (!found) {
+			dev_err(cpu_dev, "boot p-state absent from OPP table; policy refused\n");
+			ret = -ERANGE;
+			goto out_free_cpufreq_table;
+		}
+	}
+
 	priv->cpu_dev = cpu_dev;
 	priv->reg_base = reg_base;
 	priv->info = info;
@@ -313,7 +404,7 @@
 
 	policy->cpuinfo.transition_latency = transition_latency;
 	policy->dvfs_possible_from_any_cpu = true;
-	policy->fast_switch_possible = true;
+	policy->fast_switch_possible = !info->ilinux_guarded;
 	policy->suspend_freq = freq_table[0].frequency;
 
 	return 0;
