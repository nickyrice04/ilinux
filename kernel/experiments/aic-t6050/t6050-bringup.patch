+/*
+ * t6050 single-CPU bring-up: the legacy guest-timer enable write faults in
+ * the observed EL2 boot state. Keep guest timers masked at their sources and
+ * do not expose guest IRQs/KVM until their routing is validated. The pinned
+ * m1n1 CPU table also leaves the M5 uncore interface unimplemented; do not
+ * infer that old uncore registers are usable just because fast IPIs are.
+ * This is a restricted bring-up profile, not full M5 virtualization support.
+ */
+static const struct aic_info aic3_t6050_info __initconst = {
+	.version	= 3,
+	.irq_cfg	= AIC3_IRQ_CFG,
+	.fast_ipi	= true,
