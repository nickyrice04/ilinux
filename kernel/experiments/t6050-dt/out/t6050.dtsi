			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1423 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&ps_atc0_usb>; /* ADT clock-gates */
			status = "disabled"; /* DRAFT: ADT dart-usb0 DART instance 0 */
