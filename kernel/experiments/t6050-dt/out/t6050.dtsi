/*
 * Apple t6050 "M5 Max" SoC - DRAFT minimal device tree.
 *
 * Generated by kernel/experiments/t6050-dt/gen_t6050_dt.py from a sanitized
 * macOS ADT capture of a Mac17,6 (J716c).  UNTESTED: requires m1n1 support
 * for t6050.  See README.md in this directory for open questions.
 */

#include <dt-bindings/interrupt-controller/apple-aic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/apple.h>

/ {
	compatible = "apple,t6050", "apple,arm-platform";
	#address-cells = <2>;
	#size-cells = <2>;

	cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu_m0>;
				};
				core1 {
					cpu = <&cpu_m1>;
				};
				core2 {
					cpu = <&cpu_m2>;
				};
				core3 {
					cpu = <&cpu_m3>;
				};
				core4 {
					cpu = <&cpu_m4>;
				};
				core5 {
					cpu = <&cpu_m5>;
				};
			};
			cluster1 {
				core0 {
					cpu = <&cpu_m6>;
				};
				core1 {
					cpu = <&cpu_m7>;
				};
				core2 {
					cpu = <&cpu_m8>;
				};
				core3 {
					cpu = <&cpu_m9>;
				};
				core4 {
					cpu = <&cpu_m10>;
				};
				core5 {
					cpu = <&cpu_m11>;
				};
			};
			cluster2 {
				core0 {
					cpu = <&cpu_p0>;
				};
				core1 {
					cpu = <&cpu_p1>;
				};
				core2 {
					cpu = <&cpu_p2>;
				};
				core3 {
					cpu = <&cpu_p3>;
				};
				core4 {
					cpu = <&cpu_p4>;
				};
				core5 {
					cpu = <&cpu_p5>;
				};
			};
		};

		/* ADT cpu0: cluster 0 type M (apple,sawtooth); MPIDR below is the ADT reg value -
		 * HYPOTHESIS: real MPIDR may carry extra Aff2 bits (m1n1 must confirm). */
		cpu_m0: cpu@0 {
			compatible = "apple,sotra-m"; /* placeholder: needs DT binding */
			device_type = "cpu";
			reg = <0x0 0x0>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* filled in by m1n1 */
			next-level-cache = <&l2_cache_0>;
		};

		/* ADT cpu1: cluster 0 type M (apple,sawtooth); MPIDR below is the ADT reg value -
		 * HYPOTHESIS: real MPIDR may carry extra Aff2 bits (m1n1 must confirm). */
		cpu_m1: cpu@1 {
			compatible = "apple,sotra-m"; /* placeholder: needs DT binding */
			device_type = "cpu";
			reg = <0x0 0x1>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* filled in by m1n1 */
			next-level-cache = <&l2_cache_0>;
		};

		/* ADT cpu2: cluster 0 type M (apple,sawtooth); MPIDR below is the ADT reg value -
		 * HYPOTHESIS: real MPIDR may carry extra Aff2 bits (m1n1 must confirm). */
		cpu_m2: cpu@2 {
			compatible = "apple,sotra-m"; /* placeholder: needs DT binding */
			device_type = "cpu";
			reg = <0x0 0x2>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* filled in by m1n1 */
			next-level-cache = <&l2_cache_0>;
		};

		/* ADT cpu3: cluster 0 type M (apple,sawtooth); MPIDR below is the ADT reg value -
		 * HYPOTHESIS: real MPIDR may carry extra Aff2 bits (m1n1 must confirm). */
		cpu_m3: cpu@3 {
			compatible = "apple,sotra-m"; /* placeholder: needs DT binding */
			device_type = "cpu";
			reg = <0x0 0x3>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* filled in by m1n1 */
			next-level-cache = <&l2_cache_0>;
		};

		/* ADT cpu4: cluster 0 type M (apple,sawtooth); MPIDR below is the ADT reg value -
		 * HYPOTHESIS: real MPIDR may carry extra Aff2 bits (m1n1 must confirm). */
		cpu_m4: cpu@4 {
			compatible = "apple,sotra-m"; /* placeholder: needs DT binding */
			device_type = "cpu";
			reg = <0x0 0x4>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* filled in by m1n1 */
			next-level-cache = <&l2_cache_0>;
		};

		/* ADT cpu5: cluster 0 type M (apple,sawtooth); MPIDR below is the ADT reg value -
		 * HYPOTHESIS: real MPIDR may carry extra Aff2 bits (m1n1 must confirm). */
		cpu_m5: cpu@5 {
			compatible = "apple,sotra-m"; /* placeholder: needs DT binding */
			device_type = "cpu";
			reg = <0x0 0x5>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* filled in by m1n1 */
			next-level-cache = <&l2_cache_0>;
		};

		/* ADT cpu6: cluster 1 type M (apple,sawtooth); MPIDR below is the ADT reg value -
		 * HYPOTHESIS: real MPIDR may carry extra Aff2 bits (m1n1 must confirm). */
		cpu_m6: cpu@100 {
			compatible = "apple,sotra-m"; /* placeholder: needs DT binding */
			device_type = "cpu";
			reg = <0x0 0x100>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* filled in by m1n1 */
			next-level-cache = <&l2_cache_1>;
		};

		/* ADT cpu7: cluster 1 type M (apple,sawtooth); MPIDR below is the ADT reg value -
		 * HYPOTHESIS: real MPIDR may carry extra Aff2 bits (m1n1 must confirm). */
		cpu_m7: cpu@101 {
			compatible = "apple,sotra-m"; /* placeholder: needs DT binding */
			device_type = "cpu";
			reg = <0x0 0x101>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* filled in by m1n1 */
			next-level-cache = <&l2_cache_1>;
		};

		/* ADT cpu8: cluster 1 type M (apple,sawtooth); MPIDR below is the ADT reg value -
		 * HYPOTHESIS: real MPIDR may carry extra Aff2 bits (m1n1 must confirm). */
		cpu_m8: cpu@102 {
			compatible = "apple,sotra-m"; /* placeholder: needs DT binding */
			device_type = "cpu";
			reg = <0x0 0x102>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* filled in by m1n1 */
			next-level-cache = <&l2_cache_1>;
		};

		/* ADT cpu9: cluster 1 type M (apple,sawtooth); MPIDR below is the ADT reg value -
		 * HYPOTHESIS: real MPIDR may carry extra Aff2 bits (m1n1 must confirm). */
		cpu_m9: cpu@103 {
			compatible = "apple,sotra-m"; /* placeholder: needs DT binding */
			device_type = "cpu";
			reg = <0x0 0x103>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* filled in by m1n1 */
			next-level-cache = <&l2_cache_1>;
		};

		/* ADT cpu10: cluster 1 type M (apple,sawtooth); MPIDR below is the ADT reg value -
		 * HYPOTHESIS: real MPIDR may carry extra Aff2 bits (m1n1 must confirm). */
		cpu_m10: cpu@104 {
			compatible = "apple,sotra-m"; /* placeholder: needs DT binding */
			device_type = "cpu";
			reg = <0x0 0x104>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* filled in by m1n1 */
			next-level-cache = <&l2_cache_1>;
		};

		/* ADT cpu11: cluster 1 type M (apple,sawtooth); MPIDR below is the ADT reg value -
		 * HYPOTHESIS: real MPIDR may carry extra Aff2 bits (m1n1 must confirm). */
		cpu_m11: cpu@105 {
			compatible = "apple,sotra-m"; /* placeholder: needs DT binding */
			device_type = "cpu";
			reg = <0x0 0x105>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* filled in by m1n1 */
			next-level-cache = <&l2_cache_1>;
		};

		/* ADT cpu12: cluster 2 type P (apple,everest); MPIDR below is the ADT reg value -
		 * HYPOTHESIS: real MPIDR may carry extra Aff2 bits (m1n1 must confirm). */
		cpu_p0: cpu@200 {
			compatible = "apple,sotra-p"; /* placeholder: needs DT binding */
			device_type = "cpu";
			reg = <0x0 0x200>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* filled in by m1n1 */
			next-level-cache = <&l2_cache_2>;
		};

		/* ADT cpu13: cluster 2 type P (apple,everest); MPIDR below is the ADT reg value -
		 * HYPOTHESIS: real MPIDR may carry extra Aff2 bits (m1n1 must confirm). */
		cpu_p1: cpu@201 {
			compatible = "apple,sotra-p"; /* placeholder: needs DT binding */
			device_type = "cpu";
			reg = <0x0 0x201>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* filled in by m1n1 */
			next-level-cache = <&l2_cache_2>;
		};

		/* ADT cpu14: cluster 2 type P (apple,everest); MPIDR below is the ADT reg value -
		 * HYPOTHESIS: real MPIDR may carry extra Aff2 bits (m1n1 must confirm). */
		cpu_p2: cpu@202 {
			compatible = "apple,sotra-p"; /* placeholder: needs DT binding */
			device_type = "cpu";
			reg = <0x0 0x202>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* filled in by m1n1 */
			next-level-cache = <&l2_cache_2>;
		};

		/* ADT cpu15: cluster 2 type P (apple,everest); MPIDR below is the ADT reg value -
		 * HYPOTHESIS: real MPIDR may carry extra Aff2 bits (m1n1 must confirm). */
		cpu_p3: cpu@203 {
			compatible = "apple,sotra-p"; /* placeholder: needs DT binding */
			device_type = "cpu";
			reg = <0x0 0x203>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* filled in by m1n1 */
			next-level-cache = <&l2_cache_2>;
		};

		/* ADT cpu16: cluster 2 type P (apple,everest); MPIDR below is the ADT reg value -
		 * HYPOTHESIS: real MPIDR may carry extra Aff2 bits (m1n1 must confirm). */
		cpu_p4: cpu@204 {
			compatible = "apple,sotra-p"; /* placeholder: needs DT binding */
			device_type = "cpu";
			reg = <0x0 0x204>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* filled in by m1n1 */
			next-level-cache = <&l2_cache_2>;
		};

		/* ADT cpu17: cluster 2 type P (apple,everest); MPIDR below is the ADT reg value -
		 * HYPOTHESIS: real MPIDR may carry extra Aff2 bits (m1n1 must confirm). */
		cpu_p5: cpu@205 {
			compatible = "apple,sotra-p"; /* placeholder: needs DT binding */
			device_type = "cpu";
			reg = <0x0 0x205>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* filled in by m1n1 */
			next-level-cache = <&l2_cache_2>;
		};

		l2_cache_0: l2-cache-0 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
			cache-size = <0x800000>;
		};

		l2_cache_1: l2-cache-1 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
			cache-size = <0x800000>;
		};

		l2_cache_2: l2-cache-2 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
			cache-size = <0x1000000>;
		};

	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&aic>;
		interrupt-names = "phys", "virt", "hyp-phys", "hyp-virt";
		interrupts = <AIC_FIQ AIC_TMR_GUEST_PHYS IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_FIQ AIC_TMR_GUEST_VIRT IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_FIQ AIC_TMR_HV_PHYS IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_FIQ AIC_TMR_HV_VIRT IRQ_TYPE_LEVEL_HIGH>;
	};

	clkref: clock-ref {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "clkref";
	};

	soc: soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		nonposted-mmio;

		/* ADT aic: compatible aic,3, reg size 0x1cc000 (same as t8132's AIC3). */
		aic: interrupt-controller@280400000 {
			compatible = "apple,t6050-aic3", "apple,t8122-aic3";
			#interrupt-cells = <3>;
			interrupt-controller;
			reg = <0x2 0x80400000 0x0 0x1cc000>,
			      <0x2 0x80440000 0x0 0x4000>;
			reg-names = "core", "event";
			/* event region = core + ADT aic-iack-offset (0x40000), matching the
			 * core+0x40000 layout Asahi uses for t8122/t8132 AIC3. */
			affinities {
				m-core-pmu-affinity {
					apple,fiq-index = <AIC_CPU_PMU_E>;
					cpus = <&cpu_m0 &cpu_m1 &cpu_m2 &cpu_m3 &cpu_m4 &cpu_m5 &cpu_m6 &cpu_m7 &cpu_m8 &cpu_m9 &cpu_m10 &cpu_m11>;
				};
				p-core-pmu-affinity {
					apple,fiq-index = <AIC_CPU_PMU_P>;
					cpus = <&cpu_p0 &cpu_p1 &cpu_p2 &cpu_p3 &cpu_p4 &cpu_p5>;
				};
			};
		};

		wdt: watchdog@28836c000 {
			compatible = "apple,t6050-wdt", "apple,t8103-wdt";
			reg = <0x2 0x8836c000 0x0 0x4000>;
			clocks = <&clkref>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 721 IRQ_TYPE_LEVEL_HIGH>;
		};

		pinctrl_ap: pinctrl@29c000000 {
			compatible = "apple,t6050-pinctrl", "apple,t8103-pinctrl";
			reg = <0x2 0x9c000000 0x0 0x44000>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl_ap 0 0 221>;
			apple,npins = <221>;
			interrupt-controller;
			#interrupt-cells = <2>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 486 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 487 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 488 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 489 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 490 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 491 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 492 IRQ_TYPE_LEVEL_HIGH>;
			/* TODO: power-domains (PMGR not yet described). */
		};

		pinctrl_aop: pinctrl@290824000 {
			compatible = "apple,t6050-pinctrl", "apple,t8103-pinctrl";
			reg = <0x2 0x90824000 0x0 0x4000>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl_aop 0 0 85>;
			apple,npins = <85>;
			interrupt-controller;
			#interrupt-cells = <2>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 568 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 569 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 570 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 571 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 572 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 573 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 574 IRQ_TYPE_LEVEL_HIGH>;
			/* TODO: power-domains (PMGR not yet described). */
		};

		pinctrl_nub: pinctrl@2881e4000 {
			compatible = "apple,t6050-pinctrl", "apple,t8103-pinctrl";
			reg = <0x2 0x881e4000 0x0 0x4000>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl_nub 0 0 61>;
			apple,npins = <61>;
			interrupt-controller;
			#interrupt-cells = <2>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 706 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 708 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 710 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 712 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 714 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 716 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 718 IRQ_TYPE_LEVEL_HIGH>;
			/* TODO: power-domains (PMGR not yet described). */
		};

		i2c0: i2c@505010000 {
			compatible = "apple,t6050-i2c", "apple,t8103-i2c";
			reg = <0x5 0x05010000 0x0 0x4000>;
			clocks = <&clkref>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1375 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			status = "disabled";
		};

		i2c1: i2c@505014000 {
			compatible = "apple,t6050-i2c", "apple,t8103-i2c";
			reg = <0x5 0x05014000 0x0 0x4000>;
			clocks = <&clkref>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1376 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			status = "disabled";
		};

		i2c2: i2c@505018000 {
			compatible = "apple,t6050-i2c", "apple,t8103-i2c";
			reg = <0x5 0x05018000 0x0 0x4000>;
			clocks = <&clkref>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1377 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			status = "disabled";
		};

		i2c3: i2c@50501c000 {
			compatible = "apple,t6050-i2c", "apple,t8103-i2c";
			reg = <0x5 0x0501c000 0x0 0x4000>;
			clocks = <&clkref>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1378 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			status = "disabled";
		};

		i2c4: i2c@505020000 {
			compatible = "apple,t6050-i2c", "apple,t8103-i2c";
			reg = <0x5 0x05020000 0x0 0x4000>;
			clocks = <&clkref>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1379 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			status = "disabled";
		};

		i2c5: i2c@505024000 {
			compatible = "apple,t6050-i2c", "apple,t8103-i2c";
			reg = <0x5 0x05024000 0x0 0x4000>;
			clocks = <&clkref>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1380 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			status = "disabled";
		};

		i2c6: i2c@505028000 {
			compatible = "apple,t6050-i2c", "apple,t8103-i2c";
			reg = <0x5 0x05028000 0x0 0x4000>;
			clocks = <&clkref>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1381 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			status = "disabled";
		};

		i2c7: i2c@50502c000 {
			compatible = "apple,t6050-i2c", "apple,t8103-i2c";
			reg = <0x5 0x0502c000 0x0 0x4000>;
			clocks = <&clkref>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1382 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			status = "disabled";
		};

		i2c8: i2c@505030000 {
			compatible = "apple,t6050-i2c", "apple,t8103-i2c";
			reg = <0x5 0x05030000 0x0 0x4000>;
			clocks = <&clkref>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1383 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			status = "disabled";
		};

		serial0: serial@505200000 {
			compatible = "apple,s5l-uart";
			reg = <0x5 0x05200000 0x0 0x4000>;
			reg-io-width = <4>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1359 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clkref>, <&clkref>;
			clock-names = "uart", "clk_uart_baud0";
			status = "disabled";
		};
	};
};
