		};

		dart_apcie1: iommu@411000000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x4 0x11000000 0x0 0x20000>;
			#iommu-cells = <1>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1532 IRQ_TYPE_LEVEL_HIGH>;
			/* TODO: power-domains (no ADT clock-gates) */
			status = "disabled"; /* DRAFT: ADT dart-apcie1 DART instance 0 */
		};

		/* ASC mailbox at ans reg[0] + 0x8000 (m1n1 asc.c; works on t6050 in m1n1).
		 * IRQ order sorted from ADT ans interrupts[0..3] (LIKELY, by analogy
		 * with t8103/t6031). */
		ans_mbox: mbox@419608000 {
			compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
			reg = <0x4 0x19608000 0x0 0x4000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1347 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 1348 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 1349 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 1350 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "send-empty", "send-not-empty",
					  "recv-empty", "recv-not-empty";
			power-domains = <&ps_ans>;
			#mbox-cells = <0>;
		};

		/* ADT sart-ans: sart,coastguard, sart-version 4 (m1n1 SARTv4, 9bfdf8ae).
		 * Needs kernel/patches/t6050/0001 (no fallback: new register layout). */
		sart: iommu@41dc50000 {
			compatible = "apple,t6050-sart";
			reg = <0x4 0x1dc50000 0x0 0xc000>;
			power-domains = <&ps_ans>;
		};

		/* ADT ans: iop,ascwrap-v6, nvme-secure-bar present -> M4+ layout (m1n1
		 * 53f8ee9b): NVMe regs = reg[9], NVMMU regs = reg[3].  The nvme window is
		 * 0x40000 because m1n1 accesses +0x24908..0x24910 through reg[9] although
		 * the ADT size is 0x10000 (LIKELY).  IRQ = interrupts[nvme-interrupt-idx=4].
		 * Needs kernel/patches/t6050/0003. */
		nvme: nvme@45dcc0000 {
			compatible = "apple,t6050-nvme-ans2", "apple,t8132-nvme-ans2";
			reg = <0x4 0x5dcc0000 0x0 0x40000>,
			      <0x4 0x19600000 0x0 0x4000>,
			      <0x4 0x1dcc0000 0x0 0x60010>;
			reg-names = "nvme", "ans", "nvmmu";
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 2338 IRQ_TYPE_LEVEL_HIGH>;
			mboxes = <&ans_mbox>;
			apple,sart = <&sart>;
			power-domains = <&ps_ans>, <&ps_apcie_sys_st0>, <&ps_apcie_sys_st1>;
			power-domain-names = "ans", "apcie0", "apcie1";
			resets = <&ps_ans>;
			status = "disabled"; /* DRAFT */
		};

		dart_disp0_isoc: iommu@48a180000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x4 0x8a180000 0x0 0x20000>;
			#iommu-cells = <1>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1013 IRQ_TYPE_LEVEL_HIGH>;
			/* TODO: power-domains (no ADT clock-gates) */
			status = "disabled"; /* DRAFT: ADT dart-disp0-isoc DART instance 0 */
		};

