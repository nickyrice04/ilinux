			clock-latency-ns = <50000>;
		};
		opp15 {
			opp-hz = /bits/ 64 <4380000000>;
			opp-level = <15>;
			opp-microvolt = <1025000>;
			clock-latency-ns = <50000>;
		};
	};

	/*
	 * Cluster 2 DVFS states from ADT pmgr voltage-states5(-sram), selected by
	 * pmgr acc-clusters.  opp-level = table index + 1 (HYPOTHESIS, M1-M3
	 * convention); opp-microvolt = core rail, only used by the energy model.
	 * clock-latency-ns is a PLACEHOLDER (not measured).
	 */
	cluster2_opp: opp-table-2 {
		compatible = "operating-points-v2";
		opp-shared;

		opp01 {
			opp-hz = /bits/ 64 <1308000000>;
			opp-level = <1>;
			opp-microvolt = <625000>;
			clock-latency-ns = <50000>;
		};
		opp02 {
			opp-hz = /bits/ 64 <1620000000>;
			opp-level = <2>;
			opp-microvolt = <675000>;
			clock-latency-ns = <50000>;
		};
		opp03 {
			opp-hz = /bits/ 64 <1980000000>;
			opp-level = <3>;
			opp-microvolt = <700000>;
			clock-latency-ns = <50000>;
		};
		opp04 {
			opp-hz = /bits/ 64 <2292000000>;
			opp-level = <4>;
			opp-microvolt = <735000>;
			clock-latency-ns = <50000>;
		};
		opp05 {
			opp-hz = /bits/ 64 <2580000000>;
			opp-level = <5>;
			opp-microvolt = <775000>;
			clock-latency-ns = <50000>;
		};
		opp06 {
			opp-hz = /bits/ 64 <2880000000>;
			opp-level = <6>;
			opp-microvolt = <810000>;
			clock-latency-ns = <50000>;
		};
		opp07 {
			opp-hz = /bits/ 64 <3180000000>;
			opp-level = <7>;
			opp-microvolt = <840000>;
			clock-latency-ns = <50000>;
		};
		opp08 {
			opp-hz = /bits/ 64 <3432000000>;
			opp-level = <8>;
			opp-microvolt = <875000>;
			clock-latency-ns = <50000>;
		};
		opp09 {
			opp-hz = /bits/ 64 <3648000000>;
			opp-level = <9>;
			opp-microvolt = <890000>;
			clock-latency-ns = <50000>;
		};
		opp10 {
			opp-hz = /bits/ 64 <3828000000>;
			opp-level = <10>;
			opp-microvolt = <925000>;
			clock-latency-ns = <50000>;
		};
		opp11 {
			opp-hz = /bits/ 64 <3984000000>;
			opp-level = <11>;
			opp-microvolt = <960000>;
			clock-latency-ns = <50000>;
		};
		opp12 {
			opp-hz = /bits/ 64 <4104000000>;
			opp-level = <12>;
			opp-microvolt = <980000>;
			clock-latency-ns = <50000>;
		};
		opp13 {
			opp-hz = /bits/ 64 <4188000000>;
			opp-level = <13>;
			opp-microvolt = <1030000>;
			clock-latency-ns = <50000>;
		};
		opp14 {
			opp-hz = /bits/ 64 <4236000000>;
			opp-level = <14>;
			opp-microvolt = <1030000>;
			clock-latency-ns = <50000>;
		};
		opp15 {
			opp-hz = /bits/ 64 <4284000000>;
			opp-level = <15>;
			opp-microvolt = <1030000>;
			clock-latency-ns = <50000>;
		};
		opp16 {
			opp-hz = /bits/ 64 <4308000000>;
			opp-level = <16>;
			opp-microvolt = <1030000>;
			clock-latency-ns = <50000>;
		};
		opp17 {
			opp-hz = /bits/ 64 <4332000000>;
			opp-level = <17>;
			opp-microvolt = <1030000>;
			clock-latency-ns = <50000>;
		};
		opp18 {
			opp-hz = /bits/ 64 <4428000000>;
			opp-level = <18>;
			opp-microvolt = <1030000>;
			clock-latency-ns = <50000>;
		};
		opp19 {
			opp-hz = /bits/ 64 <4512000000>;
			opp-level = <19>;
			opp-microvolt = <1090000>;
			clock-latency-ns = <50000>;
		};
		opp20 {
			opp-hz = /bits/ 64 <4608000000>;
			opp-level = <20>;
			opp-microvolt = <1090000>;
			clock-latency-ns = <50000>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&aic>;
		interrupt-names = "phys", "virt", "hyp-phys", "hyp-virt";
		interrupts = <AIC_FIQ AIC_TMR_GUEST_PHYS IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_FIQ AIC_TMR_GUEST_VIRT IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_FIQ AIC_TMR_HV_PHYS IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_FIQ AIC_TMR_HV_VIRT IRQ_TYPE_LEVEL_HIGH>;
	};

	clkref: clock-ref {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "clkref";
	};

	soc: soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		nonposted-mmio;

		/* ADT pmgr reg entry 0x210e20000 (+0x12e8); same address pattern as the M1-M3
		 * cluster DVFS blocks (LIKELY; register format unverified on t6050).  15 states
		 * -> t8112-style 5-bit pstate field (as Asahi uses for M2/M3). */
		cpufreq0: performance-controller@210e20000 {
			compatible = "apple,t6050-cluster-cpufreq", "apple,t8112-cluster-cpufreq";
			reg = <0x2 0x10e20000 0x0 0x1000>;
			#performance-domain-cells = <0>;
		};

		/* ADT pmgr reg entry 0x211e20000 (+0x12e8); same address pattern as the M1-M3
		 * cluster DVFS blocks (LIKELY; register format unverified on t6050).  15 states
		 * -> t8112-style 5-bit pstate field (as Asahi uses for M2/M3). */
		cpufreq1: performance-controller@211e20000 {
			compatible = "apple,t6050-cluster-cpufreq", "apple,t8112-cluster-cpufreq";
			reg = <0x2 0x11e20000 0x0 0x1000>;
			#performance-domain-cells = <0>;
		};

		/* ADT pmgr reg entry 0x212e20000 (+0x12e8); same address pattern as the M1-M3
		 * cluster DVFS blocks (LIKELY; register format unverified on t6050).  20 states
		 * -> t8112-style 5-bit pstate field (as Asahi uses for M2/M3). */
		cpufreq2: performance-controller@212e20000 {
			compatible = "apple,t6050-cluster-cpufreq", "apple,t8112-cluster-cpufreq";
			reg = <0x2 0x12e20000 0x0 0x1000>;
			#performance-domain-cells = <0>;
		};

		/* ADT aic: aic,3 rev 11, core size 0x1cc000 (= t8122/t8132 AIC3).  IRQ_CFG at
		 * +extint-baseaddress 0x10000 and per-die stride 0x4a00 (= 4096 IRQs)
		 * match the Linux AIC3 layout.  ADT aic-numdies-per-die = 2: whether
		 * die-1 (GPU die) IRQs need 4-cell specifiers is UNKNOWN. */
		aic: interrupt-controller@280400000 {
			compatible = "apple,t6050-aic3", "apple,t8122-aic3";
			#interrupt-cells = <3>;
			interrupt-controller;
			reg = <0x2 0x80400000 0x0 0x1cc000>,
			      <0x2 0x80440000 0x0 0x4000>;
			reg-names = "core", "event";
			power-domains = <&ps_aic>;

			affinities {
				m-core-pmu-affinity {
					apple,fiq-index = <AIC_CPU_PMU_E>;
					cpus = <&cpu_m00 &cpu_m01 &cpu_m02 &cpu_m03 &cpu_m04 &cpu_m05 &cpu_m10 &cpu_m11 &cpu_m12 &cpu_m13 &cpu_m14 &cpu_m15>;
				};

				p-core-pmu-affinity {
					apple,fiq-index = <AIC_CPU_PMU_P>;
					cpus = <&cpu_p0 &cpu_p1 &cpu_p2 &cpu_p3 &cpu_p4 &cpu_p5>;
				};
			};
		};

		/* ADT pmgr ps-groups[0] -> pmgr reg[0] */
		pmgr: power-management@280600000 {
			compatible = "apple,t6050-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
			#address-cells = <1>;
			#size-cells = <1>;
			reg = <0x2 0x80600000 0x0 0x4000>;
			/* child nodes are added in t6050-pmgr.dtsi */
		};

		/* ADT pmgr ps-groups[1] -> pmgr reg[1] */
		pmgr1: power-management@280900000 {
			compatible = "apple,t6050-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
			#address-cells = <1>;
			#size-cells = <1>;
			reg = <0x2 0x80900000 0x0 0x4000>;
			/* child nodes are added in t6050-pmgr.dtsi */
		};

		pinctrl_nub: pinctrl@2881e4000 {
			compatible = "apple,t6050-pinctrl", "apple,t8103-pinctrl";
			reg = <0x2 0x881e4000 0x0 0x4000>;
			power-domains = <&ps_nub_gpio>;

			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl_nub 0 0 61>;
			apple,npins = <61>;

			interrupt-controller;
			#interrupt-cells = <2>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 706 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 708 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 710 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 712 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 714 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 716 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 718 IRQ_TYPE_LEVEL_HIGH>;
		};

		/* ADT pmgr ps-groups[2] -> pmgr reg[9] */
		pmgr_mini: power-management@288300000 {
			compatible = "apple,t6050-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
			#address-cells = <1>;
			#size-cells = <1>;
			reg = <0x2 0x88300000 0x0 0xc000>;
			/* child nodes are added in t6050-pmgr.dtsi */
		};

		/* ADT wdt-version 3: m1n1 disarms the secondary watchdog (reg[2]) before
		 * boot.  No PMGR device -> no power-domains (as in Asahi t8132). */
		wdt: watchdog@28836c000 {
			compatible = "apple,t6050-wdt", "apple,t8103-wdt";
			reg = <0x2 0x8836c000 0x0 0x4000>;
			clocks = <&clkref>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 721 IRQ_TYPE_LEVEL_HIGH>;
		};

		pinctrl_aop: pinctrl@290824000 {
			compatible = "apple,t6050-pinctrl", "apple,t8103-pinctrl";
			reg = <0x2 0x90824000 0x0 0x4000>;
			/* AOP_GPIO is a virtual PMGR device (AOP-managed): no domain */

			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl_aop 0 0 85>;
			apple,npins = <85>;

			interrupt-controller;
			#interrupt-cells = <2>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 568 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 569 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 570 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 571 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 572 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 573 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 574 IRQ_TYPE_LEVEL_HIGH>;
		};

		dart_mtp: iommu@294800000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x2 0x94800000 0x0 0xc000>;
			#iommu-cells = <1>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 659 IRQ_TYPE_LEVEL_HIGH>;
			/* TODO: power-domains (no ADT clock-gates) */
			status = "disabled"; /* DRAFT: ADT dart-mtp DART instance 0 */
		};

		pinctrl_ap: pinctrl@29c000000 {
			compatible = "apple,t6050-pinctrl", "apple,t8103-pinctrl";
			reg = <0x2 0x9c000000 0x0 0x44000>;
			power-domains = <&ps_gpio>;

			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl_ap 0 0 221>;
			apple,npins = <221>;

			interrupt-controller;
			#interrupt-cells = <2>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 486 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 487 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 488 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 489 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 490 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 491 IRQ_TYPE_LEVEL_HIGH>,
				     <AIC_IRQ 492 IRQ_TYPE_LEVEL_HIGH>;
		};

		dart_acio0: iommu@2a1a80000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x2 0xa1a80000 0x0 0xc000>;
			#iommu-cells = <1>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1606 IRQ_TYPE_LEVEL_HIGH>;
			/* TODO: power-domains (no ADT clock-gates) */
			status = "disabled"; /* DRAFT: ADT dart-acio0 DART instance 0 */
