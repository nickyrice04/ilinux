		dart_apciec2: iommu@384000000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x3 0x84000000 0x0 0x20000>;
			#iommu-cells = <1>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1470 IRQ_TYPE_LEVEL_HIGH>;
			/* TODO: power-domains (no ADT clock-gates) */
			status = "disabled"; /* DRAFT: ADT dart-apciec2 DART instance 0 */
		};

		dart_dispext1_isoc: iommu@392180000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x3 0x92180000 0x0 0x20000>;
			#iommu-cells = <1>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1165 IRQ_TYPE_LEVEL_HIGH>;
			/* TODO: power-domains (no ADT clock-gates) */
			status = "disabled"; /* DRAFT: ADT dart-dispext1-isoc DART instance 0 */
		};

		dart_dispext1: iommu@392300000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x3 0x92300000 0x0 0xc000>;
