		dart_sio: iommu@505060000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x5 0x05060000 0x0 0x20000>;
			#iommu-cells = <1>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1387 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&ps_sio>; /* ADT clock-gates */
			status = "disabled"; /* DRAFT: ADT dart-sio DART instance 0 */
		};

		/* Not wired to an external connector on laptops; m1n1 uses the
		 * dockchannel UART over debugusb instead (no Linux driver yet). */
		serial0: serial@505200000 {
			compatible = "apple,s5l-uart";
			reg = <0x5 0x05200000 0x0 0x4000>;
			reg-io-width = <4>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1359 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clkref>, <&clkref>;
			clock-names = "uart", "clk_uart_baud0";
			power-domains = <&ps_uart0>; /* ADT clock-gates */
			status = "disabled";
		};

		dart_jpeg0: iommu@2281020000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x22 0x81020000 0x0 0xc000>;
