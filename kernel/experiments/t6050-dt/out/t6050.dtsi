			power-domains = <&ps_msr0>; /* ADT clock-gates */
			status = "disabled"; /* DRAFT: ADT dart-scaler0 DART instance 0 */
		};

		/* ADT pmgr ps-groups[3] -> pmgr reg[51] */
		pmgr_gfx: power-management@2300e80000 {
			compatible = "apple,t6050-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
			#address-cells = <1>;
			#size-cells = <1>;
			reg = <0x23 0x00e80000 0x0 0x4000>;
			/* child nodes are added in t6050-pmgr.dtsi */
		};

		dart_avd0: iommu@2309020000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x23 0x09020000 0x0 0x20000>;
			#iommu-cells = <1>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 2424 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&ps_avd_sys>; /* ADT clock-gates */
			status = "disabled"; /* DRAFT: ADT dart-avd0 DART instance 0 */
		};

		dart_apr1: iommu@230b020000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x23 0x0b020000 0x0 0xc000>;
			#iommu-cells = <1>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1760 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&ps_prores>; /* ADT clock-gates */
			status = "disabled"; /* DRAFT: ADT dart-apr1 DART instance 0 */
		};

		/* ADT pmgr ps-groups[4] -> pmgr reg[46] */
		pmgr_die1: power-management@2380600000 {
			compatible = "apple,t6050-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
			#address-cells = <1>;
			#size-cells = <1>;
			reg = <0x23 0x80600000 0x0 0xc000>;
