			#address-cells = <0x1>;
			#size-cells = <0x0>;
			power-domains = <&ps_i2c1>; /* ADT clock-gates */
			status = "disabled";
		};

		i2c2: i2c@505018000 {
			compatible = "apple,t6050-i2c", "apple,t8103-i2c";
