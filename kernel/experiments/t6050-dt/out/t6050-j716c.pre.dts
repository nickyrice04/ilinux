/dts-v1/;


/ {
 compatible = "apple,t6050", "apple,arm-platform";
 #address-cells = <2>;
 #size-cells = <2>;
 cpus {
  #address-cells = <2>;
  #size-cells = <0>;
  cpu-map {
   cluster0 {
    core0 {
     cpu = <&cpu_m0>;
    };
    core1 {
     cpu = <&cpu_m1>;
    };
    core2 {
     cpu = <&cpu_m2>;
    };
    core3 {
     cpu = <&cpu_m3>;
    };
    core4 {
     cpu = <&cpu_m4>;
    };
    core5 {
     cpu = <&cpu_m5>;
    };
   };
   cluster1 {
    core0 {
     cpu = <&cpu_m6>;
    };
    core1 {
     cpu = <&cpu_m7>;
    };
    core2 {
     cpu = <&cpu_m8>;
    };
    core3 {
     cpu = <&cpu_m9>;
    };
    core4 {
     cpu = <&cpu_m10>;
    };
    core5 {
     cpu = <&cpu_m11>;
    };
   };
   cluster2 {
    core0 {
     cpu = <&cpu_p0>;
    };
    core1 {
     cpu = <&cpu_p1>;
    };
    core2 {
     cpu = <&cpu_p2>;
    };
    core3 {
     cpu = <&cpu_p3>;
    };
    core4 {
     cpu = <&cpu_p4>;
    };
    core5 {
     cpu = <&cpu_p5>;
    };
   };
  };
  cpu_m0: cpu@0 {
   compatible = "apple,sotra-m";
   device_type = "cpu";
   reg = <0x0 0x0>;
   enable-method = "spin-table";
   cpu-release-addr = <0 0>;
   next-level-cache = <&l2_cache_0>;
  };
  cpu_m1: cpu@1 {
   compatible = "apple,sotra-m";
   device_type = "cpu";
   reg = <0x0 0x1>;
   enable-method = "spin-table";
   cpu-release-addr = <0 0>;
   next-level-cache = <&l2_cache_0>;
  };
  cpu_m2: cpu@2 {
   compatible = "apple,sotra-m";
   device_type = "cpu";
   reg = <0x0 0x2>;
   enable-method = "spin-table";
   cpu-release-addr = <0 0>;
   next-level-cache = <&l2_cache_0>;
  };
  cpu_m3: cpu@3 {
   compatible = "apple,sotra-m";
   device_type = "cpu";
   reg = <0x0 0x3>;
   enable-method = "spin-table";
   cpu-release-addr = <0 0>;
   next-level-cache = <&l2_cache_0>;
  };
  cpu_m4: cpu@4 {
   compatible = "apple,sotra-m";
   device_type = "cpu";
   reg = <0x0 0x4>;
   enable-method = "spin-table";
   cpu-release-addr = <0 0>;
   next-level-cache = <&l2_cache_0>;
  };
  cpu_m5: cpu@5 {
   compatible = "apple,sotra-m";
   device_type = "cpu";
   reg = <0x0 0x5>;
   enable-method = "spin-table";
   cpu-release-addr = <0 0>;
   next-level-cache = <&l2_cache_0>;
  };
  cpu_m6: cpu@100 {
   compatible = "apple,sotra-m";
   device_type = "cpu";
   reg = <0x0 0x100>;
   enable-method = "spin-table";
   cpu-release-addr = <0 0>;
   next-level-cache = <&l2_cache_1>;
  };
  cpu_m7: cpu@101 {
   compatible = "apple,sotra-m";
   device_type = "cpu";
   reg = <0x0 0x101>;
   enable-method = "spin-table";
   cpu-release-addr = <0 0>;
   next-level-cache = <&l2_cache_1>;
  };
  cpu_m8: cpu@102 {
   compatible = "apple,sotra-m";
   device_type = "cpu";
   reg = <0x0 0x102>;
   enable-method = "spin-table";
   cpu-release-addr = <0 0>;
   next-level-cache = <&l2_cache_1>;
  };
  cpu_m9: cpu@103 {
   compatible = "apple,sotra-m";
   device_type = "cpu";
   reg = <0x0 0x103>;
   enable-method = "spin-table";
   cpu-release-addr = <0 0>;
   next-level-cache = <&l2_cache_1>;
  };
  cpu_m10: cpu@104 {
   compatible = "apple,sotra-m";
   device_type = "cpu";
   reg = <0x0 0x104>;
   enable-method = "spin-table";
   cpu-release-addr = <0 0>;
   next-level-cache = <&l2_cache_1>;
  };
  cpu_m11: cpu@105 {
   compatible = "apple,sotra-m";
   device_type = "cpu";
   reg = <0x0 0x105>;
   enable-method = "spin-table";
   cpu-release-addr = <0 0>;
   next-level-cache = <&l2_cache_1>;
  };
  cpu_p0: cpu@200 {
   compatible = "apple,sotra-p";
   device_type = "cpu";
   reg = <0x0 0x200>;
   enable-method = "spin-table";
   cpu-release-addr = <0 0>;
   next-level-cache = <&l2_cache_2>;
  };
  cpu_p1: cpu@201 {
   compatible = "apple,sotra-p";
   device_type = "cpu";
   reg = <0x0 0x201>;
   enable-method = "spin-table";
   cpu-release-addr = <0 0>;
   next-level-cache = <&l2_cache_2>;
  };
  cpu_p2: cpu@202 {
   compatible = "apple,sotra-p";
   device_type = "cpu";
   reg = <0x0 0x202>;
   enable-method = "spin-table";
   cpu-release-addr = <0 0>;
   next-level-cache = <&l2_cache_2>;
  };
  cpu_p3: cpu@203 {
   compatible = "apple,sotra-p";
   device_type = "cpu";
   reg = <0x0 0x203>;
   enable-method = "spin-table";
   cpu-release-addr = <0 0>;
   next-level-cache = <&l2_cache_2>;
  };
  cpu_p4: cpu@204 {
   compatible = "apple,sotra-p";
   device_type = "cpu";
   reg = <0x0 0x204>;
   enable-method = "spin-table";
   cpu-release-addr = <0 0>;
   next-level-cache = <&l2_cache_2>;
  };
  cpu_p5: cpu@205 {
   compatible = "apple,sotra-p";
   device_type = "cpu";
   reg = <0x0 0x205>;
   enable-method = "spin-table";
   cpu-release-addr = <0 0>;
   next-level-cache = <&l2_cache_2>;
  };
  l2_cache_0: l2-cache-0 {
   compatible = "cache";
   cache-level = <2>;
   cache-unified;
   cache-size = <0x800000>;
  };
  l2_cache_1: l2-cache-1 {
   compatible = "cache";
   cache-level = <2>;
   cache-unified;
   cache-size = <0x800000>;
  };
  l2_cache_2: l2-cache-2 {
   compatible = "cache";
   cache-level = <2>;
   cache-unified;
   cache-size = <0x1000000>;
  };
 };
 timer {
  compatible = "arm,armv8-timer";
  interrupt-parent = <&aic>;
  interrupt-names = "phys", "virt", "hyp-phys", "hyp-virt";
  interrupts = <1 2 4>,
        <1 3 4>,
        <1 0 4>,
        <1 1 4>;
 };
 clkref: clock-ref {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <24000000>;
  clock-output-names = "clkref";
 };
 soc: soc {
  compatible = "simple-bus";
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;
  nonposted-mmio;
  aic: interrupt-controller@280400000 {
   compatible = "apple,t6050-aic3", "apple,t8122-aic3";
   #interrupt-cells = <3>;
   interrupt-controller;
   reg = <0x2 0x80400000 0x0 0x1cc000>,
         <0x2 0x80440000 0x0 0x4000>;
   reg-names = "core", "event";
   affinities {
    m-core-pmu-affinity {
     apple,fiq-index = <4>;
     cpus = <&cpu_m0 &cpu_m1 &cpu_m2 &cpu_m3 &cpu_m4 &cpu_m5 &cpu_m6 &cpu_m7 &cpu_m8 &cpu_m9 &cpu_m10 &cpu_m11>;
    };
    p-core-pmu-affinity {
     apple,fiq-index = <5>;
     cpus = <&cpu_p0 &cpu_p1 &cpu_p2 &cpu_p3 &cpu_p4 &cpu_p5>;
    };
   };
  };
  wdt: watchdog@28836c000 {
   compatible = "apple,t6050-wdt", "apple,t8103-wdt";
   reg = <0x2 0x8836c000 0x0 0x4000>;
   clocks = <&clkref>;
   interrupt-parent = <&aic>;
   interrupts = <0 721 4>;
  };
  pinctrl_ap: pinctrl@29c000000 {
   compatible = "apple,t6050-pinctrl", "apple,t8103-pinctrl";
   reg = <0x2 0x9c000000 0x0 0x44000>;
   gpio-controller;
   #gpio-cells = <2>;
   gpio-ranges = <&pinctrl_ap 0 0 221>;
   apple,npins = <221>;
   interrupt-controller;
   #interrupt-cells = <2>;
   interrupt-parent = <&aic>;
   interrupts = <0 486 4>,
         <0 487 4>,
         <0 488 4>,
         <0 489 4>,
         <0 490 4>,
         <0 491 4>,
         <0 492 4>;
  };
  pinctrl_aop: pinctrl@290824000 {
   compatible = "apple,t6050-pinctrl", "apple,t8103-pinctrl";
   reg = <0x2 0x90824000 0x0 0x4000>;
   gpio-controller;
   #gpio-cells = <2>;
   gpio-ranges = <&pinctrl_aop 0 0 85>;
   apple,npins = <85>;
   interrupt-controller;
   #interrupt-cells = <2>;
   interrupt-parent = <&aic>;
   interrupts = <0 568 4>,
         <0 569 4>,
         <0 570 4>,
         <0 571 4>,
         <0 572 4>,
         <0 573 4>,
         <0 574 4>;
  };
  pinctrl_nub: pinctrl@2881e4000 {
   compatible = "apple,t6050-pinctrl", "apple,t8103-pinctrl";
   reg = <0x2 0x881e4000 0x0 0x4000>;
   gpio-controller;
   #gpio-cells = <2>;
   gpio-ranges = <&pinctrl_nub 0 0 61>;
   apple,npins = <61>;
   interrupt-controller;
   #interrupt-cells = <2>;
   interrupt-parent = <&aic>;
   interrupts = <0 706 4>,
         <0 708 4>,
         <0 710 4>,
         <0 712 4>,
         <0 714 4>,
         <0 716 4>,
         <0 718 4>;
  };
  i2c0: i2c@505010000 {
   compatible = "apple,t6050-i2c", "apple,t8103-i2c";
   reg = <0x5 0x05010000 0x0 0x4000>;
   clocks = <&clkref>;
   interrupt-parent = <&aic>;
   interrupts = <0 1375 4>;
   #address-cells = <0x1>;
   #size-cells = <0x0>;
   status = "disabled";
  };
  i2c1: i2c@505014000 {
   compatible = "apple,t6050-i2c", "apple,t8103-i2c";
   reg = <0x5 0x05014000 0x0 0x4000>;
   clocks = <&clkref>;
   interrupt-parent = <&aic>;
   interrupts = <0 1376 4>;
   #address-cells = <0x1>;
   #size-cells = <0x0>;
   status = "disabled";
  };
  i2c2: i2c@505018000 {
   compatible = "apple,t6050-i2c", "apple,t8103-i2c";
   reg = <0x5 0x05018000 0x0 0x4000>;
   clocks = <&clkref>;
   interrupt-parent = <&aic>;
   interrupts = <0 1377 4>;
   #address-cells = <0x1>;
   #size-cells = <0x0>;
   status = "disabled";
  };
  i2c3: i2c@50501c000 {
   compatible = "apple,t6050-i2c", "apple,t8103-i2c";
   reg = <0x5 0x0501c000 0x0 0x4000>;
   clocks = <&clkref>;
   interrupt-parent = <&aic>;
   interrupts = <0 1378 4>;
   #address-cells = <0x1>;
   #size-cells = <0x0>;
   status = "disabled";
  };
  i2c4: i2c@505020000 {
   compatible = "apple,t6050-i2c", "apple,t8103-i2c";
   reg = <0x5 0x05020000 0x0 0x4000>;
   clocks = <&clkref>;
   interrupt-parent = <&aic>;
   interrupts = <0 1379 4>;
   #address-cells = <0x1>;
   #size-cells = <0x0>;
   status = "disabled";
  };
  i2c5: i2c@505024000 {
   compatible = "apple,t6050-i2c", "apple,t8103-i2c";
   reg = <0x5 0x05024000 0x0 0x4000>;
   clocks = <&clkref>;
   interrupt-parent = <&aic>;
   interrupts = <0 1380 4>;
   #address-cells = <0x1>;
   #size-cells = <0x0>;
   status = "disabled";
  };
  i2c6: i2c@505028000 {
   compatible = "apple,t6050-i2c", "apple,t8103-i2c";
   reg = <0x5 0x05028000 0x0 0x4000>;
   clocks = <&clkref>;
   interrupt-parent = <&aic>;
   interrupts = <0 1381 4>;
   #address-cells = <0x1>;
   #size-cells = <0x0>;
   status = "disabled";
  };
  i2c7: i2c@50502c000 {
   compatible = "apple,t6050-i2c", "apple,t8103-i2c";
   reg = <0x5 0x0502c000 0x0 0x4000>;
   clocks = <&clkref>;
   interrupt-parent = <&aic>;
   interrupts = <0 1382 4>;
   #address-cells = <0x1>;
   #size-cells = <0x0>;
   status = "disabled";
  };
  i2c8: i2c@505030000 {
   compatible = "apple,t6050-i2c", "apple,t8103-i2c";
   reg = <0x5 0x05030000 0x0 0x4000>;
   clocks = <&clkref>;
   interrupt-parent = <&aic>;
   interrupts = <0 1383 4>;
   #address-cells = <0x1>;
   #size-cells = <0x0>;
   status = "disabled";
  };
  serial0: serial@505200000 {
   compatible = "apple,s5l-uart";
   reg = <0x5 0x05200000 0x0 0x4000>;
   reg-io-width = <4>;
   interrupt-parent = <&aic>;
   interrupts = <0 1359 4>;
   clocks = <&clkref>, <&clkref>;
   clock-names = "uart", "clk_uart_baud0";
   status = "disabled";
  };
 };
};

/ {
 compatible = "apple,j716c", "apple,t6050", "apple,arm-platform";
 model = "Apple MacBook Pro (16-inch, M5 Max)";
 aliases {
  serial0 = &serial0;
 };
 chosen {
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;
  stdout-path = "serial0";
 };
 memory@10000000000 {
  device_type = "memory";
  reg = <0x100 0 0x2 0>;
 };
};
&serial0 {
 status = "okay";
};
