/dts-v1/;


/ {
 compatible = "apple,t6050", "apple,arm-platform";
 #address-cells = <2>;
 #size-cells = <2>;
 cpus {
  #address-cells = <2>;
  #size-cells = <0>;
  cpu-map {
   cluster0 {
    core0 {
     cpu = <&cpu_m00>;
    };
    core1 {
     cpu = <&cpu_m01>;
    };
    core2 {
     cpu = <&cpu_m02>;
    };
    core3 {
     cpu = <&cpu_m03>;
    };
    core4 {
     cpu = <&cpu_m04>;
    };
    core5 {
     cpu = <&cpu_m05>;
    };
   };
   cluster1 {
    core0 {
     cpu = <&cpu_m10>;
    };
    core1 {
     cpu = <&cpu_m11>;
    };
    core2 {
     cpu = <&cpu_m12>;
    };
    core3 {
     cpu = <&cpu_m13>;
    };
    core4 {
     cpu = <&cpu_m14>;
    };
    core5 {
     cpu = <&cpu_m15>;
    };
   };
   cluster2 {
    core0 {
     cpu = <&cpu_p0>;
    };
    core1 {
     cpu = <&cpu_p1>;
    };
    core2 {
     cpu = <&cpu_p2>;
    };
    core3 {
     cpu = <&cpu_p3>;
    };
    core4 {
     cpu = <&cpu_p4>;
    };
    core5 {
     cpu = <&cpu_p5>;
    };
   };
  };
  cpu_m00: cpu@40000 {
   compatible = "apple,sotra-m";
   device_type = "cpu";
   reg = <0x0 0x40000>;
   enable-method = "spin-table";
   cpu-release-addr = <0 0>;
   next-level-cache = <&l2_cache_0>;
   i-cache-size = <0x20000>;
   d-cache-size = <0x10000>;
   operating-points-v2 = <&cluster0_opp>;
   performance-domains = <&cpufreq0>;
   capacity-dmips-mhz = <768>;
   dynamic-power-coefficient = <550>;
  };
  cpu_m01: cpu@40001 {
   compatible = "apple,sotra-m";
   device_type = "cpu";
   reg = <0x0 0x40001>;
   enable-method = "spin-table";
