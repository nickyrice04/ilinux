/ {
 compatible = "apple,j716c", "apple,t6050", "apple,arm-platform";
 model = "Apple MacBook Pro (16-inch, M5 Max)";
 aliases {
  serial0 = &serial0;
 };
 chosen {
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;
  stdout-path = "serial0";
 };
 memory@10000000000 {
  device_type = "memory";
  reg = <0x100 0 0x2 0>;
 };
};
&serial0 {
 status = "okay";
};
