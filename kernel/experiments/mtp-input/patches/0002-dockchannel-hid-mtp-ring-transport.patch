+	mutex_lock(&dchid->id_lock);
+	if (!dchid->id_ready) {
+		dev_warn(dchid->dev, "STM not ready after %d ms, creating deferred interfaces without its ID\n",
+			 STM_FALLBACK_MS);
+		memset(&dchid->device_id, 0, sizeof(dchid->device_id));
+		dchid->device_id.vendor_id = HOST_VENDOR_ID_APPLE;
+		dchid->id_ready = true;
+		for (i = 0; i < MAX_INTERFACES; i++) {
+			if (!dchid->ifaces[i] || !dchid->ifaces[i]->deferred)
+				continue;
+			dchid_create_interface(dchid->ifaces[i]);
+		}
+	}
+	mutex_unlock(&dchid->id_lock);
