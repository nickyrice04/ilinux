+/*
+ * Route one verified message (header + body, checksum already checked) to the
+ * interface it belongs to. Used for DockChannel FIFO and for ring messages.
+ */
+static void dchid_dispatch(struct dockchannel_hid *dchid, struct dchid_hdr *hdr, const u8 *body)
+{
+	struct dchid_work *work;
+	struct dchid_iface *iface;
+
+	if (hdr->iface >= MAX_INTERFACES) {
+		dev_err(dchid->dev, "Bad iface %d\n", hdr->iface);
+		return;
+	}
+
+	iface = dchid->ifaces[hdr->iface];
+
+	if (!iface) {
+		dev_err(dchid->dev, "Received packet for uninitialized iface %d\n", hdr->iface);
+		return;
+	}
+
+	switch (hdr->channel) {
+		case DCHID_CHANNEL_CMD:
+			dchid_handle_ack(iface, hdr, (void *)body);
+			return;
+		case DCHID_CHANNEL_REPORT:
+			break;
+		default:
+			dev_warn(dchid->dev, "Unknown channel 0x%x, treating as report...\n",
+				 hdr->channel);
+			break;
+	}
+
+	work = kzalloc(sizeof(*work) + hdr->length, GFP_KERNEL);
+	if (!work)
+		return;
+
+	work->hdr = *hdr;
+	work->iface = iface;
+	memcpy(work->data, body, hdr->length);
+	INIT_WORK(&work->work, dchid_packet_work);
+
+	queue_work(iface->wq, &work->work);
+}
+
+/*
+ * Ring side: one complete, checksum-verified message sits in ring_asm.buf.
+ * macOS accepts a transport header of 6..8 bytes; every message seen so far
+ * uses 8, which is all this driver parses.
+ */
+static void dchid_ring_message(struct dockchannel_hid *dchid, u8 *msg, size_t len)
+{
+	struct dchid_hdr hdr;
+
+	if (msg[0] != sizeof(hdr)) {
+		dev_dbg_ratelimited(dchid->dev, "ring: header length %u not handled\n", msg[0]);
+		return;
+	}
+	memcpy(&hdr, msg, sizeof(hdr));
+	if (hdr.channel == 0)		/* valid, carries nothing (doorbell candidate) */
+		return;
+	if (hdr.length < sizeof(struct dchid_subhdr) || (hdr.length & 3) ||
+	    sizeof(hdr) + hdr.length + 4 != len) {
+		dev_err_ratelimited(dchid->dev, "ring: bad body length %hu (message %zu)\n",
+				    hdr.length, len);
+		return;
+	}
+	dchid_dispatch(dchid, &hdr, msg + sizeof(hdr));
+}
+
+/* Resynchronise after a framing error: drop what the device has queued so far (bounded). */
+static void dchid_ring_discard(struct dockchannel_hid *dchid)
+{
+	struct dchid_asm *a = &dchid->ring_asm;
+	size_t left = dchid->ring.cap;
+
+	while (left) {
+		long got = dchid_ring_read(&dchid->ring, a->buf, min(left, a->cap));
+
+		if (got <= 0)
+			break;
+		left -= got;
+	}
+}
+
+/* Pull every complete message out of the ring. Called with no lock held. */
+static void dchid_ring_drain(struct dockchannel_hid *dchid)
+{
+	struct dchid_asm *a = &dchid->ring_asm;
+	int budget = 1 << 14;		/* bounded: a misbehaving device cannot pin the thread */
+
+	mutex_lock(&dchid->ring_lock);
+	while (budget-- > 0) {
+		size_t need = dchid_asm_need(a);
+		enum dchid_asm_status st;
+		long got;
+
+		if (!need)
+			need = 1;
+		got = dchid_ring_read(&dchid->ring, a->buf + a->have, need);
+		if (got < 0) {
+			dev_err_ratelimited(dchid->dev, "ring: index out of range, resetting\n");
+			dchid_ring_reset(&dchid->ring);
+			dchid_asm_reset(a);
+			break;
+		}
+		if (!got)
+			break;
+
+		a->have += got;
+		st = dchid_asm_check(a);
+		if (st == DCHID_ASM_INCOMPLETE)
+			continue;
+		if (st == DCHID_ASM_COMPLETE) {
+			dchid_ring_message(dchid, a->buf, a->have);
+		} else {
+			dchid->ring_drops++;
+			dev_err_ratelimited(dchid->dev, "ring: framing error 0x%x\n", st);
+			/*
+			 * A bad checksum on a plausibly framed message still leaves the next
+			 * boundary credible (a 32-bit sum guards every message). Anything else
+			 * means the byte stream is out of step: drop what is queued.
+			 */
+			if (st != DCHID_ASM_E_CHECKSUM)
+				dchid_ring_discard(dchid);
+		}
+		dchid_asm_reset(a);
+	}
+	mutex_unlock(&dchid->ring_lock);
+}
+
+static void dchid_handshake_work(struct work_struct *ws)
+{
+	struct dockchannel_hid *dchid = container_of(to_delayed_work(ws),
+						     struct dockchannel_hid, handshake_work);
+	u8 cmd[DCHID_CMD_FIFO_LEN];
+	int ret;
+
+	/* 1. tell the MTP the system is awake (macOS: report 0xc1, state 2) */
+	dchid_enc_awake(cmd, true);
+	ret = dchid_comm_cmd(dchid, cmd, DCHID_CMD_AWAKE_LEN);
+	if (ret < 0)
+		dev_warn(dchid->dev, "awake report failed: %d (continuing)\n", ret);
+
+	/* 2. register the device->host ring (report 0x91: iova, total size) */
+	dchid_enc_register_fifo(cmd, dchid->ring_iova, dchid->ring.size);
+	ret = dchid_comm_cmd(dchid, cmd, DCHID_CMD_FIFO_LEN);
+	if (ret < 0)
+		dev_err(dchid->dev, "ring registration failed: %d (draining anyway)\n", ret);
+	else
+		dev_info(dchid->dev, "Ring registered: iova %pad, %u bytes\n", &dchid->ring_iova,
+			 dchid->ring.size);
+
+	dchid->ring_registered = ret >= 0;
+
+	/* The ack, or early input, may already sit in the ring without a doorbell we recognise. */
+	dchid_ring_drain(dchid);
+
+	if (mtp_poll_ms)
+		schedule_delayed_work(&dchid->poll_work, msecs_to_jiffies(mtp_poll_ms));
+}
+
+static void dchid_poll_work(struct work_struct *ws)
+{
+	struct dockchannel_hid *dchid = container_of(to_delayed_work(ws),
+						     struct dockchannel_hid, poll_work);
+
+	/* Debug aid: finds out whether data reaches the ring when no doorbell is recognised. */
+	dchid_ring_drain(dchid);
+	schedule_delayed_work(&dchid->poll_work, msecs_to_jiffies(mtp_poll_ms));
+}
