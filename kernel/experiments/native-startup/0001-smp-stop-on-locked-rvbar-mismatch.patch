Subject: [LOCAL EXPERIMENT] smp: stop before starting a core with a mismatched locked RVBAR

The existing diagnostic continues into CPU_START writes despite a known
entry-point mismatch. Cache the existing read and return before shared
startup state or registers change. No new register is read or written.
Based on public m1n1 source; no proprietary implementation is used.
Native behavior is untested.

--- a/src/smp.c
+++ b/src/smp.c
@@ -162,10 +162,15 @@
     if (spin_table[index].flag)
         return;
 
-    if (!cpu_features->apple_sysregs_unlocked &&
-        (read64(cpu->impl_reg) & RVBAR_ADDR) != (u64)_vectors_start) {
-        printf("Failed! \n    RVBAR (=0x%lx) is locked and differs from entry point (=0x%lx)\n",
-               read64(cpu->impl_reg) & RVBAR_ADDR, (u64)_vectors_start);
+    if (!cpu_features->apple_sysregs_unlocked) {
+        u64 rvbar = read64(cpu->impl_reg) & RVBAR_ADDR;
+
+        if (rvbar != (u64)_vectors_start) {
+            printf("Skipping CPU %d (%d:%d:%d): locked RVBAR (=0x%lx) "
+                   "differs from entry point (=0x%lx)\n",
+                   index, cpu->die, cpu->cluster, cpu->core, rvbar, (u64)_vectors_start);
+            return;
+        }
     }
 
     printf("Starting CPU %d (%d:%d:%d)... ", index, cpu->die, cpu->cluster, cpu->core);
