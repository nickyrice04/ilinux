+/*
+ * iLinux boot040 diagnostics (t6050, kernel/experiments/usb-gadget/dart-diag):
+ * the per-stream error bitmap, read for the fault report and for the case below.
+ */
+static u32 apple_dart_t8110_error_streams(struct apple_dart *dart, u32 *words, int max)
+{
+	int n = min_t(int, BITS_TO_U32(dart->num_streams), max), i;
+	u32 any = 0;
 
+	for (i = 0; i < n; i++) {
+		words[i] = readl(dart->regs + DART_T8110_ERROR_STREAMS + 4 * i);
+		any |= words[i];
+	}
+	return any;
+}
