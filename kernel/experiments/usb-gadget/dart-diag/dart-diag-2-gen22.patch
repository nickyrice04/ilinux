+#define DART_T8110_G22_SUMMARY_LEVEL GENMASK(13, 12)
+#define DART_T8110_G22_ADDR_LO 0x08
+#define DART_T8110_G22_ADDR_HI 0x0c
+#define DART_T8110_G22_AXI_ID0 0x18
+#define DART_T8110_TLB_CMD_OP_FLUSH_UNLOCK 4
+#define DART_T8110_TLB_CMD_G22_FLAG BIT(15)
 
