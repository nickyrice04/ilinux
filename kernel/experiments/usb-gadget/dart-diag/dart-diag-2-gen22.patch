+/* iLinux boot040, part 2: v2.2 fault-layout helpers (see the defines above). */
+static u32 apple_dart_t8110_g22_prot_status_offset(struct apple_dart *dart)
+{
+	return dart->version >= DART_T8110_VERSION_2_4 ? DART_T8110_G24_PROT_STATUS :
+							  DART_T8110_G22_PROT_STATUS;
+}
+
+/*
+ * Acknowledge everything pending in the v2.2 layout, the way macOS's SPTM does at
+ * power-up and power-down: the pending words are written back (write-one-to-clear),
+ * the protection-unit status is written all ones, and the error mask is cleared.
+ */
+static void apple_dart_t8110_g22_clear(struct apple_dart *dart)
+{
+	int i;
+
+	for (i = 0; i < BITS_TO_U32(dart->num_streams); i++) {
+		u32 pending = readl(dart->regs + DART_T8110_G22_PENDING + 4 * i);
+
+		if (pending)
+			writel(pending, dart->regs + DART_T8110_G22_PENDING + 4 * i);
+	}
+	writel(U32_MAX, dart->regs + apple_dart_t8110_g22_prot_status_offset(dart));
+	writel(0, dart->regs + DART_T8110_G22_ERROR_MASK);
 }
 
+/*
+ * The TLB flush-unlock command (op 4; bit 15 as every command word carries on these
+ * versions), which the SPTM issues after a fault acknowledgement when register 0x210
+ * bit 1 asks for it. It changes no translation: it releases the stream the fault
+ * stalled.
+ */
+static void apple_dart_t8110_flush_unlock(struct apple_dart *dart)
+{
+	unsigned long flags;
+	u32 val = FIELD_PREP(DART_T8110_TLB_CMD_OP, DART_T8110_TLB_CMD_OP_FLUSH_UNLOCK) |
+		  DART_T8110_TLB_CMD_G22_FLAG;
+	int ret;
+
+	spin_lock_irqsave(&dart->lock, flags);
+	writel(val, dart->regs + DART_T8110_TLB_CMD);
+	ret = readl_poll_timeout_atomic(dart->regs + DART_T8110_TLB_CMD, val,
+					!(val & DART_T8110_TLB_CMD_BUSY), 1,
+					DART_STREAM_COMMAND_BUSY_TIMEOUT);
+	spin_unlock_irqrestore(&dart->lock, flags);
+	if (ret)
+		dev_err_ratelimited(dart->dev, "flush-unlock: busy bit did not clear\n");
+}
