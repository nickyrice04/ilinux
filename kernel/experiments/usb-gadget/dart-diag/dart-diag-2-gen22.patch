+/*
+ * iLinux boot040, part 2: the fault interrupt of a DART in the v2.2 layout. Reports
+ * every pending stream's error block, acknowledges by writing the pending words back,
+ * clears the protection-unit status, runs the flush-unlock when asked, and returns
+ * IRQ_NONE when nothing is pending (the sibling instance shares the line, and the
+ * kernel's spurious-interrupt protection must keep working). A line that stays
+ * asserted through many acknowledgements would spin this CPU forever, which the
+ * spurious-interrupt protection does not catch (those interrupts count as handled):
+ * after 256 acknowledged interrupts the line is disabled here, state already printed.
+ */
+static irqreturn_t apple_dart_t8110_g22_irq(int irq, struct apple_dart *dart)
+{
+	u32 pending[DART_MAX_STREAMS / 32] = { 0 };
+	u32 prot_off = apple_dart_t8110_g22_prot_status_offset(dart);
+	u32 prot = readl(dart->regs + prot_off) & DART_T8110_G22_PROT_STATUS_MASK;
+	u32 ctrl = readl(dart->regs + DART_T8110_CTRL);
+	int nwords = BITS_TO_U32(dart->num_streams), i, sid;
+	bool any = prot != 0;
+
+	for (i = 0; i < nwords; i++) {
+		pending[i] = readl(dart->regs + DART_T8110_G22_PENDING + 4 * i);
+		any |= pending[i] != 0;
+	}
+	if (!any) {
+		u32 n = ++dart->irqs_without_flag;
+
+		if (n <= 4 || n % 25000 == 0)
+			dev_err(dart->dev,
+				"fault IRQ %d (v2.2 layout) with nothing pending (#%u): PENDING 0x%08x MASK 0x%08x PROT_STATUS 0x%08x CTRL 0x%08x TLB_CMD 0x%08x\n",
+				irq, n, pending[0],
+				readl(dart->regs + DART_T8110_G22_ERROR_MASK),
+				readl(dart->regs + prot_off), ctrl,
+				readl(dart->regs + DART_T8110_TLB_CMD));
+		return IRQ_NONE;
+	}
+	for (i = 0; i < nwords; i++) {
+		unsigned long word = pending[i];
+
+		for_each_set_bit(sid, &word, 32) {
+			void __iomem *blk = dart->regs + DART_T8110_G22_STREAM_BLOCK(32 * i + sid);
+			u32 summary = readl(blk + DART_T8110_G22_SUMMARY);
+			u64 addr = readl(blk + DART_T8110_G22_ADDR_LO) |
+				   ((u64)readl(blk + DART_T8110_G22_ADDR_HI) << 32);
+			u32 code = FIELD_GET(DART_T8110_G22_SUMMARY_CODE, summary);
+
+			dart->faults_reported++;
+			dev_err_ratelimited(dart->dev,
+				"translation fault (v2.2 layout): stream %d code %u (%s) level %s at 0x%llx%s AXI id 0x%08x summary 0x%08x (fault #%u, IRQ %d)\n",
+				32 * i + sid, code, apple_dart_g22_code_names[code],
+				apple_dart_g22_level_names[FIELD_GET(DART_T8110_G22_SUMMARY_LEVEL, summary)],
+				addr, FIELD_GET(DART_T8110_G22_SUMMARY_NO_DVA, summary) ? " (no DVA)" : "",
+				readl(blk + DART_T8110_G22_AXI_ID0), summary,
+				dart->faults_reported, irq);
+		}
+	}
+	if (prot) {
+		dev_err_ratelimited(dart->dev,
+			"protection unit status 0x%08x at 0x%x (IRQ %d), cleared\n", prot, prot_off, irq);
+		writel(U32_MAX, dart->regs + prot_off);
+	}
+	for (i = 0; i < nwords; i++)
+		if (pending[i])
+			writel(pending[i], dart->regs + DART_T8110_G22_PENDING + 4 * i);
+	if (ctrl & DART_T8110_CTRL_FLUSH_UNLOCK_NEEDED)
+		apple_dart_t8110_flush_unlock(dart);
+	if (++dart->acknowledged == 256) {
+		dev_err(dart->dev, "fault IRQ %d acknowledged %u times; disabling it\n",
+			irq, dart->acknowledged);
+		disable_irq_nosync(irq);
+	}
+	return IRQ_HANDLED;
+}
