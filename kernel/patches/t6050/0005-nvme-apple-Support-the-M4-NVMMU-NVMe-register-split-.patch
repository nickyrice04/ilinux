---
 drivers/nvme/host/apple.c | 107 ++++++++++++++++++++++++++++++++++----
 1 file changed, 96 insertions(+), 11 deletions(-)

diff --git a/drivers/nvme/host/apple.c b/drivers/nvme/host/apple.c
index a3343c49..6e5eda06 100644
--- a/drivers/nvme/host/apple.c
+++ b/drivers/nvme/host/apple.c
@@ -42,6 +42,14 @@
 #define APPLE_ANS_ACQ_DB  0x1004
 #define APPLE_ANS_IOCQ_DB 0x100c
 
+/*
+ * M4 and later: the I/O submission and completion queue base addresses must
+ * also be written here once the I/O queues exist, otherwise the ANS firmware
+ * crashes and its crash log reports an I/O SQ/CQ base of 0 (m1n1 53f8ee9b).
+ */
+#define APPLE_ANS_IOQ_SQ_BASE 0x1200
+#define APPLE_ANS_IOQ_CQ_BASE 0x1208
+
 #define APPLE_ANS_MAX_PEND_CMDS_CTRL 0x1210
 
 #define APPLE_ANS_BOOT_STATUS	 0x1300
@@ -59,6 +67,19 @@
 #define APPLE_NVMMU_TCB_INVAL	  0x28118
 #define APPLE_NVMMU_TCB_STAT	  0x28120
 
+/*
+ * M4 and later: the NVMMU reports the state of every TCB in an array of
+ * 32-bit words at the start of its register block, one word per four TCBs
+ * with a 5-bit slot per TCB.  The low four bits of a slot must read back as
+ * zero once the TCB has been invalidated.  The single APPLE_NVMMU_TCB_STAT
+ * register above is what M1-M3 use; it is not referenced on M4 and later.
+ */
+#define APPLE_NVMMU_TCB_STAT_ARRAY	0x28000
+#define APPLE_NVMMU_TCB_STAT_WORD(tag)	\
+	(APPLE_NVMMU_TCB_STAT_ARRAY + (((tag) >> 2) << 2))
+#define APPLE_NVMMU_TCB_STAT_SHIFT(tag)	(((tag) & 3) * 5)
+#define APPLE_NVMMU_TCB_STAT_MASK	0xf
+
 /*
  * This controller is a bit weird in the way command tags works: Both the
  * admin and the IO queue share the same tag space. Additionally, tags
@@ -167,6 +188,11 @@ struct apple_nvme_iod {
 
 struct apple_nvme_hw {
 	bool has_lsq_nvmmu;
+	/*
+	 * M4 and later: NVMMU registers live in their own "nvmmu" MMIO window
+	 * and the I/O queue bases must be mirrored to APPLE_ANS_IOQ_*_BASE.
+	 */
+	bool has_separate_nvmmu;
 	u32 max_queue_depth;
 };
 
@@ -175,6 +201,8 @@ struct apple_nvme {
 
 	void __iomem *mmio_coproc;
 	void __iomem *mmio_nvme;
+	/* Equal to mmio_nvme unless hw->has_separate_nvmmu is set */
+	void __iomem *mmio_nvmmu;
 	const struct apple_nvme_hw *hw;
 
 	struct device **pd_dev;
@@ -292,11 +320,34 @@ static const struct apple_rtkit_ops apple_nvme_rtkit_ops = {
 static void apple_nvmmu_inval(struct apple_nvme_queue *q, unsigned int tag)
 {
 	struct apple_nvme *anv = queue_to_apple_nvme(q);
+	u32 stat;
 
-	writel(tag, anv->mmio_nvme + APPLE_NVMMU_TCB_INVAL);
-	if (readl(anv->mmio_nvme + APPLE_NVMMU_TCB_STAT))
+	writel(tag, anv->mmio_nvmmu + APPLE_NVMMU_TCB_INVAL);
+	if (anv->hw->has_separate_nvmmu) {
+		stat = readl(anv->mmio_nvmmu + APPLE_NVMMU_TCB_STAT_WORD(tag));
+		stat >>= APPLE_NVMMU_TCB_STAT_SHIFT(tag);
+		stat &= APPLE_NVMMU_TCB_STAT_MASK;
+	} else {
+		stat = readl(anv->mmio_nvmmu + APPLE_NVMMU_TCB_STAT);
+	}
+	if (stat)
 		dev_warn_ratelimited(anv->dev,
-				     "NVMMU TCB invalidation failed\n");
+				     "NVMMU TCB %u invalidation failed (state %u)\n",
+				     tag, stat);
+}
+
+/*
+ * M4 and later program the 64-bit queue and TCB base registers as two
+ * 32-bit stores, low word first.  Keep the 64-bit store on the older SoCs
+ * where it is known to work.
+ */
+static void apple_nvme_write_base(struct apple_nvme *anv, u64 val,
+				  void __iomem *reg)
+{
+	if (anv->hw->has_separate_nvmmu)
+		lo_hi_writeq(val, reg);
+	else
+		writeq(val, reg);
 }
 
 static void apple_nvme_submit_cmd_t8015(struct apple_nvme_queue *q,
@@ -1158,24 +1209,30 @@ static void apple_nvme_reset_work(struct work_struct *work)
 			| (anv->hw->max_queue_depth << 16), anv->mmio_nvme
 			+ APPLE_ANS_MAX_PEND_CMDS_CTRL);
 
-		/* Setup the NVMMU for the maximum admin and IO queue depth */
+		/*
+		 * Setup the NVMMU for the maximum admin and IO queue depth.
+		 * M4 and later firmware writes 63 here as well, whatever the
+		 * queue depth, so max_queue_depth stays at 64 on those SoCs.
+		 */
 		writel(anv->hw->max_queue_depth - 1,
-			anv->mmio_nvme + APPLE_NVMMU_NUM_TCBS);
+			anv->mmio_nvmmu + APPLE_NVMMU_NUM_TCBS);
 	}
 
 	/* Setup the admin queue */
 	aqa = APPLE_NVME_AQ_DEPTH - 1;
 	aqa |= aqa << 16;
 	writel(aqa, anv->mmio_nvme + NVME_REG_AQA);
-	writeq(anv->adminq.sq_dma_addr, anv->mmio_nvme + NVME_REG_ASQ);
-	writeq(anv->adminq.cq_dma_addr, anv->mmio_nvme + NVME_REG_ACQ);
+	apple_nvme_write_base(anv, anv->adminq.sq_dma_addr,
+			      anv->mmio_nvme + NVME_REG_ASQ);
+	apple_nvme_write_base(anv, anv->adminq.cq_dma_addr,
+			      anv->mmio_nvme + NVME_REG_ACQ);
 
 	if (anv->hw->has_lsq_nvmmu) {
 		/* Setup NVMMU for both queues */
-		writeq(anv->adminq.tcb_dma_addr,
-			anv->mmio_nvme + APPLE_NVMMU_ASQ_TCB_BASE);
-		writeq(anv->ioq.tcb_dma_addr,
-			anv->mmio_nvme + APPLE_NVMMU_IOSQ_TCB_BASE);
+		apple_nvme_write_base(anv, anv->adminq.tcb_dma_addr,
+				      anv->mmio_nvmmu + APPLE_NVMMU_ASQ_TCB_BASE);
+		apple_nvme_write_base(anv, anv->ioq.tcb_dma_addr,
+				      anv->mmio_nvmmu + APPLE_NVMMU_IOSQ_TCB_BASE);
 	}
 
 	anv->ctrl.sqsize =
@@ -1211,6 +1268,17 @@ static void apple_nvme_reset_work(struct work_struct *work)
 	if (ret)
 		goto out_remove_cq;
 
+	if (anv->hw->has_separate_nvmmu) {
+		/*
+		 * Completion queue first: the firmware only accepts the
+		 * submission queue base after the completion queue base.
+		 */
+		apple_nvme_write_base(anv, anv->ioq.cq_dma_addr,
+				      anv->mmio_nvme + APPLE_ANS_IOQ_CQ_BASE);
+		apple_nvme_write_base(anv, anv->ioq.sq_dma_addr,
+				      anv->mmio_nvme + APPLE_ANS_IOQ_SQ_BASE);
+	}
+
 	apple_nvme_init_queue(&anv->ioq);
 	nr_io_queues = 1;
 	ret = nvme_set_queue_count(&anv->ctrl, &nr_io_queues);
@@ -1543,6 +1611,16 @@ static struct apple_nvme *apple_nvme_alloc(struct platform_device *pdev)
 		ret = PTR_ERR(anv->mmio_nvme);
 		goto put_dev;
 	}
+	if (anv->hw->has_separate_nvmmu) {
+		anv->mmio_nvmmu =
+			devm_platform_ioremap_resource_byname(pdev, "nvmmu");
+		if (IS_ERR(anv->mmio_nvmmu)) {
+			ret = PTR_ERR(anv->mmio_nvmmu);
+			goto put_dev;
+		}
+	} else {
+		anv->mmio_nvmmu = anv->mmio_nvme;
+	}
 
 	if (anv->hw->has_lsq_nvmmu) {
 		anv->adminq.sq_db = anv->mmio_nvme + APPLE_ANS_LINEAR_ASQ_DB;
@@ -1761,9 +1839,16 @@ static const struct apple_nvme_hw apple_nvme_t8103_hw = {
 	.max_queue_depth = 64,
 };
 
+static const struct apple_nvme_hw apple_nvme_t8132_hw = {
+	.has_lsq_nvmmu = true,
+	.has_separate_nvmmu = true,
+	.max_queue_depth = 64,
+};
+
 static const struct of_device_id apple_nvme_of_match[] = {
 	{ .compatible = "apple,t8015-nvme-ans2", .data = &apple_nvme_t8015_hw },
 	{ .compatible = "apple,t8103-nvme-ans2", .data = &apple_nvme_t8103_hw },
+	{ .compatible = "apple,t8132-nvme-ans2", .data = &apple_nvme_t8132_hw },
 	{ .compatible = "apple,nvme-ans2", .data = &apple_nvme_t8103_hw },
 	{},
 };
